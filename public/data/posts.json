[
  {
    "id": "9a152061-af45-457e-9d28-136f7c74f0f3",
    "date": "2026-09-05",
    "category": "励志",
    "title": "六点的光",
    "content": "六点闹钟响的时候犹豫了三秒，还是爬起来了。窗外天刚亮，突然觉得每一天都像块新橡皮，能把昨天的错都擦掉重写。",
    "image_url": "/images/2026-09-05-0.jpg",
    "image_author": "",
    "created_at": "2026-09-05T17:13:36.713Z"
  },
  {
    "id": "d95f096a-a96b-45f4-925d-88d927a3c692",
    "date": "2026-09-05",
    "category": "励志",
    "title": "清晨的光",
    "content": "六点的闹钟响了第三次，我翻了个身起床。窗外的城市还在半睡，地铁里有人背着包打盹。平凡的日子重复着，但我相信自己正在慢慢变好。",
    "image_url": "/images/2026-09-05-1.jpg",
    "image_author": "",
    "created_at": "2026-09-05T17:13:39.379Z"
  },
  {
    "id": "e18956bf-e675-4684-9506-5da550982467",
    "date": "2026-09-05",
    "category": "励志",
    "title": "日复一日",
    "content": "闹钟响了三次才爬起来，镜子里的黑眼圈又重了。但今天比昨天早起了十分钟，这就是进步。路还长，慢慢走，总会到的。",
    "image_url": "/images/2026-09-05-2.jpg",
    "image_author": "",
    "created_at": "2026-09-05T17:13:41.348Z"
  },
  {
    "id": "3822b090-c72a-4bb1-a103-b3f072659424",
    "date": "2026-09-05",
    "category": "励志",
    "title": "凌晨四点",
    "content": "凌晨四点的闹钟响了三次，窗外路灯还亮着。昨天没做完的事，今天接着做。日子就是这样，一天叠一天，叠着叠着，就厚实了。",
    "image_url": "/images/2026-09-05-3.jpg",
    "image_author": "",
    "created_at": "2026-09-05T17:13:42.920Z"
  },
  {
    "id": "197126d4-45a5-4e6b-be0e-89687813d5e9",
    "date": "2026-09-05",
    "category": "情感",
    "title": "伞下的位置",
    "content": "雨天路过常去的小馆，老板娘多问了一句：还是老位置？我点头，却想起上次对面坐的那个人，已是很久以前的事了。",
    "image_url": "/images/2026-09-05-4.jpg",
    "image_author": "",
    "created_at": "2026-09-05T17:13:48.226Z"
  },
  {
    "id": "bf5d4f54-be50-48c3-87df-69910d6c0df2",
    "date": "2026-09-05",
    "category": "情感",
    "title": "雨天的熟悉感",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。也不知道ta那边天气如何，有没有带伞，还记不记得我们曾一起淋过的雨。",
    "image_url": "/images/2026-09-05-5.jpg",
    "image_author": "",
    "created_at": "2026-09-05T17:13:53.564Z"
  },
  {
    "id": "3e819261-74f1-401e-bdd9-f0e87f708880",
    "date": "2026-09-05",
    "category": "情感",
    "title": "雨天的挂念",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没什么大事，就想问问你那边的雨大不大，记得带伞。",
    "image_url": "/images/2026-09-05-6.jpg",
    "image_author": "",
    "created_at": "2026-09-05T17:13:55.816Z"
  },
  {
    "id": "f83be216-079f-490c-8201-4c913f91a088",
    "date": "2026-09-05",
    "category": "情感",
    "title": "旧味",
    "content": "今天路过那家我们常去的小馆，点了同样的菜。第一口下去时，突然想起你笑我总把香菜挑出来的样子。拍了张照片，却没有发给你。",
    "image_url": "/images/2026-09-05-7.jpg",
    "image_author": "",
    "created_at": "2026-09-05T17:13:58.764Z"
  },
  {
    "id": "dbde6d1d-205d-40a9-91e5-3e308b578ddb",
    "date": "2026-09-05",
    "category": "早安",
    "title": "晨光里的第一口",
    "content": "吐司边烤得刚好，煎蛋还带着锅气。咬一口，听见窗外鸟叫。原来清晨的味道，是黄油融化时那声轻响。",
    "image_url": "/images/2026-09-05-8.jpg",
    "image_author": "",
    "created_at": "2026-09-05T17:14:02.119Z"
  },
  {
    "id": "6172444f-dce8-4d20-8e1e-83dff652778d",
    "date": "2026-09-05",
    "category": "早安",
    "title": "早餐的光",
    "content": "吐司边煎得金黄，咖啡刚好不烫。推门时风正温柔，把所有没睡醒的念头，都留给清晨去消化。",
    "image_url": "/images/2026-09-05-9.jpg",
    "image_author": "",
    "created_at": "2026-09-05T17:14:06.136Z"
  },
  {
    "id": "b1d301b5-ca4a-4544-87b5-4dae8380509b",
    "date": "2026-09-05",
    "category": "早安",
    "title": "太阳照常升起",
    "content": "煎蛋边缘微微焦，咖啡香气飘满屋。阳光斜斜洒进来，日子就这样热腾腾地开始了。",
    "image_url": "/images/2026-09-05-10.jpg",
    "image_author": "",
    "created_at": "2026-09-05T17:14:12.199Z"
  },
  {
    "id": "46662e47-1912-45d8-b563-9674f631676d",
    "date": "2026-09-05",
    "category": "早安",
    "title": "早安，今天",
    "content": "烤面包机叮了一声，咖啡香飘过来。咬下第一口时想起，原来幸福就是每天都有这样简单的开始。",
    "image_url": "/images/2026-09-05-11.jpg",
    "image_author": "",
    "created_at": "2026-09-05T17:14:13.801Z"
  },
  {
    "id": "af519053-2878-4160-8dc4-a7370b050074",
    "date": "2026-09-05",
    "category": "晚安",
    "title": "夜光沉静",
    "content": "热水冲走一天的疲惫，窗外灯光渐次熄灭。关灯前看了会儿夜空，云层很厚，风很轻，今天就到这里吧。",
    "image_url": "/images/2026-09-05-12.jpg",
    "image_author": "",
    "created_at": "2026-09-05T17:14:15.918Z"
  },
  {
    "id": "0d4cbd31-e02a-43b2-aa93-49e3f9ebf1e6",
    "date": "2026-09-05",
    "category": "晚安",
    "title": "今日落幕",
    "content": "灯关了一半，窗外的城市还在呼吸。水汽从发梢滴落，这一天便沉进枕头里。所有声音都远去了，只剩我，和这个安静的夜。",
    "image_url": "/images/2026-09-05-13.jpg",
    "image_author": "",
    "created_at": "2026-09-05T17:14:17.362Z"
  },
  {
    "id": "450bde4c-87c2-4695-9b57-0e35cf43d25d",
    "date": "2026-09-05",
    "category": "晚安",
    "title": "灯灭了",
    "content": "洗完澡躺下来，头发还带着潮气。窗外那盏路灯替我看守夜晚，我只需把今天轻轻合上。窗帘拉严之前，记得把烦恼留在外面。",
    "image_url": "/images/2026-09-05-14.jpg",
    "image_author": "",
    "created_at": "2026-09-05T17:14:19.334Z"
  },
  {
    "id": "39dad84b-7db9-4f2a-a34b-5e655bbf0905",
    "date": "2026-09-05",
    "category": "晚安",
    "title": "夜航西飞",
    "content": "窗帘没拉严，留了道缝。月光斜进来，像谁轻轻说，今天可以了。手机调暗，被子裹紧，把这一天的重量，慢慢交给枕头。",
    "image_url": "/images/2026-09-05-15.jpg",
    "image_author": "",
    "created_at": "2026-09-05T17:14:20.927Z"
  },
  {
    "id": "d5b6b9b8-fc56-41f2-aeb6-4eeea0f4af5c",
    "date": "2026-09-05",
    "category": "日常",
    "title": "阳台放空",
    "content": "傍晚在阳台发了会呆，看楼下的人遛狗买菜。风挺凉快，突然觉得这样啥也不干也挺好。",
    "image_url": "/images/2026-09-05-16.jpg",
    "image_author": "",
    "created_at": "2026-09-05T17:14:22.495Z"
  },
  {
    "id": "3730bd16-67b3-4829-ae03-a66ced61c5f5",
    "date": "2026-09-05",
    "category": "日常",
    "title": "洗了顿饭",
    "content": "今天难得下厨，切菜时差点切到手，但成品居然挺像样。把厨房收拾干净那刻，比吃还满足。",
    "image_url": "/images/2026-09-05-17.jpg",
    "image_author": "",
    "created_at": "2026-09-05T17:14:23.973Z"
  },
  {
    "id": "3aec7cf1-f3b3-41b3-b0f4-8c1046f713d5",
    "date": "2026-09-05",
    "category": "日常",
    "title": "今天的小确幸",
    "content": "收拾完房间，顺手煮了碗面，阳台的风刚好吹进来。日子嘛，也就是这些琐碎拼起来的。挺好。",
    "image_url": "/images/2026-09-05-18.jpg",
    "image_author": "",
    "created_at": "2026-09-05T17:14:25.634Z"
  },
  {
    "id": "a574107b-a13c-48ad-b61c-3ae633f5a67a",
    "date": "2026-09-05",
    "category": "日常",
    "title": "厨房新手",
    "content": "今天试着炒了个土豆丝，虽然切得粗细不一，但味道居然挺香。一个人也要好好吃饭啊。",
    "image_url": "/images/2026-09-05-19.jpg",
    "image_author": "",
    "created_at": "2026-09-05T17:14:27.288Z"
  },
  {
    "id": "89a0913e-e64a-4053-a81c-d87bd7788eed",
    "date": "2026-09-04",
    "category": "励志",
    "title": "闹钟的答案",
    "content": "六点的闹钟响了三次，我还是爬了起来。晨跑时看到树叶上未干的露珠，忽然明白：没人逼你变好，但总有人在天亮前就出发。",
    "image_url": "/images/2026-09-04-0.jpg",
    "image_author": "",
    "created_at": "2026-09-04T18:12:36.482Z"
  },
  {
    "id": "7244bd19-550c-4f8a-91be-ddb14ffb9eef",
    "date": "2026-09-04",
    "category": "励志",
    "title": "凌晨五点半",
    "content": "凌晨五点半的街道很安静，只有路灯和我的影子。跑步时风划开空气的声音，像在撕掉昨天的日历。每一步都在丈量自己和理想的差距，但没关系，路是跑出来的。",
    "image_url": "/images/2026-09-04-1.jpg",
    "image_author": "",
    "created_at": "2026-09-04T18:12:38.189Z"
  },
  {
    "id": "f820b531-8b6c-492b-8abe-b7ed3381aa19",
    "date": "2026-09-04",
    "category": "励志",
    "title": "把日子过成进度条",
    "content": "六点的闹钟响了第三次，镜子里的黑眼圈又深了。可昨晚那页书终于啃完，晨跑多坚持了十分钟。日子像进度条，慢是慢了点，好在一直往前。",
    "image_url": "/images/2026-09-04-2.jpg",
    "image_author": "",
    "created_at": "2026-09-04T18:12:41.046Z"
  },
  {
    "id": "ad535473-6933-4999-a9b5-307ce9e34998",
    "date": "2026-09-04",
    "category": "励志",
    "title": "自己的节奏",
    "content": "闹钟响了第三遍才爬起来，路上灌了两口凉咖啡。可当晨光透过车窗，忽然觉得，每一次准时出发，都是对未来的一次温柔应允。",
    "image_url": "/images/2026-09-04-3.jpg",
    "image_author": "",
    "created_at": "2026-09-04T18:12:43.765Z"
  },
  {
    "id": "9614c7fc-7a71-4c7d-93b8-a2519f71abd7",
    "date": "2026-09-04",
    "category": "情感",
    "title": "雨天里的想念",
    "content": "下雨了，翻到去年和朋友吃饭的合照，笑着笑着就点了发送。原来想念不需要理由，一条消息就够了。",
    "image_url": "/images/2026-09-04-4.jpg",
    "image_author": "",
    "created_at": "2026-09-04T18:12:45.883Z"
  },
  {
    "id": "b19bf38f-209c-4611-85b1-5aa29e79d715",
    "date": "2026-09-04",
    "category": "情感",
    "title": "雨天的惦记",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没什么要紧事，就是问问ta那边天气怎么样，伞还够不够用。",
    "image_url": "/images/2026-09-04-5.jpg",
    "image_author": "",
    "created_at": "2026-09-04T18:12:48.633Z"
  },
  {
    "id": "ff3a8fad-5d38-4ec2-98eb-5a785fc444a8",
    "date": "2026-09-04",
    "category": "情感",
    "title": "雨天的消息",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。对话框躺着去年秋天的聊天，问一句最近好吗，像推开一扇虚掩的门。",
    "image_url": "/images/2026-09-04-6.jpg",
    "image_author": "",
    "created_at": "2026-09-04T18:12:50.189Z"
  },
  {
    "id": "30b903c9-beb4-43ba-a37f-42552dc6519d",
    "date": "2026-09-04",
    "category": "情感",
    "title": "雨天的消息·0a7",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说想念，只问那边天气如何。她秒回：正在煮姜茶，多放了两块糖，像从前一样甜。",
    "image_url": "/images/2026-09-04-7.jpg",
    "image_author": "",
    "created_at": "2026-09-04T18:12:57.333Z"
  },
  {
    "id": "bd7b977c-51fb-413c-aa87-f7e4a1fa613a",
    "date": "2026-09-04",
    "category": "早安",
    "title": "晨光正好",
    "content": "窗户缝漏进来的光刚好落在咖啡杯沿。咬一口热吐司，蛋香还在舌尖打转，今天也要好好出门，把日子过得有声响。",
    "image_url": "/images/2026-09-04-8.jpg",
    "image_author": "",
    "created_at": "2026-09-04T18:12:59.972Z"
  },
  {
    "id": "26528fea-347f-4df3-9602-99e1ecc6e2dc",
    "date": "2026-09-04",
    "category": "早安",
    "title": "早起的奖赏",
    "content": "窗外鸟叫比闹钟早了一步。煎蛋在锅里滋滋响，咖啡香气飘满厨房。咬一口吐司，突然觉得，日子就是这些琐碎的温暖拼成的。",
    "image_url": "/images/2026-09-04-9.jpg",
    "image_author": "",
    "created_at": "2026-09-04T18:13:02.618Z"
  },
  {
    "id": "8898e4bd-dfe4-46ee-9992-1e7f9bf54f4d",
    "date": "2026-09-04",
    "category": "早安",
    "title": "清晨的味道",
    "content": "咖啡刚冲好，窗外鸟叫正好听。吐司烤得焦香，咬一口，生活的小确幸就这么简单。早安。",
    "image_url": "/images/2026-09-04-10.jpg",
    "image_author": "",
    "created_at": "2026-09-04T18:13:06.520Z"
  },
  {
    "id": "2a9c07b2-2cf0-4537-8012-6bc69ac3de1d",
    "date": "2026-09-04",
    "category": "早安",
    "title": "早餐的仪式感",
    "content": "吐司边烤得刚好，煎蛋还带点溏心。咬一口，窗外的光就落在桌角。原来平凡日子，也能被一顿早餐点亮。",
    "image_url": "/images/2026-09-04-11.jpg",
    "image_author": "",
    "created_at": "2026-09-04T18:13:08.322Z"
  },
  {
    "id": "95bb5ff1-9dc3-4919-b38a-4ded4bcefff7",
    "date": "2026-09-04",
    "category": "晚安",
    "title": "收工时刻",
    "content": "洗完澡躺在床上，头发还湿着，窗外路灯亮得刚刚好。今天所有的事都归今天了，我就想这样安静地躺一会儿。",
    "image_url": "/images/2026-09-04-12.jpg",
    "image_author": "",
    "created_at": "2026-09-04T18:13:09.944Z"
  },
  {
    "id": "e26b41c1-4055-41e3-ab50-b3ba9b302a10",
    "date": "2026-09-04",
    "category": "晚安",
    "title": "今日关门",
    "content": "灯关得刚好，夜沉得刚好，窗外的风也吹得刚好。这一天啊，像翻完的书页，轻轻合上就是。剩下的事，留给明天去拆。今天就到这里吧。",
    "image_url": "/images/2026-09-04-13.jpg",
    "image_author": "",
    "created_at": "2026-09-04T18:13:11.623Z"
  },
  {
    "id": "9281be91-2579-44ed-adad-6f71db446075",
    "date": "2026-09-04",
    "category": "晚安",
    "title": "今天过去了",
    "content": "关了灯，窗外的光漏进来一点。这一天所有的声音都退远了，只剩下自己均匀的呼吸。就这样吧，不着急明天。",
    "image_url": "/images/2026-09-04-14.jpg",
    "image_author": "",
    "created_at": "2026-09-04T18:13:12.935Z"
  },
  {
    "id": "c6b3a93b-bf68-4214-ad2a-8e10a8195b40",
    "date": "2026-09-04",
    "category": "晚安",
    "title": "今日收尾",
    "content": "热水冲走了大半天的疲惫，躺下时，窗外灯火也困了。今天就这样吧，那些没做完的事，留给明天醒来再说。",
    "image_url": "/images/2026-09-04-15.jpg",
    "image_author": "",
    "created_at": "2026-09-04T18:13:15.470Z"
  },
  {
    "id": "dc6cd99f-c213-4d70-8fb6-f3289ecab115",
    "date": "2026-09-04",
    "category": "日常",
    "title": "洗碗时的小发现",
    "content": "今晚洗碗突然发现，油污用热水冲一下就干净了，哪需要那么多洗洁精。生活这老师，天天教点小常识。",
    "image_url": "/images/2026-09-04-16.jpg",
    "image_author": "",
    "created_at": "2026-09-04T18:13:17.426Z"
  },
  {
    "id": "d7502446-a176-48f8-a94a-4c7d7f21cb7a",
    "date": "2026-09-04",
    "category": "日常",
    "title": "今晚的厨房",
    "content": "花一小时做的菜，十分钟就吃完了。但洗碗的时候，突然觉得日子就该这样，慢慢来，好好过。",
    "image_url": "/images/2026-09-04-17.jpg",
    "image_author": "",
    "created_at": "2026-09-04T18:13:19.171Z"
  },
  {
    "id": "d914721a-4e6b-4522-833a-d9d32a206985",
    "date": "2026-09-04",
    "category": "日常",
    "title": "满电的周末",
    "content": "冰箱清空，屋子擦亮，阳台发了会儿呆。晚上遛弯买了菜，明天做饭有着落了。日子嘛，就是这堆琐碎拼起来的。",
    "image_url": "/images/2026-09-04-18.jpg",
    "image_author": "",
    "created_at": "2026-09-04T18:13:20.942Z"
  },
  {
    "id": "86f2a01d-900a-45eb-b0f5-123baa4834fe",
    "date": "2026-09-04",
    "category": "日常",
    "title": "今日份满足",
    "content": "冰箱里剩的菜随便炒了炒，居然意外好吃。收拾完厨房瘫在沙发上，觉得这一天也没白过。",
    "image_url": "/images/2026-09-04-19.jpg",
    "image_author": "",
    "created_at": "2026-09-04T18:13:23.947Z"
  },
  {
    "id": "0f06640a-d177-4a3a-85af-1bacc4055782",
    "date": "2026-09-03",
    "category": "励志",
    "title": "路上的光",
    "content": "七点的闹钟响了三次才爬起来，地铁里挤成照片。可窗外的晨光刚好打在脸上，突然觉得，能朝着想去的地方跑，狼狈也是勋章。",
    "image_url": "/images/2026-09-03-0.jpg",
    "image_author": "",
    "created_at": "2026-09-03T18:25:42.306Z"
  },
  {
    "id": "40007c32-0eb9-4b2b-a966-693ae67b6d87",
    "date": "2026-09-03",
    "category": "励志",
    "title": "天亮前的路",
    "content": "六点的闹钟响了三次才爬起来，窗外的天还是灰的。可当第一缕光落在手背上时，忽然觉得，昨晚熬过的夜都算数。",
    "image_url": "/images/2026-09-03-1.jpg",
    "image_author": "",
    "created_at": "2026-09-03T18:25:44.945Z"
  },
  {
    "id": "c9598a95-889f-494a-b342-6f22043e9a0b",
    "date": "2026-09-03",
    "category": "励志",
    "title": "路",
    "content": "加班完的夜路走了三个月，今天抬头才发现，原来路灯一直亮着。日子不会突然变好，但走着走着，就适应了光。",
    "image_url": "/images/2026-09-03-2.jpg",
    "image_author": "",
    "created_at": "2026-09-03T18:25:46.590Z"
  },
  {
    "id": "2e831ede-3a6a-472c-ae2d-c1fac23a2515",
    "date": "2026-09-03",
    "category": "励志",
    "title": "深夜的路灯",
    "content": "加班到凌晨，整条街就剩路灯陪我。可它亮着，我也走着，这大概就是彼此的默契。",
    "image_url": "/images/2026-09-03-3.jpg",
    "image_author": "",
    "created_at": "2026-09-03T18:25:48.192Z"
  },
  {
    "id": "ae0959b3-71bc-4746-8085-2f60132dd2ec",
    "date": "2026-09-03",
    "category": "情感",
    "title": "对话框",
    "content": "视频挂断后，厨房飘来妈妈炖的汤香。其实相隔千里，有些味道从没断过。今晚月光很好，照着我们各自安好。",
    "image_url": "/images/2026-09-03-4.jpg",
    "image_author": "",
    "created_at": "2026-09-03T18:25:50.883Z"
  },
  {
    "id": "ae6ae370-076d-4bc7-bb06-2b1d1c6be574",
    "date": "2026-09-03",
    "category": "情感",
    "title": "雨天的想念",
    "content": "下雨天，窗台溅起水花，突然想给好久没联系的朋友发条消息。不问近况，只说：记得带伞。",
    "image_url": "/images/2026-09-03-5.jpg",
    "image_author": "",
    "created_at": "2026-09-03T18:25:53.530Z"
  },
  {
    "id": "b2379a65-1454-4aee-b71f-2f4f225fd5e1",
    "date": "2026-09-03",
    "category": "情感",
    "title": "今天的雨",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说太多，就问问那边天气怎么样。她回得很快，附了张窗外的照片。原来有些陪伴，一直都在。就像这场雨，下着下着，心就软了。",
    "image_url": "/images/2026-09-03-6.jpg",
    "image_author": "",
    "created_at": "2026-09-03T18:25:56.374Z"
  },
  {
    "id": "2b69333a-6690-46c8-a060-6cb8c3de91a1",
    "date": "2026-09-03",
    "category": "情感",
    "title": "突然想你了",
    "content": "刚吃完饭，刷到一家常去的店。想起上次和你坐对面，你总把我碗里的香菜挑走。现在窗外下雨了，突然想给你发条消息问一句，最近还好吗。",
    "image_url": "/images/2026-09-03-7.jpg",
    "image_author": "",
    "created_at": "2026-09-03T18:25:59.811Z"
  },
  {
    "id": "eb15d2da-1864-42d9-bd51-1279ed64aa0c",
    "date": "2026-09-03",
    "category": "早安",
    "title": "早安·慢时光",
    "content": "晨光刚爬上窗台，咖啡香就醒了。咬一口酥脆吐司，看窗外行人匆匆。今天不赶路，只好好走路。",
    "image_url": "/images/2026-09-03-8.jpg",
    "image_author": "",
    "created_at": "2026-09-03T18:26:01.155Z"
  },
  {
    "id": "d97385d1-a308-48d0-abf1-6e2544e00f09",
    "date": "2026-09-03",
    "category": "早安",
    "title": "咖啡香里的早安",
    "content": "阳光斜斜洒进厨房，热咖啡的香气刚好飘到窗边。咬一口脆脆的吐司，听见城市慢慢醒来。早安，今天也要好好过。",
    "image_url": "/images/2026-09-03-9.jpg",
    "image_author": "",
    "created_at": "2026-09-03T18:26:03.377Z"
  },
  {
    "id": "453b4de7-6e13-4a1c-939b-038961ac6df1",
    "date": "2026-09-03",
    "category": "早安",
    "title": "晨光正好·792",
    "content": "面包机跳起来时，窗外的光刚好落在餐盘上。咬一口脆边，听见树叶沙沙响。新的一天，是从胃和心都暖开始的。",
    "image_url": "/images/2026-09-03-10.jpg",
    "image_author": "",
    "created_at": "2026-09-03T18:26:10.552Z"
  },
  {
    "id": "b9fc590f-25a7-419f-a3ab-5fdb3e62ecfd",
    "date": "2026-09-03",
    "category": "早安",
    "title": "咖啡香",
    "content": "咖啡刚冲好，吐司边烤得有点焦。推开窗，风把鸟叫送进来。今天打算早点出门，去遇见那些还没被发现的日常。",
    "image_url": "/images/2026-09-03-11.jpg",
    "image_author": "",
    "created_at": "2026-09-03T18:26:15.401Z"
  },
  {
    "id": "9f905c6a-f217-43c8-8178-781a4af1ff9c",
    "date": "2026-09-03",
    "category": "晚安",
    "title": "夜晚收藏家",
    "content": "把今天叠好放进口袋，窗帘拉上，灯光拧暗。窗外霓虹还在营业，但我的世界已经打烊了。",
    "image_url": "/images/2026-09-03-12.jpg",
    "image_author": "",
    "created_at": "2026-09-03T18:26:16.929Z"
  },
  {
    "id": "6007d0cd-a373-42c7-8f1c-11897ce8807e",
    "date": "2026-09-03",
    "category": "晚安",
    "title": "今天的句号",
    "content": "洗完澡躺下来，窗帘缝里漏进一线月光。今天所有的事都归位了，连遗憾也变得安静。就到这里吧，让身体先沉下去。",
    "image_url": "/images/2026-09-03-13.jpg",
    "image_author": "",
    "created_at": "2026-09-03T18:26:21.374Z"
  },
  {
    "id": "8a285e50-ea48-488a-9652-a1f4ff678291",
    "date": "2026-09-03",
    "category": "晚安",
    "title": "灯熄之后",
    "content": "头发还潮着，窗外起了雾。手机屏幕的光暗下去，房间里只剩下呼吸声。一天的重，终于卸在枕边。就到这里吧，剩下的交给梦。晚安。",
    "image_url": "/images/2026-09-03-14.jpg",
    "image_author": "",
    "created_at": "2026-09-03T18:26:23.174Z"
  },
  {
    "id": "478ed455-dbf8-44ab-9a42-ea79ae754282",
    "date": "2026-09-03",
    "category": "晚安",
    "title": "夜归于静",
    "content": "灯关上的瞬间，窗帘缝里漏进一绺月光。今天所有声响都停在那里了，像水慢慢沉底。我躺下来，听见自己的呼吸，很轻，很真实。",
    "image_url": "/images/2026-09-03-15.jpg",
    "image_author": "",
    "created_at": "2026-09-03T18:26:26.057Z"
  },
  {
    "id": "957b6a56-3d84-4b80-9c76-315bda09764f",
    "date": "2026-09-03",
    "category": "日常",
    "title": "今天的厨房成就",
    "content": "今天自己做了碗面，味道居然还不错，汤都喝光了。收拾完屋子，去阳台发了会儿呆，感觉这一天也没白过。",
    "image_url": "/images/2026-09-03-16.jpg",
    "image_author": "",
    "created_at": "2026-09-03T18:26:27.702Z"
  },
  {
    "id": "e0a0a012-0b63-454c-ab1a-18abe02f6f65",
    "date": "2026-09-03",
    "category": "日常",
    "title": "今天有点小成就",
    "content": "收拾完屋子扔掉三大袋杂物，傍晚炒了盘青菜没糊。坐在阳台吹风时突然觉得，把日子过顺溜也挺了不起。",
    "image_url": "/images/2026-09-03-17.jpg",
    "image_author": "",
    "created_at": "2026-09-03T18:26:30.273Z"
  },
  {
    "id": "4ea0410c-cde7-4de9-83b4-7c75aa8b2277",
    "date": "2026-09-03",
    "category": "日常",
    "title": "冰箱剩菜创造日",
    "content": "把冰箱剩菜翻出来炒了个大杂烩，本来没抱希望，结果好吃到舔盘子。果然饿了吃啥都香。",
    "image_url": "/images/2026-09-03-18.jpg",
    "image_author": "",
    "created_at": "2026-09-03T18:26:31.797Z"
  },
  {
    "id": "ac2b03b5-fcad-4c3a-95b6-c68f1ca3f7ee",
    "date": "2026-09-03",
    "category": "日常",
    "title": "周末做饭记",
    "content": "今天自己做了碗面，味道居然还不错。收拾完屋子，顺便把阳台的花浇了。晚上出去遛个弯，风挺凉快。",
    "image_url": "/images/2026-09-03-19.jpg",
    "image_author": "",
    "created_at": "2026-09-03T18:26:34.196Z"
  },
  {
    "id": "de9094b8-d413-4f66-9612-63212f5ce7ce",
    "date": "2026-09-02",
    "category": "励志",
    "title": "方向对就行",
    "content": "六点半的闹钟响了三次才爬起来，地铁上依然没有座位。但窗外的光越来越亮，这大概就是坚持的意义。",
    "image_url": "/images/2026-09-02-0.jpg",
    "image_author": "",
    "created_at": "2026-09-02T18:29:47.266Z"
  },
  {
    "id": "41752c06-f8fb-49a5-a104-823620bafcae",
    "date": "2026-09-02",
    "category": "励志",
    "title": "日子在跑",
    "content": "闹钟响第三次爬起来，天还没亮。咖啡倒进保温杯时突然明白，所谓坚持，不过是把昨天咬牙做完的事，今天再心甘情愿地做一遍。",
    "image_url": "/images/2026-09-02-1.jpg",
    "image_author": "",
    "created_at": "2026-09-02T18:29:49.339Z"
  },
  {
    "id": "73733521-187f-4974-8fe7-b14f7643e2de",
    "date": "2026-09-02",
    "category": "励志",
    "title": "六点的风",
    "content": "闹钟响第六次才爬起来，电梯里对镜子练习微笑。六点的风有点凉，但跑起来就热了。昨天没做完的事，今天接着做。生活就是这样，一步步走，总会走到想去的路口。",
    "image_url": "/images/2026-09-02-2.jpg",
    "image_author": "",
    "created_at": "2026-09-02T18:29:51.285Z"
  },
  {
    "id": "11a838ce-39af-4eee-8f4d-9b6c9770f85b",
    "date": "2026-09-02",
    "category": "励志",
    "title": "天亮之前",
    "content": "闹钟响的时候天还没亮，窗外的路灯陪我刷牙。昨晚的疲惫还在，但今天的地铁会载我去想去的地方。",
    "image_url": "/images/2026-09-02-3.jpg",
    "image_author": "",
    "created_at": "2026-09-02T18:29:54.270Z"
  },
  {
    "id": "0e68779e-1411-4e43-bf32-0110fb4c1fc8",
    "date": "2026-09-02",
    "category": "情感",
    "title": "突然的牵挂",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。其实没什么事，就是想知道你最近过得好不好。",
    "image_url": "/images/2026-09-02-4.jpg",
    "image_author": "",
    "created_at": "2026-09-02T18:29:55.569Z"
  },
  {
    "id": "cc98f5c1-52c0-4e99-a265-9e9a99d4e151",
    "date": "2026-09-02",
    "category": "情感",
    "title": "雨天的信号",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。其实也没什么要紧事，就是想说，今天的雨声很好听，像我们以前一起听的那场。",
    "image_url": "/images/2026-09-02-5.jpg",
    "image_author": "",
    "created_at": "2026-09-02T18:29:57.052Z"
  },
  {
    "id": "3234b54d-c731-4610-8b05-bfe49300ad87",
    "date": "2026-09-02",
    "category": "情感",
    "title": "岁月静好",
    "content": "视频里妈妈正在织毛衣，说这边降温了。我数了数，她手边那双袜子，正好是我们俩的码数。",
    "image_url": "/images/2026-09-02-6.jpg",
    "image_author": "",
    "created_at": "2026-09-02T18:30:04.137Z"
  },
  {
    "id": "ed906c43-355c-4991-83bb-cd491699aa65",
    "date": "2026-09-02",
    "category": "情感",
    "title": "雨天的电话",
    "content": "下雨天，翻到去年和老友的合照，顺手拨了电话。那边接起就说：'怎么每次下雨你都想起我？'我们都笑了，好像时间从没走过。",
    "image_url": "/images/2026-09-02-7.jpg",
    "image_author": "",
    "created_at": "2026-09-02T18:30:05.991Z"
  },
  {
    "id": "a2ce797b-e163-4cbd-82e7-8d1f0a833871",
    "date": "2026-09-02",
    "category": "早安",
    "title": "晨间序曲",
    "content": "阳光刚好落在吐司边沿，煎蛋的香气叫醒了窗台。咬一口酥脆，喝完最后一口拿铁，该出发了。城市还没完全醒来，而我已把今天预热好了。",
    "image_url": "/images/2026-09-02-8.jpg",
    "image_author": "",
    "created_at": "2026-09-02T18:30:09.828Z"
  },
  {
    "id": "2312fe79-dd1f-4a6a-88ae-6a7e8848731d",
    "date": "2026-09-02",
    "category": "早安",
    "title": "咖啡醒了，我也醒了",
    "content": "阳光斜照进厨房，吐司边微焦，咖啡香飘到窗台。咬一口蛋，听鸟叫，慢慢把日子过成喜欢的样子。",
    "image_url": "/images/2026-09-02-9.jpg",
    "image_author": "",
    "created_at": "2026-09-02T18:30:11.648Z"
  },
  {
    "id": "4586efbc-b514-4a2c-9681-4fcac6d92432",
    "date": "2026-09-02",
    "category": "早安",
    "title": "早起的甜头",
    "content": "晨光还带点凉，吐司烤得刚好，咬一口，听见自己心情酥脆的声音。出门时风正好，把昨天吹得很远。",
    "image_url": "/images/2026-09-02-10.jpg",
    "image_author": "",
    "created_at": "2026-09-02T18:30:19.518Z"
  },
  {
    "id": "f943fd53-e047-43a1-b73c-97770446a91b",
    "date": "2026-09-02",
    "category": "早安",
    "title": "太阳刚醒",
    "content": "豆浆冒着热气，吐司边烤得刚好。推开门，风里有桂花香。慢悠悠走路去上班，今天没什么要紧事，真好。",
    "image_url": "/images/2026-09-02-11.jpg",
    "image_author": "",
    "created_at": "2026-09-02T18:30:25.940Z"
  },
  {
    "id": "f8e406c3-9a53-4da5-bb3a-cc4c5ba4806f",
    "date": "2026-09-02",
    "category": "晚安",
    "title": "夜归人",
    "content": "洗完热水澡，头发还湿着，窗外零星几盏灯也暗了。今天的好与坏都随那盏床头灯熄灭吧，世界安静得刚好。",
    "image_url": "/images/2026-09-02-12.jpg",
    "image_author": "",
    "created_at": "2026-09-02T18:30:27.699Z"
  },
  {
    "id": "5bdbd559-e979-4a60-b2b6-12ebe52d1595",
    "date": "2026-09-02",
    "category": "晚安",
    "title": "今日止步",
    "content": "灯关了，窗外还亮着几盏别人的故事。被子裹住今天最后一点温热，风很轻，夜很静，就这样吧。",
    "image_url": "/images/2026-09-02-13.jpg",
    "image_author": "",
    "created_at": "2026-09-02T18:30:29.503Z"
  },
  {
    "id": "fd76c656-7803-4510-8947-4bb907e59a3c",
    "date": "2026-09-02",
    "category": "晚安",
    "title": "今日收摊",
    "content": "热水冲走了今天的疲惫，被子裹住所有未说出口的话。窗外灯光一盏盏熄灭，我也该把思绪调成静音了。",
    "image_url": "/images/2026-09-02-14.jpg",
    "image_author": "",
    "created_at": "2026-09-02T18:30:31.387Z"
  },
  {
    "id": "a64e5cc4-456c-4202-8636-f9b274f2050b",
    "date": "2026-09-02",
    "category": "晚安",
    "title": "灯下的句点",
    "content": "热水冲走了白天的重量，头发还带着潮气。窗外灯火渐次熄灭，今天的最后一道光，是我手机屏幕的亮度。就到这里吧，不急着入睡，只是让呼吸慢下来。",
    "image_url": "/images/2026-09-02-15.jpg",
    "image_author": "",
    "created_at": "2026-09-02T18:30:33.366Z"
  },
  {
    "id": "aa780f5c-a8c9-4599-8c48-778fcf07977b",
    "date": "2026-09-02",
    "category": "日常",
    "title": "收拾完厨房",
    "content": "把灶台擦了三遍，垃圾也扔了。做饭半小时，收拾一小时，但看着亮堂堂的，挺值。",
    "image_url": "/images/2026-09-02-16.jpg",
    "image_author": "",
    "created_at": "2026-09-02T18:30:35.370Z"
  },
  {
    "id": "563a9c6b-a3cc-45c2-9f7d-06d98227293f",
    "date": "2026-09-02",
    "category": "日常",
    "title": "周末厨房实验",
    "content": "周末试着做了红烧肉，糖色炒糊了但味道居然还行。收拾完厨房，阳台上发了会儿呆，这日子过得挺实在。",
    "image_url": "/images/2026-09-02-17.jpg",
    "image_author": "",
    "created_at": "2026-09-02T18:30:37.168Z"
  },
  {
    "id": "a3fde25b-8e63-4e4b-8ace-f8e4b991790f",
    "date": "2026-09-02",
    "category": "日常",
    "title": "今日份快乐",
    "content": "收拾完屋子，顺手煮了碗馄饨，热乎乎吃下去，感觉整个人都被治愈了。生活嘛，简单点也挺好。",
    "image_url": "/images/2026-09-02-18.jpg",
    "image_author": "",
    "created_at": "2026-09-02T18:30:38.974Z"
  },
  {
    "id": "d7184099-c41d-4e59-99ce-9ee7fb13a1c1",
    "date": "2026-09-02",
    "category": "日常",
    "title": "买菜回来",
    "content": "买了把蔫儿葱，回家路上顺手理了理，晚上炒菜时居然还挺香。生活大概就是这些不起眼的小事儿，凑合凑合也挺好。",
    "image_url": "/images/2026-09-02-19.jpg",
    "image_author": "",
    "created_at": "2026-09-02T18:30:41.048Z"
  },
  {
    "id": "e90be8a5-961f-4d55-a278-ccef18cd9fd2",
    "date": "2026-09-01",
    "category": "励志",
    "title": "第七天",
    "content": "闹钟响的时候天还没亮，手机屏幕显示6:03。第七天早起，呼吸开始适应清晨的风。原来改变不需要惊天动地，只要比昨天早一点点。",
    "image_url": "/images/2026-09-01-0.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:16:40.508Z"
  },
  {
    "id": "17f767df-2633-4851-a4ee-9af4adb8d60f",
    "date": "2026-09-01",
    "category": "励志",
    "title": "慢一点也没关系",
    "content": "加班到凌晨，电梯里看到镜子里发红的眼睛。突然明白，重要的不是跑多快，而是每一步都算数。",
    "image_url": "/images/2026-09-01-1.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:16:42.352Z"
  },
  {
    "id": "dccfa632-53ea-4039-8a7e-d878a6319a1b",
    "date": "2026-09-01",
    "category": "励志",
    "title": "关于清晨",
    "content": "六点的闹钟响了第三次才爬起来。窗外天刚亮，楼下早餐摊冒着热气。忽然觉得，能准时醒来这件事本身，就是今天的小胜利。",
    "image_url": "/images/2026-09-01-2.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:16:44.495Z"
  },
  {
    "id": "ecbeacef-fb15-48e8-b872-9c8e7ef095bc",
    "date": "2026-09-01",
    "category": "励志",
    "title": "微光",
    "content": "凌晨五点的街道很安静，路灯把我的影子拉得很长。走完最后一公里，突然觉得，每天多坚持一点，就是在给未来的自己铺路。",
    "image_url": "/images/2026-09-01-3.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:16:46.371Z"
  },
  {
    "id": "4cef1a0f-2c06-4f28-a7e6-eacc02ac2218",
    "date": "2026-09-01",
    "category": "情感",
    "title": "饭桌上的想念",
    "content": "今天路过我们常去的那家店，突然想给你打个电话。老位置还亮着灯，只是对面少了你。等你回来，我们再吃一顿，还是点那个辣锅。",
    "image_url": "/images/2026-09-01-4.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:16:48.648Z"
  },
  {
    "id": "34866b15-56f6-4cd8-8cd9-b46d0668359b",
    "date": "2026-09-01",
    "category": "情感",
    "title": "收到回音",
    "content": "下雨天，翻到去年合照，顺手给老友发了句“想你了”。没想到秒回：“正想找你，出来吃面？”原来想念，总能碰巧撞见。",
    "image_url": "/images/2026-09-01-5.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:16:50.634Z"
  },
  {
    "id": "4dccbe81-41e3-4e26-9beb-1200e174bff0",
    "date": "2026-09-01",
    "category": "情感",
    "title": "雨天想起你",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说太多，就问问那边天气怎么样。有些想念，不必刻意表达。",
    "image_url": "/images/2026-09-01-6.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:16:52.348Z"
  },
  {
    "id": "a405cba3-aa13-4926-b970-c851ccb258af",
    "date": "2026-09-01",
    "category": "情感",
    "title": "雨天来信",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说太多，就问了句你那下雨了吗。他回：下了，刚收衣服呢。像从前一样。",
    "image_url": "/images/2026-09-01-7.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:16:54.041Z"
  },
  {
    "id": "22b18158-ca35-46e4-b408-48ee63e7977a",
    "date": "2026-09-01",
    "category": "早安",
    "title": "早啊",
    "content": "吐司烤到微焦，咖啡刚好冒热气。窗外鸟叫了几声，像在催我出门。今天步子轻快些，风也识趣地让了路。",
    "image_url": "/images/2026-09-01-8.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:16:58.266Z"
  },
  {
    "id": "7abd2702-9f6b-47e1-b728-d5430366aaca",
    "date": "2026-09-01",
    "category": "早安",
    "title": "把清晨含在嘴里",
    "content": "煎蛋在锅里滋啦响，面包机弹起的瞬间香得刚好。咬一口，阳光也跟着碎在齿间。新一天，从舌尖开始发亮。",
    "image_url": "/images/2026-09-01-9.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:17:00.164Z"
  },
  {
    "id": "a7304006-eee3-4133-a263-3266a716667e",
    "date": "2026-09-01",
    "category": "早安",
    "title": "早安，光是免费的",
    "content": "窗外的光刚洒进来，烤面包机叮一声，咖啡冒热气。出门前看到楼下猫伸懒腰。生活不复杂，吃饱睡好，走着走着天就亮了。",
    "image_url": "/images/2026-09-01-10.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:17:07.656Z"
  },
  {
    "id": "f369f57b-b20f-410d-b9cf-414590f42dd9",
    "date": "2026-09-01",
    "category": "早安",
    "title": "早安，生活",
    "content": "煎蛋在锅里滋滋响，咖啡香飘满屋。咬一口酥脆吐司，阳光正好落在窗台。晨风凉凉的，吹醒还带着睡意的脸。新的一天，慢慢来，好好过。",
    "image_url": "/images/2026-09-01-11.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:17:11.230Z"
  },
  {
    "id": "b6532d7e-43b1-4047-a552-6c9d4e4b5823",
    "date": "2026-09-01",
    "category": "晚安",
    "title": "今日打烊",
    "content": "窗帘拉上，路灯还亮着。手机放远，被子裹紧。这一天不管圆满还是遗憾，都该收进夜色里了。",
    "image_url": "/images/2026-09-01-12.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:17:12.982Z"
  },
  {
    "id": "a4cefc6b-b805-4fce-9898-2610f282f305",
    "date": "2026-09-01",
    "category": "晚安",
    "title": "夜线",
    "content": "洗完澡躺在床上，窗帘没拉严，月光漏进来一小块。今天的事今天结束，大脑关机，身体慢慢卸下所有力气。",
    "image_url": "/images/2026-09-01-13.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:17:14.955Z"
  },
  {
    "id": "3df84cf5-310f-407b-a6b2-db57dfbe7142",
    "date": "2026-09-01",
    "category": "晚安",
    "title": "夜色收尾",
    "content": "窗帘留一条缝，让月光进来坐坐。今天的事，到此为止。剩下的，交给夜消化，我只要睡意。",
    "image_url": "/images/2026-09-01-14.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:17:18.005Z"
  },
  {
    "id": "b1f4fca5-694c-4595-8225-f6d22f32cae0",
    "date": "2026-09-01",
    "category": "晚安",
    "title": "今日关机",
    "content": "刚关灯，窗外零星几盏灯还醒着，像替我守着夜晚。今天的情绪都收好了，枕头接住所有疲惫，现在只想安静沉下去。",
    "image_url": "/images/2026-09-01-15.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:17:19.750Z"
  },
  {
    "id": "7ff20fb4-30aa-4dfd-8d9f-c60dfb142684",
    "date": "2026-09-01",
    "category": "日常",
    "title": "烟火气",
    "content": "路过菜市场顺手买了把青菜，回来煮了锅汤。阳台风挺大，喝着汤看对面窗户亮灯，感觉日子就这样，挺踏实。",
    "image_url": "/images/2026-09-01-16.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:17:21.909Z"
  },
  {
    "id": "0aff0b8c-2317-4c43-9867-12780db5c2ca",
    "date": "2026-09-01",
    "category": "日常",
    "title": "周末的仪式感",
    "content": "花一下午收拾了屋子，扔了三袋杂物，阳台擦得能反光。累是累了点，但看哪儿都顺眼，这感觉真上头。",
    "image_url": "/images/2026-09-01-17.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:17:23.869Z"
  },
  {
    "id": "5f9c803d-ad5a-4fa4-a13e-eb15619242ec",
    "date": "2026-09-01",
    "category": "日常",
    "title": "周末的慢生活",
    "content": "睡到自然醒，去菜市场买了把青菜，回来煮了锅粥。阳台发了会儿呆，看云，看楼下遛狗的人。日子就这样，挺好。",
    "image_url": "/images/2026-09-01-18.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:17:27.017Z"
  },
  {
    "id": "841d3fc8-37f8-4107-ac35-35cb36ce4320",
    "date": "2026-09-01",
    "category": "日常",
    "title": "好好吃饭",
    "content": "今天自己做了碗面，味道居然还不错。吃完把厨房收拾干净，窗外天也黑了。平凡日子，能这样踏踏实实过，也挺好。",
    "image_url": "/images/2026-09-01-19.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:17:29.307Z"
  },
  {
    "id": "0afeed83-04fd-46f3-9a4e-3e155dece7f3",
    "date": "2026-08-31",
    "category": "励志",
    "title": "闹钟响起的时候",
    "content": "六点的闹钟响了三次才爬起来，天还黑着。但想想昨晚那页读完的书，今天地铁上还能再翻几页，忽然觉得这趟早班车也值得赶。",
    "image_url": "/images/2026-08-31-0.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:43:38.475Z"
  },
  {
    "id": "b271fb64-d072-4dfb-91cf-1b375ee7c874",
    "date": "2026-08-31",
    "category": "励志",
    "title": "凌晨六点的闹钟",
    "content": "凌晨六点的闹钟响了三次才爬起来。窗外的天还暗着，但想到昨天那个没攻克的难题，突然觉得早起也没那么难熬。",
    "image_url": "/images/2026-08-31-1.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:43:40.299Z"
  },
  {
    "id": "c6441630-0965-44b9-8dfa-6f79ca3f28ea",
    "date": "2026-08-31",
    "category": "励志",
    "title": "自动导航",
    "content": "闹钟响的时候犹豫了三秒，还是起来了。晨光透过窗帘，像极了我现在的状态——不算明亮，但足够看清前路。",
    "image_url": "/images/2026-08-31-2.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:43:42.927Z"
  },
  {
    "id": "211d0cac-7900-4e5a-93be-26cedffc2fad",
    "date": "2026-08-31",
    "category": "励志",
    "title": "六点的闹钟",
    "content": "闹钟响的时候天还没亮，但想到今天要追的那个目标，还是爬起来了。窗外雾蒙蒙的，可我知道走起来就会亮。",
    "image_url": "/images/2026-08-31-3.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:43:49.077Z"
  },
  {
    "id": "8c9a16a0-cf66-4918-bacc-baf976ce1e2e",
    "date": "2026-08-31",
    "category": "情感",
    "title": "雨天来电",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。其实也没什么事，就是想说，今天雨声很好听。",
    "image_url": "/images/2026-08-31-4.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:43:52.675Z"
  },
  {
    "id": "ec6501d6-f3b7-4087-911c-9f260f0765b6",
    "date": "2026-08-31",
    "category": "情感",
    "title": "一通电话",
    "content": "晚饭后给爸妈打了个视频，他们正为电视里的小品笑得前仰后合。挂了电话，屋里安静得能听见自己的心跳，突然好想回家吃饭。",
    "image_url": "/images/2026-08-31-5.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:43:55.009Z"
  },
  {
    "id": "7d492ef2-c933-42c7-8fa7-4a0a17265acd",
    "date": "2026-08-31",
    "category": "情感",
    "title": "晚饭后的电话",
    "content": "饭后散步，手机响了，是妈妈打来的。聊了半小时家常，挂断时路灯刚好亮起。原来被惦记的感觉，就是有人愿意听你说些无关紧要的事。",
    "image_url": "/images/2026-08-31-6.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:00.519Z"
  },
  {
    "id": "fc06accc-0e44-4ec2-88ff-3daef1bb3d4f",
    "date": "2026-08-31",
    "category": "情感",
    "title": "雨天的牵挂",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说太多，就问问那边天气怎样，伞还够不够用。",
    "image_url": "/images/2026-08-31-7.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:01.916Z"
  },
  {
    "id": "969fe010-5d18-4814-8b45-60d46a809e00",
    "date": "2026-08-31",
    "category": "早安",
    "title": "晨光正好·n6l",
    "content": "咖啡刚冲好，窗外鸟叫得勤快。咬一口烤过的面包边，脆得掉渣。今天不赶时间，慢慢走，太阳已经暖了。",
    "image_url": "/images/2026-08-31-8.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:08.892Z"
  },
  {
    "id": "70d94133-06ec-4035-a273-0dc29d24d2c0",
    "date": "2026-08-31",
    "category": "早安",
    "title": "早安，晨光正好",
    "content": "煎蛋在锅里滋滋响，咖啡香飘满屋。咬一口酥脆吐司，窗外的风刚好把树叶吹得沙沙响。今天的开场，简单又刚好。",
    "image_url": "/images/2026-08-31-9.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:12.104Z"
  },
  {
    "id": "ddcab959-f7f6-4fd3-9e16-eca28c256f6c",
    "date": "2026-08-31",
    "category": "早安",
    "title": "晨光与吐司",
    "content": "煎蛋在锅里滋滋响，咖啡香飘满厨房。阳光正好落在餐盘边沿，吃完这口就出门吧，风很轻，路还长。",
    "image_url": "/images/2026-08-31-10.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:13.710Z"
  },
  {
    "id": "5719c9b6-07f6-49c8-9d70-ca92ece40386",
    "date": "2026-08-31",
    "category": "早安",
    "title": "晨光里的烟火气",
    "content": "吐司边烤得刚好，煎蛋在锅里滋滋响。咖啡冒热气时，阳光也溜进窗台。吃饱出门，风很轻，路很长，日子慢慢过。",
    "image_url": "/images/2026-08-31-11.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:15.231Z"
  },
  {
    "id": "ccb6a263-291d-48ec-9f10-14086ae6f3ba",
    "date": "2026-08-31",
    "category": "晚安",
    "title": "夜晚的收尾",
    "content": "热水冲走了一天的黏腻，窗帘拉上，城市的光还有一点透进来。今天所有的声音，都关在门外面了。",
    "image_url": "/images/2026-08-31-12.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:18.225Z"
  },
  {
    "id": "d17d5bc6-d7a1-4ede-ab9b-15ef5fbca95e",
    "date": "2026-08-31",
    "category": "晚安",
    "title": "夜归处",
    "content": "热水带走了今天的尘土，灯一关，窗外的光像稀释的蜂蜜。枕头上有太阳晒过的味道，此刻连呼吸都慢下来了。",
    "image_url": "/images/2026-08-31-13.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:19.846Z"
  },
  {
    "id": "be23be81-6fef-400e-8574-626f3a452709",
    "date": "2026-08-31",
    "category": "晚安",
    "title": "灯熄之前",
    "content": "窗外零星几点灯火，和我一样还没睡。被子晒过太阳的味道，足够抚平今天的褶皱。明天的事，明天再想。今晚，我只要月光落进窗帘的缝隙。",
    "image_url": "/images/2026-08-31-14.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:21.685Z"
  },
  {
    "id": "cf89059c-e86e-4bfd-8d3d-8ea565eb0615",
    "date": "2026-08-31",
    "category": "晚安",
    "title": "关灯前的清醒",
    "content": "窗外的灯光一盏盏暗下去，我数到第七盏时，发现自己今天忘了看晚霞。热水冲走疲惫，手机搁在床头，此刻只有呼吸声陪着我。今天就到这里吧，把没说完的话留给明天。",
    "image_url": "/images/2026-08-31-15.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:25.241Z"
  },
  {
    "id": "192e7b09-c579-4751-957c-23bd2ced8ee1",
    "date": "2026-08-31",
    "category": "日常",
    "title": "自己动手",
    "content": "今天试着做了个番茄炒蛋，卖相一般但味道居然还行。收拾完厨房瘫在沙发上，突然觉得一个人住也挺好。",
    "image_url": "/images/2026-08-31-16.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:32.039Z"
  },
  {
    "id": "d630378d-7822-43f0-8073-727a5179a17e",
    "date": "2026-08-31",
    "category": "日常",
    "title": "生活的小确幸",
    "content": "今天自己做了碗面，味道居然还不错。收拾完房间，阳台发了会儿呆，傍晚的风凉快得刚好。日子嘛，简单点挺好。",
    "image_url": "/images/2026-08-31-17.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:34.477Z"
  },
  {
    "id": "93a4f514-a3ea-4e58-bf65-561214786397",
    "date": "2026-08-31",
    "category": "日常",
    "title": "周末的厨房",
    "content": "周末在家收拾完屋子，顺手煮了锅粥。切菜的时候发现冰箱里那根黄瓜终于被用掉了，成就感莫名爆棚。",
    "image_url": "/images/2026-08-31-18.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:36.540Z"
  },
  {
    "id": "9105214f-5814-45ea-9d3d-10617f26eefa",
    "date": "2026-08-31",
    "category": "日常",
    "title": "做饭日常",
    "content": "今天自己做了碗面，味道居然还不错。收拾完屋子又去小区遛了一圈，日子平平淡淡，但挺舒服的。",
    "image_url": "/images/2026-08-31-19.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:39.423Z"
  },
  {
    "id": "6e2d8cf4-c0da-40d5-b58c-6b7c9a1344dc",
    "date": "2026-08-30",
    "category": "励志",
    "title": "夜路",
    "content": "十一点的地铁末班车，人少了很多。今天又学了两个新东西，窗外的路灯连成线，像在给我指方向。",
    "image_url": "/images/2026-08-30-0.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:30:59.273Z"
  },
  {
    "id": "6f6477e1-6b27-47ec-91c2-4487e2c72a19",
    "date": "2026-08-30",
    "category": "励志",
    "title": "早七点的光",
    "content": "闹钟响了三遍才爬起来，咖啡灌下去的时候天刚亮。地铁里挤成沙丁鱼，可窗外那缕阳光正好打在脸上。日子不就是这样，摸着黑往前走，走着走着天就亮了。",
    "image_url": "/images/2026-08-30-1.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:01.467Z"
  },
  {
    "id": "44c1fa60-c98d-48bf-84d8-faafa0e4e4a2",
    "date": "2026-08-30",
    "category": "励志",
    "title": "在裂缝里生根",
    "content": "六点半的闹钟响了三次，我数着地铁的报站声，把昨天没做完的事又默念了一遍。城市还没醒透，但我的植物已经朝着光转了方向。",
    "image_url": "/images/2026-08-30-2.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:04.833Z"
  },
  {
    "id": "7ab46503-4db5-4a68-a9a0-45a545e2d78f",
    "date": "2026-08-30",
    "category": "励志",
    "title": "晨光里的答案",
    "content": "六点的闹钟响了三次才起来，电梯里遇见的晨跑大爷比我还精神。路过早餐摊，老板娘记得我的口味。日子就这样普通地重复着，但今天比昨天多跑了半公里。",
    "image_url": "/images/2026-08-30-3.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:08.799Z"
  },
  {
    "id": "c3b8e7ca-3d7d-4a9e-bf94-4f4f23834aad",
    "date": "2026-08-30",
    "category": "情感",
    "title": "雨天信号",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。最后只发了句“你那边下雨了吗”，对方秒回“下了，正想问你呢”。",
    "image_url": "/images/2026-08-30-4.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:11.108Z"
  },
  {
    "id": "743257ac-d5c1-4e71-9b2a-a404b593a364",
    "date": "2026-08-30",
    "category": "情感",
    "title": "下雨天的消息",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没有什么特别的事，就是想说，外面下雨了，你那边还好吗。",
    "image_url": "/images/2026-08-30-5.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:13.071Z"
  },
  {
    "id": "ac62cc2e-53ae-4d3c-9cdc-5090100faf86",
    "date": "2026-08-30",
    "category": "情感",
    "title": "隔空碰杯",
    "content": "和爸妈视频，各自端着晚饭，隔着屏幕碰了碰杯。菜还是那些菜，只是笑声变成了双份的。",
    "image_url": "/images/2026-08-30-6.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:14.829Z"
  },
  {
    "id": "0e5f52f6-1e8a-4631-af92-299034589f30",
    "date": "2026-08-30",
    "category": "情感",
    "title": "忽然想你了",
    "content": "下雨天，窗外的雨声刚好盖过心跳。翻到去年今日的照片，突然想给好久没联系的人发条消息：最近好吗？",
    "image_url": "/images/2026-08-30-7.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:20.074Z"
  },
  {
    "id": "9fa5b6e8-f7ab-4f84-8dcb-7c7e52cb897c",
    "date": "2026-08-30",
    "category": "早安",
    "title": "早起的奖励",
    "content": "咬下第一口酥脆吐司时，阳光刚好爬上桌角。煎蛋边缘微焦，咖啡冒热气。生活的小确幸，就藏在这些准时发生的日常里。",
    "image_url": "/images/2026-08-30-8.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:22.843Z"
  },
  {
    "id": "c2d3f029-16a1-42f2-b8e4-b29cebb4eb34",
    "date": "2026-08-30",
    "category": "早安",
    "title": "晨光与咖啡",
    "content": "窗外鸟叫比闹钟早十分钟。煎蛋在锅里滋滋响，咖啡香飘满屋。推开门，风里有桂花味，今天也要好好走。}",
    "image_url": "/images/2026-08-30-9.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:24.826Z"
  },
  {
    "id": "eaf655b1-e586-4297-8c1f-98180e8da2a2",
    "date": "2026-08-30",
    "category": "早安",
    "title": "晨光刚好",
    "content": "咬下第一口烤吐司时，阳光正好落在桌角。窗外的鸟叫混着咖啡香，忽然觉得，连赶路都值得期待。",
    "image_url": "/images/2026-08-30-10.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:26.750Z"
  },
  {
    "id": "3aca405a-a4e0-4b6a-adf4-95476918884e",
    "date": "2026-08-30",
    "category": "早安",
    "title": "闹钟响了三遍",
    "content": "阳光斜斜落进厨房，煎蛋边沿微焦。面包机叮一声，拿铁刚好不烫嘴。出门抬头，云朵像刚睡醒的猫在伸懒腰。",
    "image_url": "/images/2026-08-30-11.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:28.756Z"
  },
  {
    "id": "b0028594-e85b-473b-abf2-08ed05129690",
    "date": "2026-08-30",
    "category": "晚安",
    "title": "今日终章",
    "content": "窗帘留了一道缝，夜光漫进来，像替世界按了静音。头发还湿着，这一天终于褪成背景音。",
    "image_url": "/images/2026-08-30-12.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:30.464Z"
  },
  {
    "id": "24040c08-68b8-455d-a203-acecb8c949da",
    "date": "2026-08-30",
    "category": "晚安",
    "title": "夜已深",
    "content": "洗完澡躺在床上，窗帘缝里漏进几缕路灯。手机放着白噪音，窗外的城市慢慢安静下来。今天就到这里吧，让所有的疲惫都留在灯光熄灭之前。",
    "image_url": "/images/2026-08-30-13.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:34.758Z"
  },
  {
    "id": "db004b25-d835-4caf-b9da-a830c22f8505",
    "date": "2026-08-30",
    "category": "晚安",
    "title": "夜的收尾",
    "content": "洗完澡躺下来，窗外的灯一盏盏灭了。手机调暗，屏幕的蓝光也变得柔软。今天所有声响都沉进棉被里，此刻只需呼吸，就很好。",
    "image_url": "/images/2026-08-30-14.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:36.443Z"
  },
  {
    "id": "5cbc188c-1f51-4fd3-be22-8eeb2d6ec5a5",
    "date": "2026-08-30",
    "category": "晚安",
    "title": "把今天放下",
    "content": "灯一关，窗外的城市就亮起来了。热水冲走了白天的声音，现在只剩呼吸和心跳，慢悠悠的。这一天，就让它留在浴室的雾气里吧。",
    "image_url": "/images/2026-08-30-15.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:40.301Z"
  },
  {
    "id": "fd1b9770-d017-4f20-889d-9a74da64a1eb",
    "date": "2026-08-30",
    "category": "日常",
    "title": "今天的厨房战绩",
    "content": "今天自己做了碗面，味道居然还不错。厨房收拾干净那会儿，突然觉得过日子也就这么回事，舒服。",
    "image_url": "/images/2026-08-30-16.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:42.506Z"
  },
  {
    "id": "18136f37-30fb-43e0-b1a3-3361e4d4970c",
    "date": "2026-08-30",
    "category": "日常",
    "title": "一人食",
    "content": "今天自己做了碗面，味道居然还不错。卖相一般但汤底很鲜，边吃边刷剧，这日子过得也还行。",
    "image_url": "/images/2026-08-30-17.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:44.551Z"
  },
  {
    "id": "ec40bd87-23c4-4edd-a152-b58eec81f4e4",
    "date": "2026-08-30",
    "category": "日常",
    "title": "阳台发呆",
    "content": "收拾完屋子，阳台站了会儿。风挺舒服的，楼下有人遛狗，晚霞粉粉的。突然觉得这样啥也不干也挺好。",
    "image_url": "/images/2026-08-30-18.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:46.287Z"
  },
  {
    "id": "e264e7c1-bbf6-4415-8ebe-b17ebb0c2a6d",
    "date": "2026-08-30",
    "category": "日常",
    "title": "周末的葱",
    "content": "周末买了把葱，做晚饭时发现烂了一半。挑着好的切了，反正过日子也一样，好的能用就行。",
    "image_url": "/images/2026-08-30-19.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:48.908Z"
  }
]
[
  {
    "id": "e9516028-bacd-4c0e-82b3-764a8eec147d",
    "date": "2026-08-14",
    "category": "励志",
    "title": "凌晨六点",
    "content": "闹钟响第三次才爬起来，天还黑着。但早起的空气有种特权感，像偷来的时间。昨夜的疲惫还在，今天的方向清晰。",
    "image_url": "/images/2026-08-14-0.jpg",
    "image_author": "",
    "created_at": "2026-08-14T15:56:10.819Z"
  },
  {
    "id": "e4d7ce9e-876a-4ddb-80b0-ceb1ca59934f",
    "date": "2026-08-14",
    "category": "励志",
    "title": "开始",
    "content": "闹钟响的时候，我也想过再睡十分钟。但爬起来的那一刻，窗外有光，空气里有风，而今天的我，比昨天多迈了一步。",
    "image_url": "/images/2026-08-14-1.jpg",
    "image_author": "",
    "created_at": "2026-08-14T15:56:15.300Z"
  },
  {
    "id": "ad811762-a608-4298-8b9d-b43855a3dcfc",
    "date": "2026-08-14",
    "category": "励志",
    "title": "晨曦",
    "content": "六点的闹钟，七点的地铁，八点的工位。日复一日，但今天学会了新东西，比昨天强一点，就够了。",
    "image_url": "/images/2026-08-14-2.jpg",
    "image_author": "",
    "created_at": "2026-08-14T15:56:18.102Z"
  },
  {
    "id": "154c33b3-0d3d-45f7-8805-b7ce7b7233e4",
    "date": "2026-08-14",
    "category": "励志",
    "title": "日复一日",
    "content": "六点的闹钟响了第五遍，我爬起来。窗外天还没亮，但今天要处理的事，心里已亮堂堂的。",
    "image_url": "/images/2026-08-14-3.jpg",
    "image_author": "",
    "created_at": "2026-08-14T15:56:19.867Z"
  },
  {
    "id": "2aad4dfe-bff8-41a0-bc2d-e78bcd5ad4af",
    "date": "2026-08-14",
    "category": "情感",
    "title": "久违的问候",
    "content": "雨点敲窗的时候，突然翻到老友的号码。犹豫了三秒，发了句“最近好吗”。原来有些情谊，不需要开头，也不怕冷场。",
    "image_url": "/images/2026-08-14-4.jpg",
    "image_author": "",
    "created_at": "2026-08-14T15:56:21.807Z"
  },
  {
    "id": "7d0c395c-8e4c-42cf-b8e5-430244b54335",
    "date": "2026-08-14",
    "category": "情感",
    "title": "雨天的消息",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。其实没什么特别的事，就是想说，今天的雨声很好听，像我们以前一起听过的那个夏天。",
    "image_url": "/images/2026-08-14-5.jpg",
    "image_author": "",
    "created_at": "2026-08-14T15:56:23.436Z"
  },
  {
    "id": "01143647-926c-4cea-8366-e1a728d1cb13",
    "date": "2026-08-14",
    "category": "情感",
    "title": "加个菜",
    "content": "视频里妈妈问我吃得好不好，我举起外卖盒说丰盛着呢。挂断后，还是起身给自己加了个荷包蛋。",
    "image_url": "/images/2026-08-14-6.jpg",
    "image_author": "",
    "created_at": "2026-08-14T15:56:25.274Z"
  },
  {
    "id": "91856594-a0c1-48f7-91a5-9320f5498025",
    "date": "2026-08-14",
    "category": "情感",
    "title": "暖雨",
    "content": "下雨天，翻到相册里和爸妈的合照，顺手打了个视频。他们那边晴着，说家里花开正好，问我这边冷不冷。挂了电话，雨好像也没那么凉了。",
    "image_url": "/images/2026-08-14-7.jpg",
    "image_author": "",
    "created_at": "2026-08-14T15:56:30.225Z"
  },
  {
    "id": "29da535d-8e44-4aca-abc3-695c52853aa0",
    "date": "2026-08-14",
    "category": "早安",
    "title": "早安，太阳",
    "content": "煎蛋在锅里滋滋响，咖啡香飘满屋。咬一口吐司，阳光刚好爬上桌角。新的一天，从好好吃饭开始。",
    "image_url": "/images/2026-08-14-8.jpg",
    "image_author": "",
    "created_at": "2026-08-14T15:56:31.961Z"
  },
  {
    "id": "de198b29-ecbf-47e1-8f9b-fbd1598dc9cc",
    "date": "2026-08-14",
    "category": "早安",
    "title": "早起的礼物",
    "content": "阳光刚好铺满餐桌，咖啡冒着小泡。咬一口焦脆吐司，想起小时候的早晨。出门时风很轻，连红灯都绿得刚刚好。",
    "image_url": "/images/2026-08-14-9.jpg",
    "image_author": "",
    "created_at": "2026-08-14T15:56:34.033Z"
  },
  {
    "id": "4aa5ca6d-05eb-44a7-92fc-fad8fdfc10ff",
    "date": "2026-08-14",
    "category": "早安",
    "title": "晨光正好",
    "content": "窗外的光刚好落在咖啡杯沿，煎蛋边缘微微焦脆。出门前看了一眼镜子里的自己，今天也要好好接住所有平凡的小确幸。",
    "image_url": "/images/2026-08-14-10.jpg",
    "image_author": "",
    "created_at": "2026-08-14T15:56:37.688Z"
  },
  {
    "id": "63c8a834-826c-4d3c-b9c7-a29d005ca5fb",
    "date": "2026-08-14",
    "category": "早安",
    "title": "清晨的节奏",
    "content": "晨光落在吐司上，配着煎蛋刚好。出门时风凉凉的，吹醒了睡意，今天想慢慢走，看路边的花开没开。",
    "image_url": "/images/2026-08-14-11.jpg",
    "image_author": "",
    "created_at": "2026-08-14T15:56:41.320Z"
  },
  {
    "id": "cfe83fcf-ee74-44a9-a198-30096a9c61b7",
    "date": "2026-08-14",
    "category": "晚安",
    "title": "关灯之前",
    "content": "洗完澡躺下来，头发还带着潮气。窗外灯光一盏盏灭了，今天的烦恼也差不多该退场了。关灯之前，把呼吸放慢，就到这里吧。",
    "image_url": "/images/2026-08-14-12.jpg",
    "image_author": "",
    "created_at": "2026-08-14T15:56:43.596Z"
  },
  {
    "id": "1a96dd25-7062-407a-a57d-2712d63f96f5",
    "date": "2026-08-14",
    "category": "晚安",
    "title": "收工时刻",
    "content": "窗外的灯一盏盏灭了，手机屏幕的光也调到了最暗。头发还没全干，今天的事像水汽一样散开。就到这里吧，把自己还给自己。",
    "image_url": "/images/2026-08-14-13.jpg",
    "image_author": "",
    "created_at": "2026-08-14T15:56:47.287Z"
  },
  {
    "id": "6d7328d2-a2d5-4586-b545-518775c6cdf1",
    "date": "2026-08-14",
    "category": "晚安",
    "title": "夜归自己",
    "content": "关灯前看了眼窗外，万家灯火也在慢慢熄灭。热水澡冲走了一天的浮尘，剩下的交给枕头。今天辛苦了，此刻只属于自己。",
    "image_url": "/images/2026-08-14-14.jpg",
    "image_author": "",
    "created_at": "2026-08-14T15:56:48.853Z"
  },
  {
    "id": "2012bed7-3387-4059-9be2-e0bee090ab1c",
    "date": "2026-08-14",
    "category": "晚安",
    "title": "夜色收容所",
    "content": "热水冲走了白天的喧嚣，头发还滴着水，关灯前看了最后一眼窗外。这一刻，世界安静得只属于自己。",
    "image_url": "/images/2026-08-14-15.jpg",
    "image_author": "",
    "created_at": "2026-08-14T15:56:51.819Z"
  },
  {
    "id": "f00886c0-94d2-40e1-b9ce-ec2bc13f1118",
    "date": "2026-08-14",
    "category": "日常",
    "title": "今晚的锅是我的",
    "content": "下班顺路买了把青菜，回家煮了锅粥。喝完瘫在沙发上发呆，突然觉得这样也挺好。",
    "image_url": "/images/2026-08-14-16.jpg",
    "image_author": "",
    "created_at": "2026-08-14T15:56:54.914Z"
  },
  {
    "id": "d0cc0549-8e1f-4eb7-a280-a819afa17d25",
    "date": "2026-08-14",
    "category": "日常",
    "title": "人间烟火",
    "content": "今天自己做了碗面，味道居然还不错。收拾完厨房，又去阳台发了会儿呆，楼下买菜的大爷大妈比我还热闹。",
    "image_url": "/images/2026-08-14-17.jpg",
    "image_author": "",
    "created_at": "2026-08-14T15:56:56.773Z"
  },
  {
    "id": "79c11b14-3bbb-4d3a-ba1f-0ebf1c84a1ad",
    "date": "2026-08-14",
    "category": "日常",
    "title": "阳台放风",
    "content": "下午阳台发了会呆，看楼下大爷遛弯，风挺舒服的。突然觉得，日子平平淡淡也挺好。",
    "image_url": "/images/2026-08-14-18.jpg",
    "image_author": "",
    "created_at": "2026-08-14T15:57:02.258Z"
  },
  {
    "id": "fc0864c9-82fe-489a-b358-570e8f65478c",
    "date": "2026-08-14",
    "category": "日常",
    "title": "晚饭搞定",
    "content": "今天自己做了碗面，味道居然还不错。收拾完厨房又拖了地，窝在沙发上发呆，突然觉得这样平平淡淡的日子也挺好。",
    "image_url": "/images/2026-08-14-19.jpg",
    "image_author": "",
    "created_at": "2026-08-14T15:57:03.837Z"
  },
  {
    "id": "99fb169b-be49-4ec7-8abf-a9520f6e46f6",
    "date": "2026-08-13",
    "category": "励志",
    "title": "匀速前进",
    "content": "闹钟响了两次才睁眼，匆忙买了杯咖啡赶地铁。可意外的是，今天跑得比昨天轻松一点。生活就是这样，不停下来，就走得更远。",
    "image_url": "/images/2026-08-13-0.jpg",
    "image_author": "",
    "created_at": "2026-08-13T16:05:13.054Z"
  },
  {
    "id": "00c249b8-06cf-4a04-bd75-9ecd5038e7ce",
    "date": "2026-08-13",
    "category": "励志",
    "title": "闹钟响了六次",
    "content": "闹钟响了六次才爬起来，电梯里补了个妆。昨晚的报表还差个结尾，但晨光打在键盘上时，突然觉得每个修改都是值得的。",
    "image_url": "/images/2026-08-13-1.jpg",
    "image_author": "",
    "created_at": "2026-08-13T16:05:17.297Z"
  },
  {
    "id": "ebc6925a-6f53-4bf1-9c41-a5fe64e8468c",
    "date": "2026-08-13",
    "category": "励志",
    "title": "闹钟响了三次",
    "content": "昨晚加班到十点，今早闹钟响了三次才爬起来。地铁上人挤人，但我忽然发现，能按时起床奔赴目标，本身就是一种了不起。",
    "image_url": "/images/2026-08-13-2.jpg",
    "image_author": "",
    "created_at": "2026-08-13T16:05:19.532Z"
  },
  {
    "id": "dbe770cf-e376-4582-aa1b-f6c9c9937451",
    "date": "2026-08-13",
    "category": "励志",
    "title": "慢一点也没关系",
    "content": "今晚的月亮挂在写字楼顶，像一枚旧纽扣。改完第七版方案，忽然发现窗台上的绿萝又抽了新芽。原来坚持不需要惊天动地，只要每天给它浇一点水。",
    "image_url": "/images/2026-08-13-3.jpg",
    "image_author": "",
    "created_at": "2026-08-13T16:05:22.219Z"
  },
  {
    "id": "70ba76cb-f2ad-4e00-8132-fd7c5adea867",
    "date": "2026-08-13",
    "category": "情感",
    "title": "吃饭时想起你",
    "content": "今天吃饭，邻桌笑声很像你。突然想发消息问一句，最近好吗。后来只是笑了笑，继续夹菜。",
    "image_url": "/images/2026-08-13-4.jpg",
    "image_author": "",
    "created_at": "2026-08-13T16:05:24.995Z"
  },
  {
    "id": "7c8b1c1b-9a59-4719-833e-b1dbc770c2ac",
    "date": "2026-08-13",
    "category": "情感",
    "title": "饭桌上的牵挂",
    "content": "和朋友吃饭，热汤冒着白气。突然想起家人视频里那句“吃好点”，原来不管走多远，有些话始终温着。",
    "image_url": "/images/2026-08-13-5.jpg",
    "image_author": "",
    "created_at": "2026-08-13T16:05:27.689Z"
  },
  {
    "id": "be3966db-373a-42ae-b8f8-60623426b936",
    "date": "2026-08-13",
    "category": "情感",
    "title": "雨天信号",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说太多，就问问那边天气如何。有些牵挂，不需要理由开场。",
    "image_url": "/images/2026-08-13-6.jpg",
    "image_author": "",
    "created_at": "2026-08-13T16:05:30.091Z"
  },
  {
    "id": "3e65f27e-37a4-49b9-9ada-c0b9da8f28f7",
    "date": "2026-08-13",
    "category": "情感",
    "title": "雨天想到你",
    "content": "下雨天，窗玻璃起了雾。突然想起你上次说，最喜欢这种天气窝在家里。手指在雾气上画了个笑脸，然后拍了张照发给你。",
    "image_url": "/images/2026-08-13-7.jpg",
    "image_author": "",
    "created_at": "2026-08-13T16:05:35.938Z"
  },
  {
    "id": "b28fb869-b74c-4c19-bffd-6304c6c85c15",
    "date": "2026-08-13",
    "category": "早安",
    "title": "早起的馈赠",
    "content": "晨光把吐司烤成金黄，煎蛋边缘微焦。咖啡香钻进鼻腔时，楼下梧桐正沙沙作响——这是生活递来的第一份礼物。",
    "image_url": "/images/2026-08-13-8.jpg",
    "image_author": "",
    "created_at": "2026-08-13T16:05:38.352Z"
  },
  {
    "id": "9d4563c7-57de-4915-83e7-55c7cea70772",
    "date": "2026-08-13",
    "category": "早安",
    "title": "清晨的小确幸",
    "content": "吐司烤得刚好，咖啡冒着热气。阳光从窗帘缝漏进来，照在碗沿上。出门前多看了两眼，日子就这样慢慢开始。",
    "image_url": "/images/2026-08-13-9.jpg",
    "image_author": "",
    "created_at": "2026-08-13T16:05:42.480Z"
  },
  {
    "id": "1cfce030-5d94-4c11-b181-52a385fa6706",
    "date": "2026-08-13",
    "category": "早安",
    "title": "太阳和咖啡都好了",
    "content": "阳光斜进厨房，煎蛋边缘微焦。咬一口吐司，等咖啡慢慢滴。活着真好，连出门的风都是温柔的。",
    "image_url": "/images/2026-08-13-10.jpg",
    "image_author": "",
    "created_at": "2026-08-13T16:05:52.140Z"
  },
  {
    "id": "1f3283ee-d157-4832-b5b2-6b7ede35e70b",
    "date": "2026-08-13",
    "category": "早安",
    "title": "早安，热咖啡",
    "content": "咬了一口酥脆吐司，看阳光在杯口晃荡。今天没什么大事，走慢点也没关系。",
    "image_url": "/images/2026-08-13-11.jpg",
    "image_author": "",
    "created_at": "2026-08-13T16:05:58.274Z"
  },
  {
    "id": "c8d9eecd-cb0b-45e0-b4a4-5a8c16a90ee4",
    "date": "2026-08-13",
    "category": "晚安",
    "title": "灯熄了",
    "content": "热水冲走了今天的疲惫，头发还没干透，窗外灯火渐次熄灭。这一天无论圆满还是遗憾，都该歇脚了。",
    "image_url": "/images/2026-08-13-12.jpg",
    "image_author": "",
    "created_at": "2026-08-13T16:06:05.990Z"
  },
  {
    "id": "d606fd1e-14d3-4ef8-8cab-6bfe7bb35c8d",
    "date": "2026-08-13",
    "category": "晚安",
    "title": "夜已静",
    "content": "关上灯，窗外还剩几盏亮着。洗完澡的头发还没干透，今天的事就晾在风里吧。床已经等我很久了。",
    "image_url": "/images/2026-08-13-13.jpg",
    "image_author": "",
    "created_at": "2026-08-13T16:06:13.558Z"
  },
  {
    "id": "faf5fa84-c7b8-426d-b610-71b3c9f8ffc9",
    "date": "2026-08-13",
    "category": "晚安",
    "title": "夜里那盏灯",
    "content": "关灯前看了眼窗外，整个城市都安静下来了。洗完澡躺进被子，连头发丝都是放松的。今天，就到这里吧。",
    "image_url": "/images/2026-08-13-14.jpg",
    "image_author": "",
    "created_at": "2026-08-13T16:06:15.829Z"
  },
  {
    "id": "12e2a4bc-6e51-4df9-8542-5d12c8782e23",
    "date": "2026-08-13",
    "category": "晚安",
    "title": "夜将心事收好",
    "content": "热水冲走了白天的尘埃，换上睡衣躺下，窗帘留一道缝。窗外车流声渐稀，把今天叠好放在枕边，就这样睡吧。",
    "image_url": "/images/2026-08-13-15.jpg",
    "image_author": "",
    "created_at": "2026-08-13T16:06:18.663Z"
  },
  {
    "id": "57c61bdb-cc4a-4969-b484-9911f293954c",
    "date": "2026-08-13",
    "category": "日常",
    "title": "今天的厨房很争气",
    "content": "自己炒了个西红柿鸡蛋，居然没糊锅，配着米饭全吃完了。收拾完厨房瘫在沙发上发呆，觉得这日子还挺像样。",
    "image_url": "/images/2026-08-13-16.jpg",
    "image_author": "",
    "created_at": "2026-08-13T16:06:21.077Z"
  },
  {
    "id": "120ff4ff-79eb-43c7-a3c2-fc26d4e49f1a",
    "date": "2026-08-13",
    "category": "日常",
    "title": "今日份",
    "content": "买了把香菜，回家摘了半小时叶子。晚饭煮了锅粥，阳台吹了会儿风。挺好。",
    "image_url": "/images/2026-08-13-17.jpg",
    "image_author": "",
    "created_at": "2026-08-13T16:06:23.304Z"
  },
  {
    "id": "a1a19cd2-c88e-4211-a186-3b52fdef8f10",
    "date": "2026-08-13",
    "category": "日常",
    "title": "做饭的快乐",
    "content": "今天自己做了碗面，味道居然还不错。收拾完屋子躺沙发上发呆，突然觉得这样的日子也挺好。",
    "image_url": "/images/2026-08-13-18.jpg",
    "image_author": "",
    "created_at": "2026-08-13T16:06:27.271Z"
  },
  {
    "id": "0aefa1aa-1561-485f-b76c-fe1ddafea6cf",
    "date": "2026-08-13",
    "category": "日常",
    "title": "周末烟火气",
    "content": "买了把青菜，顺手把冰箱里剩的肉和蛋炒了。锅气升起来那一刻，突然觉得，一个人也要好好吃饭，这日子就算没白过。",
    "image_url": "/images/2026-08-13-19.jpg",
    "image_author": "",
    "created_at": "2026-08-13T16:06:29.733Z"
  },
  {
    "id": "1703ea03-81f3-4567-b72f-4ddbafe64726",
    "date": "2026-08-12",
    "category": "励志",
    "title": "闷头走",
    "content": "闹钟响了三次才爬起来，但终究是起来了。地铁里人贴着人，可每个人都在往想去的地方赶。日子平淡，好在我还在动。",
    "image_url": "/images/2026-08-12-0.jpg",
    "image_author": "",
    "created_at": "2026-08-12T16:06:26.430Z"
  },
  {
    "id": "00350865-a3dd-43c0-91ae-1d0278426a24",
    "date": "2026-08-12",
    "category": "励志",
    "title": "方向比速度重要",
    "content": "早起的地铁虽然挤，但至少方向是对的。昨晚的代码没跑通，今早的晨跑却很顺。日子就这样，一边卡壳一边往前。",
    "image_url": "/images/2026-08-12-1.jpg",
    "image_author": "",
    "created_at": "2026-08-12T16:06:29.089Z"
  },
  {
    "id": "75be04a2-147e-4f07-a0f7-cb885b7c3419",
    "date": "2026-08-12",
    "category": "励志",
    "title": "方向",
    "content": "闹钟响的时候，窗外还是黑的。但我知道，每一段难走的路，都在把我带向想去的那个清晨。",
    "image_url": "/images/2026-08-12-2.jpg",
    "image_author": "",
    "created_at": "2026-08-12T16:06:34.754Z"
  },
  {
    "id": "15802174-206c-473c-9434-52e11609faf1",
    "date": "2026-08-12",
    "category": "励志",
    "title": "未完成的答案",
    "content": "晚归路上买的热豆浆，烫得拿不住。等它凉的过程，正好走完最后一段路。有些事急不来，但总会到。今天比昨天又多坚持了一点点。",
    "image_url": "/images/2026-08-12-3.jpg",
    "image_author": "",
    "created_at": "2026-08-12T16:06:37.567Z"
  },
  {
    "id": "668f7239-a5ab-47c5-8292-c01167948b72",
    "date": "2026-08-12",
    "category": "情感",
    "title": "电话那头的雨声",
    "content": "视频接通时，妈妈那边也在下雨。她举着手机给我看窗台的花，说开了三朵。挂断后，雨还在下，心里却晴了。",
    "image_url": "/images/2026-08-12-4.jpg",
    "image_author": "",
    "created_at": "2026-08-12T16:06:43.592Z"
  },
  {
    "id": "95a425b2-67d6-4902-903b-8e26e1665849",
    "date": "2026-08-12",
    "category": "情感",
    "title": "雨天的想念",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没有开场白，就问问你那边天气怎么样。有些关系，不需要刻意维系，但永远都在心里。",
    "image_url": "/images/2026-08-12-5.jpg",
    "image_author": "",
    "created_at": "2026-08-12T16:06:51.000Z"
  },
  {
    "id": "5376d871-b0e8-4a15-84a6-e9faa71ef80d",
    "date": "2026-08-12",
    "category": "情感",
    "title": "消息的雨",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。窗外的雨声盖住了所有犹豫，原来想念不需要理由，就像雨会落，风会起。",
    "image_url": "/images/2026-08-12-6.jpg",
    "image_author": "",
    "created_at": "2026-08-12T16:06:55.323Z"
  },
  {
    "id": "27c5c97d-1cfb-42d6-9431-dceb5aef4370",
    "date": "2026-08-12",
    "category": "情感",
    "title": "雨天的牵挂",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。窗外的雨声，像极了那年我们挤在屋檐下的笑声。",
    "image_url": "/images/2026-08-12-7.jpg",
    "image_author": "",
    "created_at": "2026-08-12T16:07:00.708Z"
  },
  {
    "id": "c47abcaa-7e6f-4b01-ab6c-81d053a28fd2",
    "date": "2026-08-12",
    "category": "早安",
    "title": "晨光记事",
    "content": "咖啡刚冲好，香气把窗帘掀开一角。楼下早餐铺冒着白烟，风里带着烤面包的味道。今天出门早，刚好赶上第一班车。",
    "image_url": "/images/2026-08-12-8.jpg",
    "image_author": "",
    "created_at": "2026-08-12T16:07:02.958Z"
  },
  {
    "id": "ae672704-ce07-413a-9731-efcfa35eb697",
    "date": "2026-08-12",
    "category": "早安",
    "title": "早安，第一口",
    "content": "吐司边烤得刚好，咖啡冒热气。推开门，风是凉的，光正好落在肩头。今天也要好好过。",
    "image_url": "/images/2026-08-12-9.jpg",
    "image_author": "",
    "created_at": "2026-08-12T16:07:05.136Z"
  },
  {
    "id": "2d72c835-fbe2-477b-81fb-d5accf1db074",
    "date": "2026-08-12",
    "category": "早安",
    "title": "早上的光",
    "content": "面包在烤箱里跳着舞，咖啡香跑进卧室喊我起床。推开门，晨光正好落在肩上，今天的街道，连风都是甜的。",
    "image_url": "/images/2026-08-12-10.jpg",
    "image_author": "",
    "created_at": "2026-08-12T16:07:10.841Z"
  },
  {
    "id": "f15b7a71-6e3a-4880-9ee7-cbb408ec9be2",
    "date": "2026-08-12",
    "category": "早安",
    "title": "晨光里的早餐",
    "content": "吐司边烤得刚好，咖啡香飘进窗帘缝。推开门的瞬间，风把困意吹散。今天也要好好走路，好好吃饭。",
    "image_url": "/images/2026-08-12-11.jpg",
    "image_author": "",
    "created_at": "2026-08-12T16:07:16.161Z"
  },
  {
    "id": "5c914828-128b-444f-8ca4-74a5c211453b",
    "date": "2026-08-12",
    "category": "晚安",
    "title": "夜已沉",
    "content": "洗完澡躺下，灯一关，窗外的城市就静了下来。今天有过的情绪，都留在这个夜里慢慢沉淀，人就轻了。",
    "image_url": "/images/2026-08-12-12.jpg",
    "image_author": "",
    "created_at": "2026-08-12T16:07:18.461Z"
  },
  {
    "id": "a52332c5-d71b-492f-842d-01531314eb68",
    "date": "2026-08-12",
    "category": "晚安",
    "title": "夜的收尾",
    "content": "头发还湿着，窗外路灯把树影投在天花板上。今天的事已经想完了，剩下的都交给明天吧。关灯，闭眼。",
    "image_url": "/images/2026-08-12-13.jpg",
    "image_author": "",
    "created_at": "2026-08-12T16:07:28.977Z"
  },
  {
    "id": "a4939531-5247-48a3-9e41-7b1f1ec7e4c6",
    "date": "2026-08-12",
    "category": "晚安",
    "title": "关灯前的三分钟",
    "content": "热水冲走了今天的黏腻，窗帘缝漏进一线夜色。躺平，听空调低鸣，世界终于安静到只剩自己。今天就到此为止，其余交给梦。",
    "image_url": "/images/2026-08-12-14.jpg",
    "image_author": "",
    "created_at": "2026-08-12T16:07:31.947Z"
  },
  {
    "id": "a012555b-4516-4391-808a-f7f8e14a1a5e",
    "date": "2026-08-12",
    "category": "晚安",
    "title": "今晚的句号",
    "content": "洗完澡，头发还是潮的，窗外路灯正昏黄。今天的事都留在今天了。把手机调成静音，房间只留一盏小灯，这一刻，世界安静下来了。",
    "image_url": "/images/2026-08-12-15.jpg",
    "image_author": "",
    "created_at": "2026-08-12T16:07:35.989Z"
  },
  {
    "id": "aa2f47c9-b959-41cd-b563-6f49b54935fe",
    "date": "2026-08-12",
    "category": "日常",
    "title": "收拾完的快乐",
    "content": "把家里里里外外拖了一遍，垃圾倒了，沙发摆正。坐下来那刻，感觉整个人都轻了，这比什么解压方式都管用。",
    "image_url": "/images/2026-08-12-16.jpg",
    "image_author": "",
    "created_at": "2026-08-12T16:07:39.176Z"
  },
  {
    "id": "b42ec030-5875-4f07-a643-f5dc5efd5443",
    "date": "2026-08-12",
    "category": "日常",
    "title": "今天有点小满足",
    "content": "下午把厨房擦了一遍，顺手煮了锅粥。站在阳台发呆那会儿，突然觉得这种没啥大事的日子，也挺好的。",
    "image_url": "/images/2026-08-12-17.jpg",
    "image_author": "",
    "created_at": "2026-08-12T16:07:42.213Z"
  },
  {
    "id": "68d79296-a9dc-4351-b771-648e0dc7512c",
    "date": "2026-08-12",
    "category": "日常",
    "title": "周末的满足感",
    "content": "下午收拾了房间，擦完地板出了一身汗。然后去菜市场买了把青菜，回来煮了碗热汤面。日子就这么简单，也挺好。",
    "image_url": "/images/2026-08-12-18.jpg",
    "image_author": "",
    "created_at": "2026-08-12T16:07:48.568Z"
  },
  {
    "id": "035ab89d-6900-407a-bf61-c9aa12c5b4b3",
    "date": "2026-08-12",
    "category": "日常",
    "title": "厨房初体验",
    "content": "今天自己做了碗面，味道居然还不错。收拾完厨房看着锅碗归位，突然觉得日子就该这么过，简单踏实。",
    "image_url": "/images/2026-08-12-19.jpg",
    "image_author": "",
    "created_at": "2026-08-12T16:07:52.945Z"
  },
  {
    "id": "6651d8c9-e049-488b-ab08-45b7389d5ae9",
    "date": "2026-08-11",
    "category": "励志",
    "title": "进度条",
    "content": "凌晨的键盘声和早班车一样准时，我把今天拆成几十个小格子，填满一个，就离目标近一格。",
    "image_url": "/images/2026-08-11-0.jpg",
    "image_author": "",
    "created_at": "2026-08-11T16:04:44.177Z"
  },
  {
    "id": "015906db-a94c-4979-ab93-a35ead2c45dd",
    "date": "2026-08-11",
    "category": "励志",
    "title": "光的方向",
    "content": "六点的街道很安静，路灯还亮着。风有点凉，但跑起来就暖了。每一步都算数，哪怕慢一点。",
    "image_url": "/images/2026-08-11-1.jpg",
    "image_author": "",
    "created_at": "2026-08-11T16:04:50.334Z"
  },
  {
    "id": "c8e1c6f8-1a04-4422-8cc0-90da34dac91f",
    "date": "2026-08-11",
    "category": "励志",
    "title": "沿途",
    "content": "六点半的闹钟响了三次，我还是起来了。地铁里人贴着人，但每个人都朝着自己的方向。昨天没做完的事，今天接着做。",
    "image_url": "/images/2026-08-11-2.jpg",
    "image_author": "",
    "created_at": "2026-08-11T16:04:54.309Z"
  },
  {
    "id": "fe148b41-034b-4196-b2b0-717a08dd7675",
    "date": "2026-08-11",
    "category": "励志",
    "title": "六点的闹钟",
    "content": "六点的闹钟响了三次，我还是爬起来跑了五公里。地铁上困得站着打盹，但看着窗外天亮起来，又觉得今天值得拼一拼。",
    "image_url": "/images/2026-08-11-3.jpg",
    "image_author": "",
    "created_at": "2026-08-11T16:04:57.662Z"
  },
  {
    "id": "91dab4fc-c1ef-4a5f-be46-25e3391fb6d5",
    "date": "2026-08-11",
    "category": "情感",
    "title": "旧友",
    "content": "雨天翻到去年一起吃饭的照片，顺手发了条消息过去。没想到对方秒回：正想找你呢。有些关系，隔多久都接得上。",
    "image_url": "/images/2026-08-11-4.jpg",
    "image_author": "",
    "created_at": "2026-08-11T16:05:05.147Z"
  },
  {
    "id": "46ede78a-0521-4bdc-94a8-9f14fc675c3b",
    "date": "2026-08-11",
    "category": "情感",
    "title": "今晚的月亮",
    "content": "加班回家路上，随手拍了张月亮发家庭群。妈妈秒回：'今天你爸念叨你三次。'原来想念不需要说出口，它藏在每一次抬头看月亮的瞬间。",
    "image_url": "/images/2026-08-11-5.jpg",
    "image_author": "",
    "created_at": "2026-08-11T16:05:12.422Z"
  },
  {
    "id": "e1d506ec-8d7a-47fc-ab26-66c2a698334e",
    "date": "2026-08-11",
    "category": "情感",
    "title": "一句晚安",
    "content": "视频挂断前，妈妈照例说了句早点睡。我盯着屏幕暗下去，突然意识到，她每天等这个电话，就像我小时候等她下班。爱从来不说出口，只是准时响起。",
    "image_url": "/images/2026-08-11-6.jpg",
    "image_author": "",
    "created_at": "2026-08-11T16:05:16.907Z"
  },
  {
    "id": "e9a45dd4-0df7-409d-8071-28c69f4c7fe9",
    "date": "2026-08-11",
    "category": "情感",
    "title": "屏幕里的家",
    "content": "视频接通那刻，爸爸正把菜端上桌。妈妈在喊我多吃点，弟弟在旁边做鬼脸。3英寸的屏幕，装下了整个家的温度。",
    "image_url": "/images/2026-08-11-7.jpg",
    "image_author": "",
    "created_at": "2026-08-11T16:05:22.681Z"
  },
  {
    "id": "e4efb149-8c20-4752-86fe-89b6530aebec",
    "date": "2026-08-11",
    "category": "早安",
    "title": "晨光正好·lhk",
    "content": "烤吐司边角脆脆的，咖啡香飘进阳光里。推开门，微风刚好，连影子都轻快起来。",
    "image_url": "/images/2026-08-11-8.jpg",
    "image_author": "",
    "created_at": "2026-08-11T16:05:37.757Z"
  },
  {
    "id": "6d5450dc-3c73-4262-b0e6-6bd3c528afc7",
    "date": "2026-08-11",
    "category": "早安",
    "title": "早安，晨光正好",
    "content": "窗外的鸟叫把我叫醒，煮了杯热咖啡，配两片烤面包。出门时风有点凉，但阳光正好。新的一天，慢慢来，不着急。",
    "image_url": "/images/2026-08-11-9.jpg",
    "image_author": "",
    "created_at": "2026-08-11T16:05:42.251Z"
  },
  {
    "id": "996b2810-0ea5-4013-a18e-d94e21765cc4",
    "date": "2026-08-11",
    "category": "早安",
    "title": "晨光与吐司",
    "content": "窗外鸟鸣比闹钟先醒，煎蛋在锅里滋滋作响。咬一口脆边吐司，咖啡香气正好飘过来。该出门了，世界在等我。}",
    "image_url": "/images/2026-08-11-10.jpg",
    "image_author": "",
    "created_at": "2026-08-11T16:05:49.179Z"
  },
  {
    "id": "ab6743ce-a5e8-45de-8c92-33f7069af6f4",
    "date": "2026-08-11",
    "category": "早安",
    "title": "第一口咖啡",
    "content": "闹钟响前自然醒，窗边晨光刚好。烤面包片脆脆的，咖啡冒着热气，先喝一口，再想今天的事。",
    "image_url": "/images/2026-08-11-11.jpg",
    "image_author": "",
    "created_at": "2026-08-11T16:05:59.222Z"
  },
  {
    "id": "f901e719-a3f9-412e-b001-971a2cf17a17",
    "date": "2026-08-11",
    "category": "晚安",
    "title": "今日终章",
    "content": "洗完澡躺在床上，窗外灯光稀稀落落。把今天叠好放在枕边，身体陷进被子里，什么都不想了。就这样，让夜晚接管剩下的时间。",
    "image_url": "/images/2026-08-11-12.jpg",
    "image_author": "",
    "created_at": "2026-08-11T16:06:02.650Z"
  },
  {
    "id": "b615ee24-1296-4095-a6bf-fc588ec525d3",
    "date": "2026-08-11",
    "category": "晚安",
    "title": "夜色收留",
    "content": "洗完澡躺下，窗外路灯把树影送到天花板上。今天所有的声音都退远了，只剩自己均匀的呼吸。愿这一觉，把白天翻篇。窗帘拉上，世界静音。",
    "image_url": "/images/2026-08-11-13.jpg",
    "image_author": "",
    "created_at": "2026-08-11T16:06:05.069Z"
  },
  {
    "id": "e1931ac5-8c3d-4171-96f9-de53edb34120",
    "date": "2026-08-11",
    "category": "晚安",
    "title": "合上今天",
    "content": "洗完澡躺下，窗帘缝里漏进一点月光。手机屏幕调暗了，窗外城市还在闪着细碎的光。今天的事都放在今晚，床单裹住我，像把一页纸轻轻合上。",
    "image_url": "/images/2026-08-11-14.jpg",
    "image_author": "",
    "created_at": "2026-08-11T16:06:07.748Z"
  },
  {
    "id": "47829f3e-ebe5-4d22-9543-0705d3103164",
    "date": "2026-08-11",
    "category": "晚安",
    "title": "灯一关，夜就完整了",
    "content": "洗完澡躺下，窗外路灯还亮着。把今天翻到最后一页，心里那盏小灯也熄了。就这样吧，夜还很长，梦不急着来。",
    "image_url": "/images/2026-08-11-15.jpg",
    "image_author": "",
    "created_at": "2026-08-11T16:06:10.541Z"
  },
  {
    "id": "fe31754b-e334-4fad-8d17-29348d933682",
    "date": "2026-08-11",
    "category": "日常",
    "title": "周末的厨房",
    "content": "周六早上逛菜市场，买了一把小葱几个番茄。回家煮了锅番茄鸡蛋面，站在灶台前吃完，汤都喝干净了。这日子，踏实。",
    "image_url": "/images/2026-08-11-16.jpg",
    "image_author": "",
    "created_at": "2026-08-11T16:06:13.268Z"
  },
  {
    "id": "a6a88ed1-66a8-4377-8199-5a2a00711eca",
    "date": "2026-08-11",
    "category": "日常",
    "title": "今天的小日子",
    "content": "中午做了西红柿炒蛋，卖相一般但味道还行。下午收拾了下房间，扔了一堆不要的东西，感觉清爽多了。",
    "image_url": "/images/2026-08-11-17.jpg",
    "image_author": "",
    "created_at": "2026-08-11T16:06:17.768Z"
  },
  {
    "id": "e4d945f3-ba35-4025-bb33-aa58b76b4461",
    "date": "2026-08-11",
    "category": "日常",
    "title": "今天的面",
    "content": "下班路过菜场顺手买了把青菜，回家下了碗面。煎蛋的时候火大了点，边儿有点焦，但味道居然还行。吃饱了瘫在沙发上，觉得这一天也没那么糟。",
    "image_url": "/images/2026-08-11-18.jpg",
    "image_author": "",
    "created_at": "2026-08-11T16:06:20.458Z"
  },
  {
    "id": "86f9897c-a4fb-489c-a16e-4fa078fcf52f",
    "date": "2026-08-11",
    "category": "日常",
    "title": "今天也是过日子的一天",
    "content": "冰箱剩菜随便炒了炒，居然挺好吃。阳台发了会呆，发现楼下桂花开了。日子没什么大事，但细碎里都是甜。",
    "image_url": "/images/2026-08-11-19.jpg",
    "image_author": "",
    "created_at": "2026-08-11T16:06:23.354Z"
  },
  {
    "id": "70308d36-1fbb-45a7-aef5-630c3322ed2e",
    "date": "2026-08-10",
    "category": "励志",
    "title": "把今天过扎实",
    "content": "六点起床，十分钟洗漱，五分钟出门。日子没什么新鲜事，但每一步都踩实了。晚上躺下，身体累，心里不空。",
    "image_url": "/images/2026-08-10-0.jpg",
    "image_author": "",
    "created_at": "2026-08-10T16:05:22.663Z"
  },
  {
    "id": "1cc68147-1ecf-4349-838f-c7ab20d9d6c8",
    "date": "2026-08-10",
    "category": "励志",
    "title": "晨光",
    "content": "闹钟响时天还没亮，煮咖啡的间隙看了会儿窗外。云层透出金边，像极了我那点不切实际的坚持。",
    "image_url": "/images/2026-08-10-1.jpg",
    "image_author": "",
    "created_at": "2026-08-10T16:05:25.859Z"
  },
  {
    "id": "cf677345-ab6f-4c8f-b0a7-c20a7301b521",
    "date": "2026-08-10",
    "category": "励志",
    "title": "把闹钟调早十分钟",
    "content": "闹钟响了没赖床，多看了两页书。楼下风好大，裹紧外套往前走，路边的灯全亮了。",
    "image_url": "/images/2026-08-10-2.jpg",
    "image_author": "",
    "created_at": "2026-08-10T16:05:29.521Z"
  },
  {
    "id": "06600f5d-b2e3-46ae-8a27-3e7d4577eab6",
    "date": "2026-08-10",
    "category": "励志",
    "title": "六点的风",
    "content": "六点起床时天还黑着，楼下早餐摊已经亮灯了。热气腾腾的豆浆下肚，突然觉得，把今天过扎实就是最好的计划。",
    "image_url": "/images/2026-08-10-3.jpg",
    "image_author": "",
    "created_at": "2026-08-10T16:05:35.311Z"
  },
  {
    "id": "1bde1fcb-e8f3-4f1c-a61f-60f69eabd729",
    "date": "2026-08-10",
    "category": "情感",
    "title": "雨天信号·ve5",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。不是有事，只是觉得，有些人就算不说话，知道在就好了。",
    "image_url": "/images/2026-08-10-4.jpg",
    "image_author": "",
    "created_at": "2026-08-10T16:05:48.390Z"
  },
  {
    "id": "f84ddc18-1006-4fd6-ba3f-932c0d6fbd1a",
    "date": "2026-08-10",
    "category": "情感",
    "title": "雨天通话",
    "content": "下雨天，窝在沙发里跟妈妈视频。她那边也在下雨，隔着屏幕听她念叨。挂了电话，突然觉得这雨声也温柔了许多。",
    "image_url": "/images/2026-08-10-5.jpg",
    "image_author": "",
    "created_at": "2026-08-10T16:05:55.561Z"
  },
  {
    "id": "4eae4cb0-0dee-4173-b1b2-7436bbbd65f8",
    "date": "2026-08-10",
    "category": "情感",
    "title": "雨天里的牵挂",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。窗外的雨声刚好，不紧不慢的，像极了从前我们一起等公交的那些傍晚。",
    "image_url": "/images/2026-08-10-6.jpg",
    "image_author": "",
    "created_at": "2026-08-10T16:06:01.822Z"
  },
  {
    "id": "ba4cd278-81b5-4193-bc88-a5fdb30eaa08",
    "date": "2026-08-10",
    "category": "情感",
    "title": "一碗面的时间",
    "content": "煮面时多放了一个蛋，才想起你不在。视频接通，你那边也是晚饭。隔着屏幕碰了个杯，好像就没那么远了。",
    "image_url": "/images/2026-08-10-7.jpg",
    "image_author": "",
    "created_at": "2026-08-10T16:06:09.200Z"
  },
  {
    "id": "ed4dfab8-cca1-437d-ab7e-d58367c82380",
    "date": "2026-08-10",
    "category": "早安",
    "title": "早安，晨光",
    "content": "吐司边烤得刚好，咖啡香飘进窗缝。推开门那刻，风把困意吹散，今天应该不赖。",
    "image_url": "/images/2026-08-10-8.jpg",
    "image_author": "",
    "created_at": "2026-08-10T16:06:13.268Z"
  },
  {
    "id": "65e5f515-39cb-4e69-8039-9538bf6c9593",
    "date": "2026-08-10",
    "category": "早安",
    "title": "晨间小事",
    "content": "煎蛋在锅里滋啦响，咖啡香飘进窗缝。咬一口脆吐司，阳光正好落在桌角。出门前对着镜子笑了一下，今天也会不错吧。",
    "image_url": "/images/2026-08-10-9.jpg",
    "image_author": "",
    "created_at": "2026-08-10T16:06:23.351Z"
  },
  {
    "id": "c35992ce-3e99-42d0-8330-9ef73d9761c0",
    "date": "2026-08-10",
    "category": "早安",
    "title": "清晨的序曲",
    "content": "闹钟响前就醒了，煎蛋在锅里滋滋响。阳光斜照进窗台，咖啡刚好不烫嘴。出门时风很轻，树叶在头顶沙沙作响。",
    "image_url": "/images/2026-08-10-10.jpg",
    "image_author": "",
    "created_at": "2026-08-10T16:06:29.705Z"
  },
  {
    "id": "9bbd4d92-37e2-4fb8-af30-476a838f9cdf",
    "date": "2026-08-10",
    "category": "早安",
    "title": "早安，慢半拍",
    "content": "烤面包机叮的一声，黄油在吐司上化开。今天不赶时间，咖啡慢慢喝，路边的桂花刚好开了。",
    "image_url": "/images/2026-08-10-11.jpg",
    "image_author": "",
    "created_at": "2026-08-10T16:06:37.794Z"
  },
  {
    "id": "cb6472c7-f50e-4c89-9a31-60e1ffac8b10",
    "date": "2026-08-10",
    "category": "晚安",
    "title": "今日打烊",
    "content": "热水冲走了今天的疲惫，窗外灯光开始变模糊。被子裹住身体，把还没想明白的事留给夜色。就到这里吧，明天的事明天再说。",
    "image_url": "/images/2026-08-10-12.jpg",
    "image_author": "",
    "created_at": "2026-08-10T16:06:40.050Z"
  },
  {
    "id": "a857fb1f-d5d8-4e39-857c-a2bec101e16f",
    "date": "2026-08-10",
    "category": "晚安",
    "title": "收尾",
    "content": "灯关上，窗外的光还醒着。今天像泡完的茶，淡了，也顺了。枕头上落了几根头发，连同那些没说完的话，一起留给今夜。",
    "image_url": "/images/2026-08-10-13.jpg",
    "image_author": "",
    "created_at": "2026-08-10T16:06:42.446Z"
  },
  {
    "id": "40e8d691-8819-43b2-96ae-3aa2556a106b",
    "date": "2026-08-10",
    "category": "晚安",
    "title": "夜归",
    "content": "热水冲走了一天的黏腻，窗外灯火渐稀。关灯前看了会儿夜景，今天所有的情绪都落定了。就到这里吧。",
    "image_url": "/images/2026-08-10-14.jpg",
    "image_author": "",
    "created_at": "2026-08-10T16:06:44.511Z"
  },
  {
    "id": "8e048b37-2175-4257-8267-75fb50e4adbf",
    "date": "2026-08-10",
    "category": "晚安",
    "title": "归零",
    "content": "把今天的疲惫留在淋浴间，窗帘拉上，手机调暗。窗外万家灯火渐次熄灭，我也该给自己道一声轻声的谢幕了。",
    "image_url": "/images/2026-08-10-15.jpg",
    "image_author": "",
    "created_at": "2026-08-10T16:06:47.553Z"
  },
  {
    "id": "e2163744-e7c1-4c68-9ddd-9162904e6cf8",
    "date": "2026-08-10",
    "category": "日常",
    "title": "周末的烟火气",
    "content": "周末在家收拾屋子，顺手把阳台的绿植浇了。中午煮了碗番茄鸡蛋面，味道意外地不错。这种不用赶时间的日子，真好。",
    "image_url": "/images/2026-08-10-16.jpg",
    "image_author": "",
    "created_at": "2026-08-10T16:06:49.471Z"
  },
  {
    "id": "4f2a90c5-c8c0-4cad-9f74-cdc22e7fdc8a",
    "date": "2026-08-10",
    "category": "日常",
    "title": "周末的厨房实验",
    "content": "周六早上买菜，顺手买了把香菜。中午煮了碗馄饨，撒上香菜，居然吃出了店里的味道。洗碗的时候还在想，这大概就是生活的小确幸吧。",
    "image_url": "/images/2026-08-10-17.jpg",
    "image_author": "",
    "created_at": "2026-08-10T16:06:51.959Z"
  },
  {
    "id": "88eb5fcf-e1b2-4b93-a260-0c4d527958fc",
    "date": "2026-08-10",
    "category": "日常",
    "title": "周六的秩序感",
    "content": "收拾完屋子，把该扔的扔了，该擦的擦了。站在客厅中间看了一圈，感觉心里也顺了。晚上煮了锅粥，配点咸菜，吃得很踏实。",
    "image_url": "/images/2026-08-10-18.jpg",
    "image_author": "",
    "created_at": "2026-08-10T16:06:54.213Z"
  },
  {
    "id": "1c58b21d-3466-4f0d-9488-fa8c05ea5688",
    "date": "2026-08-10",
    "category": "日常",
    "title": "今日份满足",
    "content": "买了把新鲜小油菜，回家给自己炒了个饭，锅气足到邻居都来敲门问用的什么油。吃完瘫在沙发上发呆，这日子也就这样，但还挺好。",
    "image_url": "/images/2026-08-10-19.jpg",
    "image_author": "",
    "created_at": "2026-08-10T16:06:56.698Z"
  },
  {
    "id": "6e57f326-efc6-499d-931b-2f192ab6fedf",
    "date": "2026-08-09",
    "category": "励志",
    "title": "早班地铁",
    "content": "六点的闹钟响了三次才爬起来，但今天的晨光比昨天亮了一点。路还长，慢慢走，总会走到。风从耳边过，脚步没停。",
    "image_url": "/images/2026-08-09-0.jpg",
    "image_author": "",
    "created_at": "2026-08-09T15:36:25.044Z"
  },
  {
    "id": "f32d3c68-8798-41ad-b95f-9b526a9ebec7",
    "date": "2026-08-09",
    "category": "励志",
    "title": "路",
    "content": "六点的闹钟响了三次，赶在地铁门关上前挤进去。汗水浸透衬衫时，镜子里的眼神却越来越亮。路是走出来的，不是等出来的。",
    "image_url": "/images/2026-08-09-1.jpg",
    "image_author": "",
    "created_at": "2026-08-09T15:36:27.157Z"
  },
  {
    "id": "de87856a-ca82-4e35-98b9-c4c1be9d13f4",
    "date": "2026-08-09",
    "category": "励志",
    "title": "轨道",
    "content": "六点的闹钟响了三次才爬起来，窗外天刚蒙蒙亮。地铁里人挤人，但每个人都在自己的轨道上向前。昨天没做完的事，今天继续。",
    "image_url": "/images/2026-08-09-2.jpg",
    "image_author": "",
    "created_at": "2026-08-09T15:36:28.820Z"
  },
  {
    "id": "9ae97ba3-211d-455f-8cb0-76c0073e7b44",
    "date": "2026-08-09",
    "category": "励志",
    "title": "凌晨的城市",
    "content": "凌晨一点关掉电脑，看着窗外零星灯火。突然明白，不是每条路都有人同行，但每盏灯都曾独自亮起。",
    "image_url": "/images/2026-08-09-3.jpg",
    "image_author": "",
    "created_at": "2026-08-09T15:36:33.413Z"
  },
  {
    "id": "e64ca295-002d-4e1a-b8c8-3646321ffb96",
    "date": "2026-08-09",
    "category": "情感",
    "title": "饭桌上的想念",
    "content": "米饭冒热气的时候，突然想起你。好久没一起吃饭了，筷子夹起一块红烧肉，像夹起一段旧时光。",
    "image_url": "/images/2026-08-09-4.jpg",
    "image_author": "",
    "created_at": "2026-08-09T15:36:35.225Z"
  },
  {
    "id": "21841eba-42f1-435d-b985-dc96ca1dd845",
    "date": "2026-08-09",
    "category": "情感",
    "title": "雨的落点",
    "content": "下雨天，翻到去年存的那张合影。我们都在笑，像什么都没发生过。给朋友发了条消息：最近还好吗？雨声很大，但屏幕亮了。",
    "image_url": "/images/2026-08-09-5.jpg",
    "image_author": "",
    "created_at": "2026-08-09T15:36:42.821Z"
  },
  {
    "id": "6e457888-d43c-4bbb-929c-35089c81d34b",
    "date": "2026-08-09",
    "category": "情感",
    "title": "雨天的联系",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说想你了，就问问那边天气怎么样。",
    "image_url": "/images/2026-08-09-6.jpg",
    "image_author": "",
    "created_at": "2026-08-09T15:37:00.409Z"
  },
  {
    "id": "7620812a-1dfa-4f9a-9145-001053ed5a77",
    "date": "2026-08-09",
    "category": "情感",
    "title": "雨天的问候",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没聊什么大事，就问问最近好不好，像从前那样闲扯几句，挺好。",
    "image_url": "/images/2026-08-09-7.jpg",
    "image_author": "",
    "created_at": "2026-08-09T15:37:03.477Z"
  },
  {
    "id": "7247438e-1631-4273-a576-6d23599def5c",
    "date": "2026-08-09",
    "category": "早安",
    "title": "早安，慢慢来",
    "content": "闹钟响之前就醒了，窗外的光刚好落在吐司上。煎蛋边缘微焦，咖啡冒热气。出门前摸到口袋里昨天没吃完的糖，突然觉得今天应该不难。",
    "image_url": "/images/2026-08-09-8.jpg",
    "image_author": "",
    "created_at": "2026-08-09T15:37:06.759Z"
  },
  {
    "id": "2bbd307c-2580-489c-9fa2-30f22cf1f97a",
    "date": "2026-08-09",
    "category": "早安",
    "title": "早安，起床气退散",
    "content": "窗外的光刚好落在吐司上，煎蛋边缘微焦。热咖啡冒白气，晨风把困意吹走。走吧，今天也有值得期待的小事。",
    "image_url": "/images/2026-08-09-9.jpg",
    "image_author": "",
    "created_at": "2026-08-09T15:37:08.813Z"
  },
  {
    "id": "af10626c-7da7-4143-8c77-ef80f5830053",
    "date": "2026-08-09",
    "category": "早安",
    "title": "窗外的光",
    "content": "面包机叮了一声，阳光刚好爬上桌角。咬一口脆边，听见楼下自行车铃响。活着真好，连煎蛋边缘的焦都是香的。",
    "image_url": "/images/2026-08-09-10.jpg",
    "image_author": "",
    "created_at": "2026-08-09T15:37:16.712Z"
  },
  {
    "id": "7d669dfd-0856-45bc-8e54-f02e34e2115b",
    "date": "2026-08-09",
    "category": "早安",
    "title": "早安，胃和心都暖了",
    "content": "热牛奶冲开麦片香，窗台多肉沾着露水。咬一口煎蛋吐司，看见公交窗外银杏黄了。原来平凡清晨，藏着最踏实的欢喜。",
    "image_url": "/images/2026-08-09-11.jpg",
    "image_author": "",
    "created_at": "2026-08-09T15:37:20.102Z"
  },
  {
    "id": "bd6d4cfc-0eee-4f2d-90aa-9ad85650f437",
    "date": "2026-08-09",
    "category": "晚安",
    "title": "夜幕收容所·czq",
    "content": "洗完澡钻进被子，把今天的疲惫都交给枕头。窗外灯光一盏盏熄灭，我也是时候把思绪调成静音了。",
    "image_url": "/images/2026-08-09-12.jpg",
    "image_author": "",
    "created_at": "2026-08-09T15:37:29.312Z"
  },
  {
    "id": "90a13e58-e4c2-4456-8cf6-f173d5e869d1",
    "date": "2026-08-09",
    "category": "晚安",
    "title": "夜的门槛",
    "content": "灯关了，窗外的光还醒着。头发半干，水汽在皮肤上慢慢退潮。一天的声音终于安静下来，只剩下呼吸在数自己的节拍。",
    "image_url": "/images/2026-08-09-13.jpg",
    "image_author": "",
    "created_at": "2026-08-09T15:37:32.751Z"
  },
  {
    "id": "f0bb2b73-75b7-4b71-bbda-2ba627ffa664",
    "date": "2026-08-09",
    "category": "晚安",
    "title": "夜幕收容",
    "content": "洗完澡躺下，头发半干。今天所有的话、笑和沉默，都被夜色收走。窗外路灯正好，不用想明天。",
    "image_url": "/images/2026-08-09-14.jpg",
    "image_author": "",
    "created_at": "2026-08-09T15:37:34.574Z"
  },
  {
    "id": "70902343-e666-4680-99e0-32dfbf297fb4",
    "date": "2026-08-09",
    "category": "晚安",
    "title": "一天收进被窝",
    "content": "热水冲走了白天的杂音，窗外的灯光一盏盏睡着。手机放下，今天的心事也放到枕边。就这样吧，夜很安静，我也安静。",
    "image_url": "/images/2026-08-09-15.jpg",
    "image_author": "",
    "created_at": "2026-08-09T15:37:36.846Z"
  },
  {
    "id": "cad4b46c-6986-421a-9567-d17e7a1812b2",
    "date": "2026-08-09",
    "category": "日常",
    "title": "周末厨房初体验",
    "content": "今天试着做了个番茄炒蛋，卖相不咋地但味道居然还行。收拾完厨房，发现做饭也没那么难嘛。",
    "image_url": "/images/2026-08-09-16.jpg",
    "image_author": "",
    "created_at": "2026-08-09T15:37:38.444Z"
  },
  {
    "id": "8c30f733-f4a7-4a9b-bab7-ea0769c99bf5",
    "date": "2026-08-09",
    "category": "日常",
    "title": "周五晚上",
    "content": "冰箱里剩的菜随便炒了炒，没想到还挺好吃。收拾完屋子瘫在沙发上，突然觉得这样的日子也挺好。",
    "image_url": "/images/2026-08-09-17.jpg",
    "image_author": "",
    "created_at": "2026-08-09T15:37:40.046Z"
  },
  {
    "id": "b617422f-d5f6-4c57-ab74-e257117f8f3b",
    "date": "2026-08-09",
    "category": "日常",
    "title": "厨房新手",
    "content": "下班路上买了把青菜，回家随便炒了炒，居然没糊。配着白米饭吃完，感觉日子也没那么难。",
    "image_url": "/images/2026-08-09-18.jpg",
    "image_author": "",
    "created_at": "2026-08-09T15:37:41.970Z"
  },
  {
    "id": "a5a5eac7-f58e-42ea-8a02-f418c599baa8",
    "date": "2026-08-09",
    "category": "日常",
    "title": "阳台发呆",
    "content": "下午在阳台发了会儿呆，看楼下大爷遛狗，风挺舒服的。突然觉得，日子就这么过着也挺好。",
    "image_url": "/images/2026-08-09-19.jpg",
    "image_author": "",
    "created_at": "2026-08-09T15:37:43.577Z"
  },
  {
    "id": "68ff9d88-96fe-4979-bf05-a6e5570800e1",
    "date": "2026-08-08",
    "category": "励志",
    "title": "还醒着",
    "content": "凌晨一点关电脑，电梯里看见自己影子。没有变瘦，也没有垮掉。日子就这样，熬过去一天，就赢了一天。",
    "image_url": "/images/2026-08-08-0.jpg",
    "image_author": "",
    "created_at": "2026-08-08T15:34:34.539Z"
  },
  {
    "id": "96cb9e40-4dfa-4b89-91de-8264f36c06c3",
    "date": "2026-08-08",
    "category": "励志",
    "title": "熬过今天的重量",
    "content": "晚上十点的健身房，器械声和心跳声混在一起。肌肉会酸痛，但明天它会记住今天。生活也一样。",
    "image_url": "/images/2026-08-08-1.jpg",
    "image_author": "",
    "created_at": "2026-08-08T15:34:38.329Z"
  },
  {
    "id": "ce79bb0e-55eb-41f1-9374-43029e83aeff",
    "date": "2026-08-08",
    "category": "励志",
    "title": "重复的力量",
    "content": "同一段路走了几百遍，闭着眼也能找到站台。天还没亮的地铁，每个人都有故事，但没人停下脚步。",
    "image_url": "/images/2026-08-08-2.jpg",
    "image_author": "",
    "created_at": "2026-08-08T15:34:40.702Z"
  },
  {
    "id": "51ebe2c7-0f96-4307-ac91-2162788c496b",
    "date": "2026-08-08",
    "category": "励志",
    "title": "微光",
    "content": "六点的闹钟响了第三次，我按掉它时突然想通：那些逼自己起床的早晨，终会变成某天从容的底气。",
    "image_url": "/images/2026-08-08-3.jpg",
    "image_author": "",
    "created_at": "2026-08-08T15:34:43.736Z"
  },
  {
    "id": "9ff77c9b-f80d-4f96-86ab-5121bc63e50b",
    "date": "2026-08-08",
    "category": "情感",
    "title": "联系",
    "content": "加班回来路边买了份馄饨，老板娘多送了两个。热气腾腾的，忽然想起我妈视频里那句『吃好了没』，原来亲情是走到哪都跟着的暖。吃完给家里发了条消息。晚安。",
    "image_url": "/images/2026-08-08-4.jpg",
    "image_author": "",
    "created_at": "2026-08-08T15:34:46.596Z"
  },
  {
    "id": "0f957f73-a2d7-4911-b05b-c6cf02112703",
    "date": "2026-08-08",
    "category": "情感",
    "title": "雨天想起你",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。想到上次一起吃饭还是去年冬天，时间过得真快。你过得好吗？",
    "image_url": "/images/2026-08-08-5.jpg",
    "image_author": "",
    "created_at": "2026-08-08T15:34:49.094Z"
  },
  {
    "id": "760e4e07-ce1c-40bf-80b7-52cbfd202332",
    "date": "2026-08-08",
    "category": "情感",
    "title": "雨天的问候·2qt",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说太多，就问问他那边天气怎么样。他回了个笑脸，说正煮着茶。隔着屏幕，仿佛闻到了茶香。",
    "image_url": "/images/2026-08-08-6.jpg",
    "image_author": "",
    "created_at": "2026-08-08T15:34:59.783Z"
  },
  {
    "id": "32944022-99be-41f3-b934-6e7754f54d9a",
    "date": "2026-08-08",
    "category": "情感",
    "title": "雨天想起了你",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没什么大事，就是想知道你那边天气怎么样，伞够不够用。",
    "image_url": "/images/2026-08-08-7.jpg",
    "image_author": "",
    "created_at": "2026-08-08T15:35:02.515Z"
  },
  {
    "id": "2ac1e74e-4a63-4856-8fc0-1d42713e295d",
    "date": "2026-08-08",
    "category": "早安",
    "title": "早安，先吃饱",
    "content": "吐司边烤得刚好，咖啡冒热气时我咬了一口太阳蛋。窗户开条缝，风把树叶的沙沙声送进来。今天也慢慢走，反正路边的花不会急着开完。",
    "image_url": "/images/2026-08-08-8.jpg",
    "image_author": "",
    "created_at": "2026-08-08T15:35:09.318Z"
  },
  {
    "id": "9d0afeea-84fe-4fa6-86fe-1db2d968bb86",
    "date": "2026-08-08",
    "category": "早安",
    "title": "早起的理由",
    "content": "吐司边烤得刚好，咖啡香飘进卧室。七点的阳光斜斜洒在桌上，连影子都带着暖意。出门时遇见第一缕风，轻轻推着我往前走。",
    "image_url": "/images/2026-08-08-9.jpg",
    "image_author": "",
    "created_at": "2026-08-08T15:35:11.783Z"
  },
  {
    "id": "2d418db1-edea-41c4-b985-4745c1471dbe",
    "date": "2026-08-08",
    "category": "早安",
    "title": "清晨的仪式感",
    "content": "煎蛋在锅里滋滋响，咖啡香钻进鼻腔。推开窗，风是甜的。今天的路，走着走着就会亮起来。",
    "image_url": "/images/2026-08-08-10.jpg",
    "image_author": "",
    "created_at": "2026-08-08T15:35:16.625Z"
  },
  {
    "id": "e345a9fb-6372-4cd1-acff-31e86c0acce1",
    "date": "2026-08-08",
    "category": "早安",
    "title": "第一口",
    "content": "煎蛋边缘焦脆，吐司抹上黄油刚好化开。晨光爬到桌上，和咖啡的热气撞个满怀。出门前回望一眼，窗台的多肉正伸着懒腰。",
    "image_url": "/images/2026-08-08-11.jpg",
    "image_author": "",
    "created_at": "2026-08-08T15:35:19.114Z"
  },
  {
    "id": "82ac3a9a-892b-420a-bd3d-30f830896bd0",
    "date": "2026-08-08",
    "category": "晚安",
    "title": "今日收尾",
    "content": "灯灭了，窗外的光还亮着。洗过的头发有淡淡的香。今天发生的，就留在今天。此刻只有呼吸和夜色。",
    "image_url": "/images/2026-08-08-12.jpg",
    "image_author": "",
    "created_at": "2026-08-08T15:35:21.610Z"
  },
  {
    "id": "d1a29e3c-a41d-452a-8cd4-56c0ccca6f7b",
    "date": "2026-08-08",
    "category": "晚安",
    "title": "夜已深",
    "content": "灯关了，窗外路灯还亮着。今天有些话没说，有些事没做，就都留给今天吧。床很软，夜很静，我很好。",
    "image_url": "/images/2026-08-08-13.jpg",
    "image_author": "",
    "created_at": "2026-08-08T15:35:24.295Z"
  },
  {
    "id": "a5e3b3ab-8f57-4486-9f47-073842f60273",
    "date": "2026-08-08",
    "category": "晚安",
    "title": "今夜到此为止",
    "content": "把窗外的灯一盏盏数完，夜的重量落进枕头里。今天所有的事，都归今天的自己管。现在，我只管好好闭上眼睛。",
    "image_url": "/images/2026-08-08-14.jpg",
    "image_author": "",
    "created_at": "2026-08-08T15:35:27.033Z"
  },
  {
    "id": "9ac77fe5-2b0a-49c8-8554-8a5e7bf3fdb5",
    "date": "2026-08-08",
    "category": "晚安",
    "title": "灯下时分",
    "content": "关了灯，城市的光从窗帘缝漏进来。这一天像翻完的书页，轻轻合上，连叹息都是多余的。此刻只属于自己。",
    "image_url": "/images/2026-08-08-15.jpg",
    "image_author": "",
    "created_at": "2026-08-08T15:35:29.438Z"
  },
  {
    "id": "bb4000fb-9114-490d-8118-5a3903b0a4ed",
    "date": "2026-08-08",
    "category": "日常",
    "title": "烟火日常",
    "content": "今天自己做了碗面，味道居然还不错。收拾完屋子，阳台发了会儿呆，日子就这么过，挺好。",
    "image_url": "/images/2026-08-08-16.jpg",
    "image_author": "",
    "created_at": "2026-08-08T15:35:31.793Z"
  },
  {
    "id": "10df7615-f09b-483a-ac16-0bcf80b12390",
    "date": "2026-08-08",
    "category": "日常",
    "title": "自己动手",
    "content": "今天自己做了碗面，味道居然还不错。收拾完屋子，去阳台发了会呆。日子就这样，平平淡淡也挺好。",
    "image_url": "/images/2026-08-08-17.jpg",
    "image_author": "",
    "created_at": "2026-08-08T15:35:37.780Z"
  },
  {
    "id": "836fb4d3-b094-4491-b182-700b714f8bdb",
    "date": "2026-08-08",
    "category": "日常",
    "title": "阳台放空",
    "content": "下午在阳台发了会儿呆，看楼下大爷遛弯，风挺舒服的。突然觉得，偶尔啥也不干也挺好。",
    "image_url": "/images/2026-08-08-18.jpg",
    "image_author": "",
    "created_at": "2026-08-08T15:35:40.195Z"
  },
  {
    "id": "f8140f3c-dee8-499c-bfc8-5038f5720d91",
    "date": "2026-08-08",
    "category": "日常",
    "title": "晚饭选手",
    "content": "今天自己做了碗面，味道居然还不错。收拾完屋子窝在沙发上发呆，窗外有人遛狗，日子就这么过，也挺好。",
    "image_url": "/images/2026-08-08-19.jpg",

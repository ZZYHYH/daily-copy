[
  {
    "id": "3fac44bf-77d7-4309-8216-3f1098d0c86b",
    "date": "2026-08-04",
    "category": "励志",
    "title": "今天的路",
    "content": "六点的闹钟响了三次，还是爬起来了。地铁上啃着面包看窗外，天一点一点亮起来。日子是熬出来的光。",
    "image_url": "/images/2026-08-04-0.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:56:36.509Z"
  },
  {
    "id": "4162eb76-9782-4153-8d0b-5cfaee167578",
    "date": "2026-08-04",
    "category": "励志",
    "title": "方向",
    "content": "闹钟响时挣扎了几秒，还是爬起来了。窗外天刚亮，像极了我现在的状态——还没完全清醒，但已经在路上。",
    "image_url": "/images/2026-08-04-1.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:56:38.744Z"
  },
  {
    "id": "5d0bea34-58c3-46d1-8798-45f6bf4495e1",
    "date": "2026-08-04",
    "category": "励志",
    "title": "把今天过成答案",
    "content": "凌晨的闹钟响了三次，第七次改方案，跑完五公里。生活没有奇迹，只有积攒。把今天过成答案，明天自然会看见。",
    "image_url": "/images/2026-08-04-2.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:56:46.378Z"
  },
  {
    "id": "fd593b16-23b6-4cff-b7a1-c72abf075317",
    "date": "2026-08-04",
    "category": "励志",
    "title": "方向·i4v",
    "content": "早起的地铁虽然挤，但至少方向是对的。加班到深夜那盏路灯，刚好照见我今天的成长。",
    "image_url": "/images/2026-08-04-3.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:56:56.009Z"
  },
  {
    "id": "ed94bef3-27f6-4ea0-976e-9ec84863ff72",
    "date": "2026-08-04",
    "category": "情感",
    "title": "雨天的句点",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说想念，只问那边天气如何。她回：正煮茶，等你来续。原来有些陪伴，一直留着位置。",
    "image_url": "/images/2026-08-04-4.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:56:58.225Z"
  },
  {
    "id": "0e5ffe1d-47d1-4a45-88bb-e96adcbf5d8d",
    "date": "2026-08-04",
    "category": "情感",
    "title": "旧友",
    "content": "下雨天翻到以前的合照，想起我们曾挤在一把伞下分吃烤红薯。好久没联系了，突然想发条消息：最近好吗？",
    "image_url": "/images/2026-08-04-5.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:00.318Z"
  },
  {
    "id": "d3d6789b-631d-452f-bd9e-f067ba80fa22",
    "date": "2026-08-04",
    "category": "情感",
    "title": "雨天的信号·awt",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说太多，就问问那边天气如何，结果聊到了深夜。",
    "image_url": "/images/2026-08-04-6.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:08.556Z"
  },
  {
    "id": "de6076b8-bab2-4ac5-94a3-72093bb5b315",
    "date": "2026-08-04",
    "category": "情感",
    "title": "筷子声里的想念",
    "content": "今天和爸妈视频，老爸举着手机给我看桌上的菜，说都是我爱吃的。挂了电话，对着泡面愣了半天。有些想念，就这样突然涌上来。",
    "image_url": "/images/2026-08-04-7.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:12.000Z"
  },
  {
    "id": "b40e62ce-e34a-4c21-accb-6d4db149c327",
    "date": "2026-08-04",
    "category": "早安",
    "title": "早起的馈赠",
    "content": "窗外的光刚爬上餐盘，咖啡冒着热气。咬一口酥脆的吐司，突然觉得，能这样安静地吃顿早饭，再慢慢走出去，就是很好的开始了。",
    "image_url": "/images/2026-08-04-8.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:15.744Z"
  },
  {
    "id": "21c20ab9-3ce7-4247-83ae-e66c0f72372c",
    "date": "2026-08-04",
    "category": "早安",
    "title": "太阳刚醒",
    "content": "咖啡冒热气的时候，窗台有只麻雀在偷看。咬一口脆脆的吐司，听见楼下传来自行车铃铛声——今天该出发了。",
    "image_url": "/images/2026-08-04-9.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:22.993Z"
  },
  {
    "id": "fc885463-db6b-46b6-b888-c71369b2af21",
    "date": "2026-08-04",
    "category": "早安",
    "title": "晨光正好·2ah",
    "content": "煎蛋在锅里滋滋响，咖啡香飘满屋。咬一口酥脆吐司，阳光刚好跳上餐桌。出门遇见风，脚步都变轻快了。",
    "image_url": "/images/2026-08-04-10.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:32.818Z"
  },
  {
    "id": "0ebca2a8-3cb4-4ea3-b473-0efe306bba1c",
    "date": "2026-08-04",
    "category": "早安",
    "title": "早安，热咖啡",
    "content": "热咖啡倒进杯子的声音，比闹钟好听多了。煎蛋在锅里滋滋响，阳光刚好爬上桌角。吃完这口，就该出门迎风了。",
    "image_url": "/images/2026-08-04-11.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:40.487Z"
  },
  {
    "id": "edf051e4-b782-434d-a724-9c906320c4ac",
    "date": "2026-08-04",
    "category": "晚安",
    "title": "灯下",
    "content": "热水冲走了一天的黏腻，窗帘拉上，窗外的路灯光晕被揉成一小团。手机屏幕暗下去的瞬间，听见自己的呼吸，不急不慢的。今天就到这里吧。",
    "image_url": "/images/2026-08-04-12.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:43.165Z"
  },
  {
    "id": "de7a3fc4-7cdb-476b-bc5e-43f8f673109f",
    "date": "2026-08-04",
    "category": "晚安",
    "title": "夜的注脚",
    "content": "把光调暗，被子裹住一天的疲惫。窗外偶尔有车声经过，像是城市在轻轻翻身。此刻什么都不想，让呼吸慢下来，就到这里吧。",
    "image_url": "/images/2026-08-04-13.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:45.039Z"
  },
  {
    "id": "3fbdf15f-5769-40c0-922f-553a0abd70a1",
    "date": "2026-08-04",
    "category": "晚安",
    "title": "灯熄了，夜就亮了",
    "content": "关灯前看了眼窗外，楼下的灯还亮着几盏。今天的事都收进黑暗里了，连同白天的声响一起。此刻只有呼吸声，和窗外那片深蓝，正好够装下所有没说出口的话。",
    "image_url": "/images/2026-08-04-14.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:48.702Z"
  },
  {
    "id": "85432854-ecde-4044-afa4-d7197e0d84c8",
    "date": "2026-08-04",
    "category": "晚安",
    "title": "夜色收容所",
    "content": "热水冲走了一天的重量，躺在被窝里听窗外风声，这一刻不属于任何人。城市的灯一盏盏熄了，我也该把自己还给梦了。",
    "image_url": "/images/2026-08-04-15.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:51.075Z"
  },
  {
    "id": "b2290bc7-3c79-47b1-ab0f-a103829313e8",
    "date": "2026-08-04",
    "category": "日常",
    "title": "厨房初体验",
    "content": "第一次正经做饭，切菜切得歪七扭八，炒出来居然能吃。洗碗的时候突然觉得，一个人住也挺好。",
    "image_url": "/images/2026-08-04-16.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:53.147Z"
  },
  {
    "id": "790a719e-967b-40a8-b45a-ac6c626376f4",
    "date": "2026-08-04",
    "category": "日常",
    "title": "今天的小日子",
    "content": "买菜回来顺道收拾了屋子，阳台发了会儿呆。晚上炒的青菜居然没糊，这日子过得还挺像样。",
    "image_url": "/images/2026-08-04-17.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:56.874Z"
  },
  {
    "id": "f6240152-d363-42cb-ae2c-10108080e205",
    "date": "2026-08-04",
    "category": "日常",
    "title": "糊弄学初体验",
    "content": "晚上懒得炒菜，煮了锅乱炖，卖相一般但吃着真香。收拾完碗筷下楼遛了一圈，风吹着挺舒服，感觉这一天也没白过。",
    "image_url": "/images/2026-08-04-18.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:58:00.795Z"
  },
  {
    "id": "6e0dd971-8fbd-4c8d-bf85-cf080a761e64",
    "date": "2026-08-04",
    "category": "日常",
    "title": "今日份小确幸",
    "content": "下午收拾房间翻出老照片，笑得不行。晚上炒了个土豆丝，卖相一般但吃光光了。",
    "image_url": "/images/2026-08-04-19.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:58:02.945Z"
  },
  {
    "id": "85f76944-fd31-41f6-ab65-3ef68699c4c2",
    "date": "2026-08-03",
    "category": "励志",
    "title": "日子是熬出来的",
    "content": "六点的闹钟响了三次才爬起来，咖啡灌下去才回魂。昨晚的PPT还没改完，但今天的地铁依然准时。日子就这样，一边想放弃一边往前走。",
    "image_url": "/images/2026-08-03-0.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:11:37.571Z"
  },
  {
    "id": "f69177bb-7e2f-4809-a2bd-6992d89a47a8",
    "date": "2026-08-03",
    "category": "励志",
    "title": "慢慢来",
    "content": "闹钟响了三次才起来，晨跑三公里，加班两小时，睡前翻了十页书。日子没有突然变好，但确实在往前走。",
    "image_url": "/images/2026-08-03-1.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:11:43.931Z"
  },
  {
    "id": "6183d7ad-d0da-4137-b712-535ccbb5732a",
    "date": "2026-08-03",
    "category": "励志",
    "title": "自己的节奏",
    "content": "六点的闹钟响了三次才起来，晨跑三公里，加班两小时。生活没有奇迹，只有自己一步步踩实的路。",
    "image_url": "/images/2026-08-03-2.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:11:52.070Z"
  },
  {
    "id": "f566aef5-fea2-4372-8fbd-cba1f9b6c8b6",
    "date": "2026-08-03",
    "category": "励志",
    "title": "光的方向",
    "content": "闹钟响了第三遍才爬起来，地铁里人贴着人。但每次抬头，都刚好看见窗外的晨光。原来日子就是这样，低着头赶路，偶尔也能撞见光。",
    "image_url": "/images/2026-08-03-3.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:11:55.543Z"
  },
  {
    "id": "d27162b7-43ff-4f1f-a182-25e74e8e2295",
    "date": "2026-08-03",
    "category": "情感",
    "title": "雨天的牵挂",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。窗外的雨声像极了那年我们一起躲雨的屋檐。",
    "image_url": "/images/2026-08-03-4.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:00.382Z"
  },
  {
    "id": "39471a4e-e9da-443b-a5e8-568134c338d2",
    "date": "2026-08-03",
    "category": "情感",
    "title": "热汤",
    "content": "加班回来，楼道里飘着邻居家的饭香。我站在门口愣了几秒，掏出手机给妈妈发了句：妈，明天我想回家吃饭。",
    "image_url": "/images/2026-08-03-5.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:02.542Z"
  },
  {
    "id": "5c4d8c72-bbb8-48a5-bdb9-abf78c45948d",
    "date": "2026-08-03",
    "category": "情感",
    "title": "下雨天的想念",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。其实没什么事，就是想知道你最近过得好不好。",
    "image_url": "/images/2026-08-03-6.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:04.488Z"
  },
  {
    "id": "959854da-0247-4d81-b3b3-ccca3b28e2ab",
    "date": "2026-08-03",
    "category": "情感",
    "title": "雨的来信",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说太多，就问问他那边天气如何。他回了个笑脸，说挺好的。原来牵挂这么轻，轻得像雨点落在窗台上。",
    "image_url": "/images/2026-08-03-7.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:06.830Z"
  },
  {
    "id": "451ecadc-2ea0-4dc1-8472-e7a0d0200269",
    "date": "2026-08-03",
    "category": "早安",
    "title": "早餐的光",
    "content": "吐司边烤得刚好，咖啡冒着热气。窗外的风把云吹得很轻，推开门，今天的光落在肩上，正好。",
    "image_url": "/images/2026-08-03-8.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:12.441Z"
  },
  {
    "id": "f6eacce1-8847-4470-863d-be5d4d3f36a5",
    "date": "2026-08-03",
    "category": "早安",
    "title": "早安，今天",
    "content": "热咖啡冒着白气，阳光刚好落在餐桌上。咬一口酥脆的吐司，推开门的瞬间，风是轻的，路是亮的。新的一天，慢慢来。",
    "image_url": "/images/2026-08-03-9.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:15.986Z"
  },
  {
    "id": "d862c197-a1d9-4dd7-9447-fe0a56e85514",
    "date": "2026-08-03",
    "category": "早安",
    "title": "晨光与热咖啡",
    "content": "窗外鸟叫提醒我早起，热咖啡配吐司，第一口就清醒了。晨风很轻，街道还安静，这样的早晨，值得认真对待。",
    "image_url": "/images/2026-08-03-10.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:18.783Z"
  },
  {
    "id": "6fb69e32-47b0-4b83-885e-bcb0ad6fc8ca",
    "date": "2026-08-03",
    "category": "早安",
    "title": "早安，开动",
    "content": "吐司边烤得刚好，咖啡香飘满屋。咬一口煎蛋，阳光正好落在桌上。新的一天，从填饱肚子开始。",
    "image_url": "/images/2026-08-03-11.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:20.861Z"
  },
  {
    "id": "436792e3-58fb-4c85-8db6-53a057dc4374",
    "date": "2026-08-03",
    "category": "晚安",
    "title": "夜已接管",
    "content": "窗帘拉上，灯调暗，窗外车流声渐渐稀疏。浴室的水汽还没散去，皮肤上留着沐浴露的余温。这一天所有的喧嚣，都在枕头旁边慢慢沉底。",
    "image_url": "/images/2026-08-03-12.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:23.242Z"
  },
  {
    "id": "53fd7d19-62fe-4cf8-b099-95fbf7fee361",
    "date": "2026-08-03",
    "category": "晚安",
    "title": "夜的开场",
    "content": "灯关了，窗外还亮着几盏。今天的事在脑子里过了一遍，该放下的就放下吧。被子裹紧些，夜很长，梦很轻。",
    "image_url": "/images/2026-08-03-13.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:26.794Z"
  },
  {
    "id": "85ca9488-0767-4040-b4ca-c079d431bac4",
    "date": "2026-08-03",
    "category": "晚安",
    "title": "今日已归档",
    "content": "关了灯的房间，窗外路灯比星星还亮。今天所有的事，都留在今天的夜色里了。我只要躺平，呼吸，然后慢慢沉下去。",
    "image_url": "/images/2026-08-03-14.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:32.969Z"
  },
  {
    "id": "fc3acc30-0622-4a88-b407-54caae92af50",
    "date": "2026-08-03",
    "category": "晚安",
    "title": "今天的句号",
    "content": "把窗外的灯火调成静音模式，枕边只剩呼吸和月光。这一天所有的疲惫，都融进温水里冲走了。现在，我只属于这片柔软的黑暗。",
    "image_url": "/images/2026-08-03-15.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:35.014Z"
  },
  {
    "id": "296c2060-f63c-49eb-8936-cd0cb0e7c600",
    "date": "2026-08-03",
    "category": "日常",
    "title": "今天的厨房我承包了",
    "content": "冰箱里翻出俩西红柿和鸡蛋，随手一炒，味道居然比外卖强。吃完瘫沙发上，这日子，踏实。",
    "image_url": "/images/2026-08-03-16.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:37.101Z"
  },
  {
    "id": "b693e5d2-75e8-42ca-896e-6ef8ebf92241",
    "date": "2026-08-03",
    "category": "日常",
    "title": "一碗面的快乐",
    "content": "自己煮了碗面，卧了个蛋，加点青菜，居然还挺像那么回事。吃完瘫沙发上发呆，感觉这一天也没白过。",
    "image_url": "/images/2026-08-03-17.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:40.482Z"
  },
  {
    "id": "30193471-6238-4a31-bbd7-6afbf97eba8c",
    "date": "2026-08-03",
    "category": "日常",
    "title": "今日份满足",
    "content": "买菜回来顺手收拾了厨房，阳台发了会呆。晚饭煮了碗面，放了两颗蛋，味道居然还行。",
    "image_url": "/images/2026-08-03-18.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:42.876Z"
  },
  {
    "id": "ffba5296-1390-4af0-932d-f397871cc335",
    "date": "2026-08-03",
    "category": "日常",
    "title": "吃完躺平",
    "content": "今天自己做了碗面，味道居然还不错。收拾完房间，阳台发了会儿呆，想着待会儿再去遛个弯。日子就这么过，挺好。",
    "image_url": "/images/2026-08-03-19.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:45.068Z"
  },
  {
    "id": "65caf1a4-ebf2-425a-8960-6e4a7bd83d24",
    "date": "2026-08-02",
    "category": "励志",
    "title": "普通一天",
    "content": "深夜回家路上，抬头看见写字楼还亮着几扇窗。原来不是我一个人在较劲。今天的疲惫，是明天的底气。",
    "image_url": "/images/2026-08-02-0.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:03:43.038Z"
  },
  {
    "id": "fb0c5bd7-6fd8-469a-b4d8-616cfceb1bd1",
    "date": "2026-08-02",
    "category": "励志",
    "title": "晨光",
    "content": "六点的闹钟响了三次才起床，通勤路上买了杯热豆浆。昨晚的PPT改了四版，今天继续。日子就是这样，一点一点往前挪。",
    "image_url": "/images/2026-08-02-1.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:03:46.252Z"
  },
  {
    "id": "ab3be799-4a52-4047-af0e-4bdd5e4b0973",
    "date": "2026-08-02",
    "category": "励志",
    "title": "匀速前进",
    "content": "六点的闹钟响了三次，还是起来了。晨光落在键盘上，像昨晚没做完的梦。慢一点没关系，在走就好。",
    "image_url": "/images/2026-08-02-2.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:03:48.757Z"
  },
  {
    "id": "5f6257e1-5758-4f28-82ce-ae6065c8bff7",
    "date": "2026-08-02",
    "category": "励志",
    "title": "清晨的方向",
    "content": "六点的闹钟响了第三次，我还是爬起来了。天没亮透，风有点凉，但跑完三公里后，忽然觉得今天没什么可怕的。",
    "image_url": "/images/2026-08-02-3.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:03:55.587Z"
  },
  {
    "id": "fa9f2fce-e009-4a78-9f3c-48d9460df898",
    "date": "2026-08-02",
    "category": "情感",
    "title": "雨天的惦记",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没聊什么要紧事，就是问问她那边天气怎么样。",
    "image_url": "/images/2026-08-02-4.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:03:57.844Z"
  },
  {
    "id": "7b446196-d3a3-4184-a41f-799d5f52798d",
    "date": "2026-08-02",
    "category": "情感",
    "title": "一碗热汤",
    "content": "炖汤时多放了两颗红枣，想起妈妈也爱这么煮。视频通话里她笑着说我胖了，镜头那头的晚饭，和我这碗一模一样。",
    "image_url": "/images/2026-08-02-5.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:01.490Z"
  },
  {
    "id": "77fe7187-0053-4496-9f15-1b68d75aee44",
    "date": "2026-08-02",
    "category": "情感",
    "title": "雨天的问候",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说太多，就问了句最近好吗。她回了个笑脸，说正在煮茶。有些关系，隔着时间也能接住彼此。",
    "image_url": "/images/2026-08-02-6.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:04.078Z"
  },
  {
    "id": "3dc53b68-6659-4d0e-92cd-9b63a2f04acf",
    "date": "2026-08-02",
    "category": "情感",
    "title": "晚来的消息",
    "content": "深夜翻到老照片，想起我们蹲在路边吃冰棍的夏天。给远方的你发了句晚安，不知道明天醒来，会不会也刚好想起我。",
    "image_url": "/images/2026-08-02-7.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:06.246Z"
  },
  {
    "id": "53da5d84-54c0-4c79-8568-591b4407b28f",
    "date": "2026-08-02",
    "category": "早安",
    "title": "早安，出发",
    "content": "烤面包的香味飘到床边，咖啡冒着热气。咬一口酥脆，喝一口温热，推开门，阳光正好落在肩头。",
    "image_url": "/images/2026-08-02-8.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:08.020Z"
  },
  {
    "id": "154dd1f0-4cf8-4fb4-bec1-297ac7bf69bb",
    "date": "2026-08-02",
    "category": "早安",
    "title": "晨光正好·091",
    "content": "咬一口热吐司，看阳光爬上窗台。咖啡的香气里，今天的一切都刚刚好，该出发了。",
    "image_url": "/images/2026-08-02-9.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:18.455Z"
  },
  {
    "id": "226889c1-d76f-4617-94e9-64a45521395d",
    "date": "2026-08-02",
    "category": "早安",
    "title": "阳光正好",
    "content": "咬下第一口酥脆吐司时，窗台上的绿萝在发光。咖啡香飘进背包，推开门，晨风就撞了满怀。",
    "image_url": "/images/2026-08-02-10.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:20.484Z"
  },
  {
    "id": "1808b6d4-211b-4d35-a83a-16ecac5bf627",
    "date": "2026-08-02",
    "category": "早安",
    "title": "早安，晨光正好",
    "content": "面包在烤，咖啡在冒热气，窗外的风刚好吹进来。出门前多看了会儿天空，今天应该是个好天气。",
    "image_url": "/images/2026-08-02-11.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:23.131Z"
  },
  {
    "id": "3ddbca8f-71e5-4f20-837a-9aa649a4a72d",
    "date": "2026-08-02",
    "category": "晚安",
    "title": "收工",
    "content": "洗完澡钻进被子，窗帘没拉满，留了条缝让路灯的光漏进来。手机搁在床头充电，今天就到这里吧，剩下的明天再说。",
    "image_url": "/images/2026-08-02-12.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:25.419Z"
  },
  {
    "id": "ebda5bbd-4102-454d-85aa-044f4cbf937c",
    "date": "2026-08-02",
    "category": "晚安",
    "title": "灯下的夜",
    "content": "热水冲走了今天的疲惫，头发还带着潮气。窗外星星不多，但亮得刚好。此刻的安静，只属于自己。",
    "image_url": "/images/2026-08-02-13.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:27.506Z"
  },
  {
    "id": "f0fe4cb2-f29d-4642-8269-ddf4ad3b984e",
    "date": "2026-08-02",
    "category": "晚安",
    "title": "今日终章",
    "content": "灯熄了，窗帘留一道缝。城市的杂音渐渐退潮，只剩窗外零星的亮，和我均匀的呼吸。这一天，无论好坏，都翻篇了。",
    "image_url": "/images/2026-08-02-14.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:31.322Z"
  },
  {
    "id": "5c92f869-202d-4cec-b4c5-97284a0dc771",
    "date": "2026-08-02",
    "category": "晚安",
    "title": "夜色收留处",
    "content": "灯是刚关的，窗外的城市还没睡。被子有阳光的味道，今天所有的事，都先放到枕头边上了。",
    "image_url": "/images/2026-08-02-15.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:34.992Z"
  },
  {
    "id": "49c641ea-4c6a-4101-ac9c-1a9ca4bdb08f",
    "date": "2026-08-02",
    "category": "日常",
    "title": "今天有点小成就",
    "content": "收拾了半小时房间，扔了三袋不要的东西，阳台发了十分钟呆。晚上给自己炒了个青菜，居然没糊。",
    "image_url": "/images/2026-08-02-16.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:37.526Z"
  },
  {
    "id": "15d7023d-0050-43af-b89d-b51e7525cc6d",
    "date": "2026-08-02",
    "category": "日常",
    "title": "周末的厨房",
    "content": "周六早起做了顿早午饭，煎蛋配面条，居然没糊锅。买菜回来顺路遛了弯，日子就这么过，挺好。",
    "image_url": "/images/2026-08-02-17.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:41.346Z"
  },
  {
    "id": "abe0acb0-023b-468d-8cdc-527caf50c4bc",
    "date": "2026-08-02",
    "category": "日常",
    "title": "阳台发呆",
    "content": "下午在阳台发了半小时呆，看楼下有人遛狗，有人赶路。突然觉得，这样浪费时间也挺好的。",
    "image_url": "/images/2026-08-02-18.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:46.633Z"
  },
  {
    "id": "57f95add-5842-4c9b-a76d-e360e2fe56d5",
    "date": "2026-08-02",
    "category": "日常",
    "title": "今天的厨房战绩",
    "content": "周末在家试了个新菜，卖相一般但味道真不错，锅底都舔干净了，很有成就感。",
    "image_url": "/images/2026-08-02-19.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:49.978Z"
  },
  {
    "id": "b53e00d2-ce5f-47b7-91d7-5481024c1a88",
    "date": "2026-08-01",
    "category": "励志",
    "title": "方向感",
    "content": "闹钟响第三次才爬起来，晨光已经铺满半条街。楼下早餐摊冒着热气，忽然觉得，把每天过好，就已经很了不起。",
    "image_url": "/images/2026-08-01-0.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:04:17.968Z"
  },
  {
    "id": "83457200-9da6-43ca-91a2-74457dc29253",
    "date": "2026-08-01",
    "category": "励志",
    "title": "灰蒙蒙的早晨",
    "content": "六点半的闹钟响了三次，我还是爬起来了。晨跑时看到环卫工人在扫落叶，忽然觉得每一天都是新的开始，哪怕昨夜的疲惫还在。",
    "image_url": "/images/2026-08-01-1.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:04:21.067Z"
  },
  {
    "id": "c7c077c5-6c55-46d0-9962-2dff5f08f9aa",
    "date": "2026-08-01",
    "category": "励志",
    "title": "路在脚下",
    "content": "六点的闹钟响了三次，还是爬起来了。天亮得越来越早，像在提醒我，每一步都算数，哪怕走得慢。",
    "image_url": "/images/2026-08-01-2.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:04:24.056Z"
  },
  {
    "id": "5fc05881-e9c2-4b51-a935-12a64680b3d0",
    "date": "2026-08-01",
    "category": "励志",
    "title": "普通日子",
    "content": "六点的闹钟响了第三次才爬起来，晨跑三公里，地铁上背了二十个单词。日子按部就班，但我知道自己在往上走。",
    "image_url": "/images/2026-08-01-3.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:04:29.059Z"
  },
  {
    "id": "e1ba200a-dfe4-4e0f-ab67-2077ee55dbe9",
    "date": "2026-08-01",
    "category": "情感",
    "title": "突然想你了",
    "content": "翻到去年存的一张合照，点开对话框打了又删。其实也没什么特别的事，就是今天风很轻，想问问你那里天气怎么样。",
    "image_url": "/images/2026-08-01-4.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:04:31.414Z"
  },
  {
    "id": "aede0a03-342b-4ef0-9ca7-570788995b95",
    "date": "2026-08-01",
    "category": "情感",
    "title": "雨天来电",
    "content": "下雨天，翻到去年和朋友吃饭的照片，顺手发了条消息。她说正在煮姜茶，问我喝不喝。原来有些联系，从来不需要理由。",
    "image_url": "/images/2026-08-01-5.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:04:36.885Z"
  },
  {
    "id": "e7216ffb-c7fe-43c3-a6d9-ed0b2e599f68",
    "date": "2026-08-01",
    "category": "情感",
    "title": "窗外的雨",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说太多，就问问那边天气怎么样。有些关系不用刻意维系，偶尔想起，就已经很好了。",
    "image_url": "/images/2026-08-01-6.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:04:38.894Z"
  },
  {
    "id": "4d9fe5f1-0d27-49db-aed3-3b8641a5e5c3",
    "date": "2026-08-01",
    "category": "情感",
    "title": "雨天问候",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说太多，就问问那边的天气。他回：正想你，雨就来了。",
    "image_url": "/images/2026-08-01-7.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:04:42.966Z"
  },
  {
    "id": "823d84c6-0067-4ef5-b6c6-934d7e9e98e7",
    "date": "2026-08-01",
    "category": "早安",
    "title": "早安，慢生活",
    "content": "阳光透过窗帘，咖啡冒着热气，吐司的焦香刚好。今天不赶时间，让早晨慢慢走，我也慢慢跟。",
    "image_url": "/images/2026-08-01-8.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:04:50.082Z"
  },
  {
    "id": "8f0f3fae-ab22-495d-aaf7-bae107b57644",
    "date": "2026-08-01",
    "category": "早安",
    "title": "晨光与煎蛋",
    "content": "吐司边缘烤得刚好，煎蛋流心戳破的瞬间，窗外鸟叫和咖啡香一起涌进来。出门时那个骑车少年按响车铃，清脆得就像此刻的心情。",
    "image_url": "/images/2026-08-01-9.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:04:54.340Z"
  },
  {
    "id": "7ac7f450-1b6f-4fe0-b3af-aa236c2a4b5a",
    "date": "2026-08-01",
    "category": "早安",
    "title": "晨光刚好",
    "content": "烤面包的焦香混着咖啡冒热气的时候，猫在窗台伸懒腰。出门前阳光正好铺在鞋尖上，走吧，今天值得期待。",
    "image_url": "/images/2026-08-01-10.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:05:00.369Z"
  },
  {
    "id": "78dee618-fd4b-4f5c-a7a2-b53de34c745f",
    "date": "2026-08-01",
    "category": "早安",
    "title": "早安，先吃为敬",
    "content": "吐司边缘烤得刚好，煎蛋还在滋滋响。咬一口，窗外的风都是甜的。出门前记得对自己笑一个，今天也要好好过。",
    "image_url": "/images/2026-08-01-11.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:05:03.077Z"
  },
  {
    "id": "3e328c45-805c-4c8d-a054-ee6d29601b36",
    "date": "2026-08-01",
    "category": "晚安",
    "title": "夜晚的留白",
    "content": "热水冲走了疲惫，灯一关，窗外的城市还在呼吸。此刻我不需要任何答案，只安静地躺着，听自己的脉搏，跟今天轻轻道别。",
    "image_url": "/images/2026-08-01-12.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:05:06.634Z"
  },
  {
    "id": "5b7112fa-1d01-4fb3-b6a7-35e4e44e7845",
    "date": "2026-08-01",
    "category": "晚安",
    "title": "今天散场了",
    "content": "热水冲走了今天的灰，窗帘拉上，城市的灯还亮着。丢开手机那刻，世界忽然安静。床很软，夜很长，今天到这里正好。",
    "image_url": "/images/2026-08-01-13.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:05:09.022Z"
  },
  {
    "id": "9854a9c5-eaff-466f-97c4-118792bb4abb",
    "date": "2026-08-01",
    "category": "晚安",
    "title": "夜已深",
    "content": "窗帘拉上，外面路灯的光还挤进一点。今天的事都做了，没做的也不急了。躺下来，听自己的呼吸，像在给这一天轻声画句号。",
    "image_url": "/images/2026-08-01-14.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:05:12.703Z"
  },
  {
    "id": "ee42187d-a2db-4342-a585-391275bc4107",
    "date": "2026-08-01",
    "category": "晚安",
    "title": "夜班的月",
    "content": "窗帘拉上，路灯的光还是漏了进来。听着洗衣机最后一阵旋转声停下，这一天就被安静地拧干了。窗台上那盆绿萝，正替我消化着今天没说出口的话。",
    "image_url": "/images/2026-08-01-15.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:05:15.563Z"
  },
  {
    "id": "1e41a78b-1046-4de8-add7-5020e3e603f4",
    "date": "2026-08-01",
    "category": "日常",
    "title": "今天也认真生活了",
    "content": "收拾完屋子，顺手煮了碗面，阳台发了会呆。突然觉得，把日子过顺了，比什么都强。",
    "image_url": "/images/2026-08-01-16.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:05:19.870Z"
  },
  {
    "id": "e78226e9-0a8f-4e47-b7b6-ef967929b4e8",
    "date": "2026-08-01",
    "category": "日常",
    "title": "面还不错",
    "content": "今天自己做了碗面，味道居然还不错。吃完窝在阳台发了会呆，楼下有人在遛狗，风吹着挺舒服的。",
    "image_url": "/images/2026-08-01-17.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:05:22.063Z"
  },
  {
    "id": "6c65a8cd-c760-4eac-acba-0d73c8f5742b",
    "date": "2026-08-01",
    "category": "日常",
    "title": "一碗面的满足感",
    "content": "今天自己做了碗面，煎蛋有点糊，但味道居然还不错。收拾完厨房，瘫在沙发上发呆，突然觉得这样的小日子也挺好。",
    "image_url": "/images/2026-08-01-18.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:05:27.313Z"
  },
  {
    "id": "96359205-4c30-4790-b3a1-d14ad264fce2",
    "date": "2026-08-01",
    "category": "日常",
    "title": "今天的三菜一汤",
    "content": "收拾完厨房，看着自己做的三菜一汤，突然觉得日子就是这样，一顿一顿吃出来的。虽然卖相一般，但肚子很满足。",
    "image_url": "/images/2026-08-01-19.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:05:30.079Z"
  },
  {
    "id": "48a3059a-587c-4320-bbf1-20e2cd15041a",
    "date": "2026-07-31",
    "category": "励志",
    "title": "天会亮的",
    "content": "昨晚加班到十一点，今早还是赶上了六点半的地铁。窗外的天从黑变蓝，像极了我们这些咬牙前行的日子。",
    "image_url": "/images/2026-07-31-0.jpg",
    "image_author": "",
    "created_at": "2026-07-31T16:48:22.742Z"
  },
  {
    "id": "a51043af-16da-45cb-b82c-89b5b61f8ae5",
    "date": "2026-07-31",
    "category": "励志",
    "title": "平凡坚持",
    "content": "六点的闹钟响第三次才爬起来，镜子里有点狼狈。但每天多走一步，回头看时，已经离原点很远了。",
    "image_url": "/images/2026-07-31-1.jpg",
    "image_author": "",
    "created_at": "2026-07-31T16:48:24.889Z"
  },
  {
    "id": "ea1f7e4c-4178-42e1-82ed-78a36c3757d4",
    "date": "2026-07-31",
    "category": "励志",
    "title": "路",
    "content": "早高峰的地铁挤得人变形，可每次抬头，都能看到窗外掠过的一片绿意。生活不就是这样，在拥挤里赶路，也在缝隙里开花。",
    "image_url": "/images/2026-07-31-2.jpg",
    "image_author": "",
    "created_at": "2026-07-31T16:48:29.417Z"
  },
  {
    "id": "866feb6c-4f87-49a0-abb0-3724d02e11ab",
    "date": "2026-07-31",
    "category": "励志",
    "title": "日拱一卒",
    "content": "闹钟响的时候，身体还在反抗，但脚已经落地了。那些看似重复的日子，其实每天都在悄悄向前。撑过去，就是新的一页。",
    "image_url": "/images/2026-07-31-3.jpg",
    "image_author": "",
    "created_at": "2026-07-31T16:48:31.792Z"
  },
  {
    "id": "56366f97-f63b-4830-b294-fbd98183ea57",
    "date": "2026-07-31",
    "category": "情感",
    "title": "雨天的消息",
    "content": "下雨天，翻到去年和爸妈吃饭的照片。拨了视频过去，他们正吃着面条，说今天也是雨天。聊了十分钟，窗外雨停了。",
    "image_url": "/images/2026-07-31-4.jpg",
    "image_author": "",
    "created_at": "2026-07-31T16:48:34.085Z"
  },
  {
    "id": "a59468a8-624e-4f94-aa6c-38206797ade5",
    "date": "2026-07-31",
    "category": "情感",
    "title": "雨天的信号",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。其实也没什么要紧事，就是想问问，你那边也在下雨吗。",
    "image_url": "/images/2026-07-31-5.jpg",
    "image_author": "",
    "created_at": "2026-07-31T16:48:35.950Z"
  },
  {
    "id": "ceab26fb-c8af-4799-891f-6fbba6cca401",
    "date": "2026-07-31",
    "category": "情感",
    "title": "晚风里的惦记",
    "content": "晚风凉了，忽然想起你上次说换季容易感冒。翻出聊天记录，发现我们好久没好好说说话了。",
    "image_url": "/images/2026-07-31-6.jpg",
    "image_author": "",
    "created_at": "2026-07-31T16:48:37.867Z"
  },
  {
    "id": "d3b3eedc-0015-498e-afd3-962bdecce1ed",
    "date": "2026-07-31",
    "category": "情感",
    "title": "今天的饭，少了个人",
    "content": "和朋友吃饭，菜单翻了两遍，还是点了你最爱的那道菜。拍了张照，没发出去。有些人不在身边，却总在饭点想起。",
    "image_url": "/images/2026-07-31-7.jpg",
    "image_author": "",
    "created_at": "2026-07-31T16:48:39.974Z"
  },
  {
    "id": "9a586263-8476-4757-be19-ca213b8983fe",
    "date": "2026-07-31",
    "category": "早安",
    "title": "咖啡香里的晨光",
    "content": "热咖啡冒烟时，窗外的光刚好落在杯沿。咬一口脆脆的吐司，听见自己说：今天要过得像这缕晨光一样。",
    "image_url": "/images/2026-07-31-8.jpg",
    "image_author": "",
    "created_at": "2026-07-31T16:48:42.202Z"
  },
  {
    "id": "e1541c8b-c168-4d7e-864f-3a1cc1653307",
    "date": "2026-07-31",
    "category": "早安",
    "title": "晨光正好",
    "content": "咖啡刚冲好，窗外的风带着凉意。咬一口热乎的包子，生活的小确幸就在这平凡的早晨里。出门啦，今天也要认真过。",
    "image_url": "/images/2026-07-31-9.jpg",
    "image_author": "",
    "created_at": "2026-07-31T16:48:44.339Z"
  },
  {
    "id": "cdaf95e2-0eaa-465d-a736-cc4228fd2f04",
    "date": "2026-07-31",
    "category": "早安",
    "title": "晨光与咖啡",
    "content": "阳光斜斜落在餐桌上，咬一口烤得酥脆的吐司，窗外的鸟鸣提醒我该出发了。生活就这样，平凡却值得期待。",
    "image_url": "/images/2026-07-31-10.jpg",
    "image_author": "",
    "created_at": "2026-07-31T16:48:48.235Z"
  },
  {
    "id": "e7020638-459d-46f7-9e7a-775a0a7490da",
    "date": "2026-07-31",
    "category": "早安",
    "title": "早安，被阳光叫醒",
    "content": "阳光斜斜地照进厨房，吐司边刚好烤到微焦，咖啡香飘满屋。出门时顺手拍下一朵路边的小花，今天也要好好过。",
    "image_url": "/images/2026-07-31-11.jpg",
    "image_author": "",
    "created_at": "2026-07-31T16:48:51.936Z"
  },
  {
    "id": "5d016aee-d7b5-4bf1-87af-d008441e14fe",
    "date": "2026-07-31",
    "category": "晚安",
    "title": "灯灭了",
    "content": "洗完澡，头发还没干透，窗外路灯亮着。这一天的事都过去了。手机屏幕暗下去，房间安静得能听见自己的呼吸。",
    "image_url": "/images/2026-07-31-12.jpg",
    "image_author": "",
    "created_at": "2026-07-31T16:48:54.063Z"
  },
  {
    "id": "2f33bf68-d962-4949-92fa-f2cb4309c1ca",
    "date": "2026-07-31",
    "category": "晚安",
    "title": "今日收档",
    "content": "浴室的热气散了，被子刚裹出温度。窗外那盏路灯替我亮着，今天就到这里吧。",
    "image_url": "/images/2026-07-31-13.jpg",
    "image_author": "",
    "created_at": "2026-07-31T16:48:56.152Z"
  },
  {
    "id": "ec4778c2-8a83-46c2-b198-321d02c769bb",
    "date": "2026-07-31",
    "category": "晚安",
    "title": "今日打烊",
    "content": "灯关掉的那一刻，窗外的车流还在流动。洗过澡的身体有清淡的香，床单是傍晚晒过的。今天没有遗憾，也没有未完的事，就到这里吧。",
    "image_url": "/images/2026-07-31-14.jpg",
    "image_author": "",
    "created_at": "2026-07-31T16:48:58.200Z"
  },
  {
    "id": "6990f8f8-ea44-4bb8-8c32-0210cc6e3a70",
    "date": "2026-07-31",
    "category": "晚安",
    "title": "夜归人",
    "content": "热水冲走了一天的尘埃，现在只剩窗外零星的灯光陪我。把手机调暗，世界也跟着安静下来。今夜不必追赶什么，就这样慢慢沉入梦里吧。",
    "image_url": "/images/2026-07-31-15.jpg",
    "image_author": "",
    "created_at": "2026-07-31T16:49:00.206Z"
  },
  {
    "id": "2abdb9a6-3e80-41fd-8d29-07a1245dd6e3",
    "date": "2026-07-31",
    "category": "日常",
    "title": "今天也是好好生活的一天",
    "content": "收拾完房间，去菜市场买了把青菜，回来煮了碗面。阳台风挺舒服，发呆十分钟。日子就这样，平平淡淡也挺好。",
    "image_url": "/images/2026-07-31-16.jpg",
    "image_author": "",
    "created_at": "2026-07-31T16:49:02.323Z"
  },
  {
    "id": "da2c6535-9b3e-4998-987a-66cf679b8185",
    "date": "2026-07-31",
    "category": "日常",
    "title": "周末的烟火气",
    "content": "冰箱里剩的菜胡乱炒了一盘，居然挺下饭。收拾完屋子瘫在沙发上，觉得这一天也没白过。",
    "image_url": "/images/2026-07-31-17.jpg",
    "image_author": "",
    "created_at": "2026-07-31T16:49:05.998Z"
  },
  {
    "id": "35e890ce-128f-4470-b305-0300a82ec76a",
    "date": "2026-07-31",
    "category": "日常",
    "title": "一碗面的小确幸",
    "content": "今天自己做了碗面，放了俩鸡蛋，味道居然还不错。收拾完厨房，阳台发了会儿呆，感觉这一天也挺值的。",
    "image_url": "/images/2026-07-31-18.jpg",
    "image_author": "",
    "created_at": "2026-07-31T16:49:07.762Z"
  },
  {
    "id": "718fafef-b599-482d-bf17-59194f67e82d",
    "date": "2026-07-31",
    "category": "日常",
    "title": "阳台放空",
    "content": "在阳台发了十分钟呆，看云慢慢挪。风挺舒服的，突然觉得什么也不干也挺好。",
    "image_url": "/images/2026-07-31-19.jpg",
    "image_author": "",
    "created_at": "2026-07-31T16:49:09.495Z"
  },
  {
    "id": "8ced5522-1732-4136-b81e-cc2b67cf2078",
    "date": "2026-07-30",
    "category": "励志",
    "title": "在路上的意义",
    "content": "闹钟响了三次才爬起来，赶着最后一班地铁回家。累是真的，但离想要的生活，又近了一点点。",
    "image_url": "/images/2026-07-30-0.jpg",
    "image_author": "",
    "created_at": "2026-07-30T16:39:16.902Z"
  },
  {
    "id": "d6edb9c8-3fdf-4596-948b-d173e1e44dcc",
    "date": "2026-07-30",
    "category": "励志",
    "title": "普通人的节奏",
    "content": "闹钟响了三遍才起，加班到地铁末班。没天赋也没运气，就是每天多做一点，慢慢来，也走得远。",
    "image_url": "/images/2026-07-30-1.jpg",
    "image_author": "",
    "created_at": "2026-07-30T16:39:19.225Z"
  },
  {
    "id": "cfba7527-6dfa-4f86-a4a5-352eb406b04c",
    "date": "2026-07-30",
    "category": "励志",
    "title": "日复一日",
    "content": "闹钟响了第六遍才爬起来，可推开窗闻到清晨的味道，觉得今天又赚了。",
    "image_url": "/images/2026-07-30-2.jpg",
    "image_author": "",
    "created_at": "2026-07-30T16:39:22.869Z"
  },
  {
    "id": "b842fa66-2359-47f6-8de8-2eedf7dd00e0",
    "date": "2026-07-30",
    "category": "励志",
    "title": "早晨六点半",
    "content": "闹钟响了两次才爬起来，窗外的路灯还没灭。晨跑时路过早餐摊，蒸笼冒着热气，日子不过是一天天重复中的坚持。",
    "image_url": "/images/2026-07-30-3.jpg",
    "image_author": "",
    "created_at": "2026-07-30T16:39:25.532Z"
  },
  {
    "id": "7a53e464-3faa-40a6-ae96-988c7b02e4e1",
    "date": "2026-07-30",
    "category": "情感",
    "title": "久别的朋友",
    "content": "下雨天，翻到和好朋友的旧照片，嘴角不自觉地扬起来。希望那个熟悉的名字，在另一端也一切安好。",
    "image_url": "/images/2026-07-30-4.jpg",
    "image_author": "",
    "created_at": "2026-07-30T16:39:29.148Z"
  },
  {
    "id": "99dbdc41-e939-4e3f-8243-24a183068313",
    "date": "2026-07-30",
    "category": "情感",
    "title": "雨天想起你",
    "content": "下雨天，翻了翻相册里和朋友们一起吃饭的照片。那些嘻嘻哈哈的日子，原来都好好收藏在手机里了。",
    "image_url": "/images/2026-07-30-5.jpg",
    "image_author": "",
    "created_at": "2026-07-30T16:39:31.144Z"
  },
  {
    "id": "36702145-cdfb-4d04-98bf-a26f9d57753d",
    "date": "2026-07-30",
    "category": "情感",
    "title": "晚餐时刻",
    "content": "和家里人视频，他们正在吃晚饭。隔着屏幕，我好像也闻到了那锅汤的味道。",
    "image_url": "/images/2026-07-30-6.jpg",
    "image_author": "",
    "created_at": "2026-07-30T16:39:36.026Z"
  },
  {
    "id": "b826911d-cb1e-449d-a8be-874aea8b7edb",
    "date": "2026-07-30",
    "category": "情感",
    "title": "关于想念",
    "content": "下雨天，翻到去年和爸妈视频的截图。窗外雨声滴滴答答，忽然很想听我妈唠叨两句。",
    "image_url": "/images/2026-07-30-7.jpg",
    "image_author": "",
    "created_at": "2026-07-30T16:39:38.330Z"
  },
  {
    "id": "167ed8e7-bb9f-4a76-a5cc-46f5a1a431a1",
    "date": "2026-07-30",
    "category": "早安",
    "title": "早晨的节奏",
    "content": "吃完最后一口吐司，咖啡还剩半杯。推开门的瞬间，阳光撞个满怀。今天的计划是：把每个小确幸都尝一遍。",
    "image_url": "/images/2026-07-30-8.jpg",
    "image_author": "",
    "created_at": "2026-07-30T16:39:41.817Z"
  },
  {
    "id": "f7ff82da-b2f5-4b79-a9ec-1b3ebd6a6368",
    "date": "2026-07-30",
    "category": "早安",
    "title": "早安·烟火气",
    "content": "咬一口还冒热气的吐司，咖啡香顺着晨光飘到窗台。新日子，像刚打开的窗户一样透亮。",
    "image_url": "/images/2026-07-30-9.jpg",
    "image_author": "",
    "created_at": "2026-07-30T16:39:43.851Z"
  },
  {
    "id": "dce4dfee-9399-46d5-89a5-6e7da94383ae",
    "date": "2026-07-30",
    "category": "早安",
    "title": "早安·简单日常",
    "content": "晨跑时闻到了刚出炉的面包香，回来冲杯黑咖啡配煎蛋。窗外的光正好，今天也要好好过。",
    "image_url": "/images/2026-07-30-10.jpg",
    "image_author": "",
    "created_at": "2026-07-30T16:39:46.284Z"
  },
  {
    "id": "83f89abb-eaa2-4f8e-8efc-790410f90371",
    "date": "2026-07-30",
    "category": "早安",
    "title": "早安日常",
    "content": "刚烤好的面包配黑咖啡，阳光洒在窗台上。出门前深呼吸一口清晨的空气，今天也要轻快地走。",
    "image_url": "/images/2026-07-30-11.jpg",
    "image_author": "",
    "created_at": "2026-07-30T16:39:48.035Z"
  },
  {
    "id": "ec965fae-30d4-4e0b-b905-3291f2444f35",
    "date": "2026-07-30",
    "category": "晚安",
    "title": "夜晚的温柔",
    "content": "洗完澡窝进被子，窗帘没拉严，月光漏进来一小片。今天所有的疲惫都被热水冲走了，就这样安静地待着吧。",
    "image_url": "/images/2026-07-30-12.jpg",
    "image_author": "",
    "created_at": "2026-07-30T16:39:50.288Z"
  },
  {
    "id": "15900363-2376-476b-a9f0-243b2a9e4285",
    "date": "2026-07-30",
    "category": "晚安",
    "title": "一天结束",
    "content": "洗完澡躺下来，窗外路灯照进来一点光。今天的事都做完了，心也跟着安静下来。",
    "image_url": "/images/2026-07-30-13.jpg",
    "image_author": "",
    "created_at": "2026-07-30T16:39:51.572Z"
  },
  {
    "id": "c9d992a8-4671-4a54-a2c4-bc820ac68008",
    "date": "2026-07-30",
    "category": "晚安",
    "title": "夜话",
    "content": "洗完澡躺下来，关灯前看了眼窗外。路灯亮着，风停了，今天就这样收个尾吧。",
    "image_url": "/images/2026-07-30-14.jpg",
    "image_author": "",
    "created_at": "2026-07-30T16:39:53.548Z"
  },
  {
    "id": "cb3fe7e7-90bb-4565-af2a-28e48c31e886",
    "date": "2026-07-30",
    "category": "晚安",
    "title": "今日已打烊",
    "content": "洗完澡关掉灯，窗帘缝里透进一绺月光。把自己摊平在床上，今天的心事就晾到明天吧。",
    "image_url": "/images/2026-07-30-15.jpg",
    "image_author": "",
    "created_at": "2026-07-30T16:39:56.002Z"
  },
  {
    "id": "6a411aac-a254-40f4-a171-c6c2acb7c4a5",
    "date": "2026-07-30",
    "category": "日常",
    "title": "今晚的厨房实验",
    "content": "煮了锅番茄鸡蛋面，盐放少了，但汤喝完了。洗碗时发现水池里漂着片香菜叶，没舍得扔。",
    "image_url": "/images/2026-07-30-16.jpg",
    "image_author": "",
    "created_at": "2026-07-30T16:40:02.993Z"
  },
  {
    "id": "017a904e-04f5-44ff-8677-f880a4a0f9a2",
    "date": "2026-07-30",
    "category": "日常",
    "title": "日常碎碎念",
    "content": "今天早起去菜市场转了一圈，买了点新鲜蔬菜，回家随便炒了两个菜，吃得还挺香。",
    "image_url": "/images/2026-07-30-17.jpg",
    "image_author": "",
    "created_at": "2026-07-30T16:40:05.875Z"
  },
  {
    "id": "c7b4b61a-7a74-44bf-9232-9bf06986cb38",
    "date": "2026-07-30",
    "category": "日常",
    "title": "周末瞎忙",
    "content": "收拾了一上午屋子，累得够呛，转头去菜场买了把青菜，回来煮个面，简简单单，但心里踏实。",
    "image_url": "/images/2026-07-30-18.jpg",
    "image_author": "",
    "created_at": "2026-07-30T16:40:08.330Z"
  },
  {
    "id": "6e043938-49fa-4efe-aa17-5cf9c5ef2d0b",
    "date": "2026-07-30",
    "category": "日常",
    "title": "周三流水账",
    "content": "买菜回来顺手收拾了冰箱，擦灶台的时候发现上次买的酱油快过期了。晚上煮了锅粥，喝了两碗，撑得在阳台发呆。",
    "image_url": "/images/2026-07-30-19.jpg",
    "image_author": "",
    "created_at": "2026-07-30T16:40:12.526Z"
  },
  {
    "id": "1f3f9bcb-496b-4128-99e4-fc2f49dcf8fe",
    "date": "2026-07-29",
    "category": "励志",
    "title": "早起的理由",
    "content": "闹钟响的时候想过放弃，但想到那些还没实现的可能，还是起来了。天亮前的路最安静，也最清醒。",
    "image_url": "/images/2026-07-29-0.jpg",
    "image_author": "",
    "created_at": "2026-07-29T16:25:04.292Z"
  },
  {
    "id": "c59db755-2d92-4c0f-aea0-c498a154cfc5",
    "date": "2026-07-29",
    "category": "励志",
    "title": "一点一滴",
    "content": "加班后的夜路走多了，终于记住了每盏路灯的位置。原来走得慢没关系，只要没停。",
    "image_url": "/images/2026-07-29-1.jpg",
    "image_author": "",
    "created_at": "2026-07-29T16:25:07.923Z"
  },
  {
    "id": "3d003691-3c06-4715-b79e-b173459ea944",
    "date": "2026-07-29",
    "category": "励志",
    "title": "早班地铁",
    "content": "六点半的闹钟响了第三次，我把它按掉。地铁上每个人都沉默，但我知道，大家都没放弃自己的方向。",
    "image_url": "/images/2026-07-29-2.jpg",
    "image_author": "",
    "created_at": "2026-07-29T16:25:13.274Z"
  },
  {
    "id": "de487519-f948-419e-a821-4b6c72155880",
    "date": "2026-07-29",
    "category": "励志",
    "title": "早起的收获",
    "content": "闹钟响的时候多躺了五分钟，但最终还是起来了。早高峰的地铁依然拥挤，只是今天比昨天早到了一站。",
    "image_url": "/images/2026-07-29-3.jpg",
    "image_author": "",
    "created_at": "2026-07-29T16:25:15.568Z"
  },
  {
    "id": "a0318944-3b7d-4783-a6cd-a8e857da31b9",
    "date": "2026-07-29",
    "category": "情感",
    "title": "热汤与远方",
    "content": "视频里妈妈在厨房忙活，我隔着屏幕喝了一碗热汤。原来想念，是胃先知道的。",
    "image_url": "/images/2026-07-29-4.jpg",
    "image_author": "",
    "created_at": "2026-07-29T16:25:17.703Z"
  },
  {
    "id": "6a513f65-24ea-49f9-8b22-c607e6b398c0",
    "date": "2026-07-29",
    "category": "情感",
    "title": "雨天里的信号",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。想了想，只发了句“你那边下雨了吗”，好像这样就够了。",
    "image_url": "/images/2026-07-29-5.jpg",
    "image_author": "",
    "created_at": "2026-07-29T16:25:19.699Z"
  },
  {
    "id": "560d490e-071e-46f8-baf3-1ada55e5c8d4",
    "date": "2026-07-29",
    "category": "情感",
    "title": "傍晚的温暖",
    "content": "视频接通的那一刻，妈妈在厨房炒菜，弟弟在旁边喊饿。隔着屏幕，听见家里锅碗瓢盆的声音，突然就不那么想家了。",
    "image_url": "/images/2026-07-29-6.jpg",
    "image_author": "",
    "created_at": "2026-07-29T16:25:21.694Z"
  },
  {
    "id": "2b65e3ec-695a-416f-b0be-704b0f79acb5",
    "date": "2026-07-29",
    "category": "情感",
    "title": "慢下来",
    "content": "晚饭后，妈妈突然发来视频，说今天做了我小时候爱吃的菜。聊着聊着，窗外雨停了，心里却下起了一场细雨。",
    "image_url": "/images/2026-07-29-7.jpg",
    "image_author": "",
    "created_at": "2026-07-29T16:25:26.611Z"
  },
  {
    "id": "7583fb8e-cff7-4b8c-8294-1840f1b1a461",
    "date": "2026-07-29",
    "category": "早安",
    "title": "早安·简单节奏",
    "content": "咬一口酥脆的吐司，咖啡香里翻两页书。阳光正好，该出门接住今天的微风了。",
    "image_url": "/images/2026-07-29-8.jpg",
    "image_author": "",
    "created_at": "2026-07-29T16:25:28.754Z"
  },
  {
    "id": "7e09e27a-16b2-40b7-a653-6b548c4316de",
    "date": "2026-07-29",
    "category": "早安",
    "title": "晨间小确幸",
    "content": "咬一口酥脆的吐司，咖啡香混着晨光。窗外的鸟鸣催我出门，今天也想踩着自己的节奏走。",
    "image_url": "/images/2026-07-29-9.jpg",
    "image_author": "",
    "created_at": "2026-07-29T16:25:35.349Z"
  },
  {
    "id": "82d95734-b39c-49a9-947a-44a69df3c99d",
    "date": "2026-07-29",
    "category": "早安",
    "title": "清晨小记",
    "content": "咬一口热吐司，看阳光把咖啡杯的影子拉长。新的一天，从这一口酥脆开始。",
    "image_url": "/images/2026-07-29-10.jpg",
    "image_author": "",
    "created_at": "2026-07-29T16:25:37.455Z"
  },
  {
    "id": "51be7c11-a3b7-4aa7-adb6-1439a22d3f5f",
    "date": "2026-07-29",
    "category": "早安",
    "title": "早晨简史",
    "content": "咬一口吐司，咖啡香混着晨光。出门时风刚好，树叶在头顶哗啦啦地哼歌。",
    "image_url": "/images/2026-07-29-11.jpg",
    "image_author": "",
    "created_at": "2026-07-29T16:25:39.513Z"
  },
  {
    "id": "ef0a496a-8b13-4ea5-8c59-cd4047fe065b",
    "date": "2026-07-29",
    "category": "晚安",
    "title": "一天的句点",
    "content": "关掉最后一盏灯，窗外月光正好。这一天，无论好坏，都在这里停下了。枕头松软，呼吸渐慢。",
    "image_url": "/images/2026-07-29-12.jpg",
    "image_author": "",
    "created_at": "2026-07-29T16:25:41.884Z"
  },
  {
    "id": "a346ef36-83df-4418-8cbd-f05ec4922dcc",
    "date": "2026-07-29",
    "category": "晚安",
    "title": "一天终了",
    "content": "灯灭了，窗帘没拉，就借一点外面的光发呆。这一天走了很久，现在终于可以，把什么都放下。",
    "image_url": "/images/2026-07-29-13.jpg",
    "image_author": "",
    "created_at": "2026-07-29T16:25:44.573Z"
  },
  {
    "id": "f1ece2a0-3c7f-4a52-9c12-da12f18ded8c",
    "date": "2026-07-29",
    "category": "晚安",
    "title": "今夜沉淀",
    "content": "窗外路灯亮着，把夜色烫出一个小洞。窗帘拉上，把今天的自己留在今天。现在，只需要一个柔软的枕头就够。",
    "image_url": "/images/2026-07-29-14.jpg",
    "image_author": "",
    "created_at": "2026-07-29T16:25:48.204Z"
  },
  {
    "id": "ec9f1273-9a5d-41c2-aea3-c68da88d3938",
    "date": "2026-07-29",
    "category": "晚安",
    "title": "关灯前一分钟",
    "content": "洗完澡，关了灯，窗外路灯把树影投在天花板上。今天的事都做完了，剩下这点时间，属于自己。",
    "image_url": "/images/2026-07-29-15.jpg",
    "image_author": "",
    "created_at": "2026-07-29T16:25:53.111Z"
  },
  {
    "id": "a6370e92-b925-4624-b97d-d1390c31c07b",
    "date": "2026-07-29",
    "category": "日常",
    "title": "今天的小确幸",
    "content": "买了把新拖把，一口气把家里拖了个遍。看着亮堂堂的地板，心情莫名好，果然劳动最治愈。",
    "image_url": "/images/2026-07-29-16.jpg",
    "image_author": "",
    "created_at": "2026-07-29T16:25:54.936Z"
  },
  {
    "id": "1ab97e9b-4008-4d25-b9d9-6be86e7e028a",
    "date": "2026-07-29",
    "category": "日常",
    "title": "今晚的厨房",
    "content": "切菜的时候突然想明白一件事——做饭这事儿吧，糊了也没关系，反正就我自己吃。",
    "image_url": "/images/2026-07-29-17.jpg",
    "image_author": "",
    "created_at": "2026-07-29T16:26:00.873Z"
  },
  {
    "id": "38787fd1-46c6-4d0b-a227-812cf905930b",
    "date": "2026-07-29",
    "category": "日常",
    "title": "周四的日常",
    "content": "洗完碗又拖了地，累得在阳台发了会儿呆。路过的风挺凉快，觉得这日子也不算太差。",
    "image_url": "/images/2026-07-29-18.jpg",
    "image_author": "",
    "created_at": "2026-07-29T16:26:03.171Z"
  },
  {
    "id": "79e33089-aeb6-43e0-a30b-7f6d1765d854",
    "date": "2026-07-29",
    "category": "日常",
    "title": "懒人做饭",
    "content": "冰箱里剩的菜随便炒了炒，味道居然还行。吃饱了瘫沙发上，感觉今天又没白过。",
    "image_url": "/images/2026-07-29-19.jpg",
    "image_author": "",
    "created_at": "2026-07-29T16:26:05.289Z"
  }
]
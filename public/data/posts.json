[
  {
    "id": "e90be8a5-961f-4d55-a278-ccef18cd9fd2",
    "date": "2026-09-01",
    "category": "励志",
    "title": "第七天",
    "content": "闹钟响的时候天还没亮，手机屏幕显示6:03。第七天早起，呼吸开始适应清晨的风。原来改变不需要惊天动地，只要比昨天早一点点。",
    "image_url": "/images/2026-09-01-0.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:16:40.508Z"
  },
  {
    "id": "17f767df-2633-4851-a4ee-9af4adb8d60f",
    "date": "2026-09-01",
    "category": "励志",
    "title": "慢一点也没关系",
    "content": "加班到凌晨，电梯里看到镜子里发红的眼睛。突然明白，重要的不是跑多快，而是每一步都算数。",
    "image_url": "/images/2026-09-01-1.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:16:42.352Z"
  },
  {
    "id": "dccfa632-53ea-4039-8a7e-d878a6319a1b",
    "date": "2026-09-01",
    "category": "励志",
    "title": "关于清晨",
    "content": "六点的闹钟响了第三次才爬起来。窗外天刚亮，楼下早餐摊冒着热气。忽然觉得，能准时醒来这件事本身，就是今天的小胜利。",
    "image_url": "/images/2026-09-01-2.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:16:44.495Z"
  },
  {
    "id": "ecbeacef-fb15-48e8-b872-9c8e7ef095bc",
    "date": "2026-09-01",
    "category": "励志",
    "title": "微光",
    "content": "凌晨五点的街道很安静，路灯把我的影子拉得很长。走完最后一公里，突然觉得，每天多坚持一点，就是在给未来的自己铺路。",
    "image_url": "/images/2026-09-01-3.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:16:46.371Z"
  },
  {
    "id": "4cef1a0f-2c06-4f28-a7e6-eacc02ac2218",
    "date": "2026-09-01",
    "category": "情感",
    "title": "饭桌上的想念",
    "content": "今天路过我们常去的那家店，突然想给你打个电话。老位置还亮着灯，只是对面少了你。等你回来，我们再吃一顿，还是点那个辣锅。",
    "image_url": "/images/2026-09-01-4.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:16:48.648Z"
  },
  {
    "id": "34866b15-56f6-4cd8-8cd9-b46d0668359b",
    "date": "2026-09-01",
    "category": "情感",
    "title": "收到回音",
    "content": "下雨天，翻到去年合照，顺手给老友发了句“想你了”。没想到秒回：“正想找你，出来吃面？”原来想念，总能碰巧撞见。",
    "image_url": "/images/2026-09-01-5.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:16:50.634Z"
  },
  {
    "id": "4dccbe81-41e3-4e26-9beb-1200e174bff0",
    "date": "2026-09-01",
    "category": "情感",
    "title": "雨天想起你",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说太多，就问问那边天气怎么样。有些想念，不必刻意表达。",
    "image_url": "/images/2026-09-01-6.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:16:52.348Z"
  },
  {
    "id": "a405cba3-aa13-4926-b970-c851ccb258af",
    "date": "2026-09-01",
    "category": "情感",
    "title": "雨天来信",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说太多，就问了句你那下雨了吗。他回：下了，刚收衣服呢。像从前一样。",
    "image_url": "/images/2026-09-01-7.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:16:54.041Z"
  },
  {
    "id": "22b18158-ca35-46e4-b408-48ee63e7977a",
    "date": "2026-09-01",
    "category": "早安",
    "title": "早啊",
    "content": "吐司烤到微焦，咖啡刚好冒热气。窗外鸟叫了几声，像在催我出门。今天步子轻快些，风也识趣地让了路。",
    "image_url": "/images/2026-09-01-8.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:16:58.266Z"
  },
  {
    "id": "7abd2702-9f6b-47e1-b728-d5430366aaca",
    "date": "2026-09-01",
    "category": "早安",
    "title": "把清晨含在嘴里",
    "content": "煎蛋在锅里滋啦响，面包机弹起的瞬间香得刚好。咬一口，阳光也跟着碎在齿间。新一天，从舌尖开始发亮。",
    "image_url": "/images/2026-09-01-9.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:17:00.164Z"
  },
  {
    "id": "a7304006-eee3-4133-a263-3266a716667e",
    "date": "2026-09-01",
    "category": "早安",
    "title": "早安，光是免费的",
    "content": "窗外的光刚洒进来，烤面包机叮一声，咖啡冒热气。出门前看到楼下猫伸懒腰。生活不复杂，吃饱睡好，走着走着天就亮了。",
    "image_url": "/images/2026-09-01-10.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:17:07.656Z"
  },
  {
    "id": "f369f57b-b20f-410d-b9cf-414590f42dd9",
    "date": "2026-09-01",
    "category": "早安",
    "title": "早安，生活",
    "content": "煎蛋在锅里滋滋响，咖啡香飘满屋。咬一口酥脆吐司，阳光正好落在窗台。晨风凉凉的，吹醒还带着睡意的脸。新的一天，慢慢来，好好过。",
    "image_url": "/images/2026-09-01-11.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:17:11.230Z"
  },
  {
    "id": "b6532d7e-43b1-4047-a552-6c9d4e4b5823",
    "date": "2026-09-01",
    "category": "晚安",
    "title": "今日打烊",
    "content": "窗帘拉上，路灯还亮着。手机放远，被子裹紧。这一天不管圆满还是遗憾，都该收进夜色里了。",
    "image_url": "/images/2026-09-01-12.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:17:12.982Z"
  },
  {
    "id": "a4cefc6b-b805-4fce-9898-2610f282f305",
    "date": "2026-09-01",
    "category": "晚安",
    "title": "夜线",
    "content": "洗完澡躺在床上，窗帘没拉严，月光漏进来一小块。今天的事今天结束，大脑关机，身体慢慢卸下所有力气。",
    "image_url": "/images/2026-09-01-13.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:17:14.955Z"
  },
  {
    "id": "3df84cf5-310f-407b-a6b2-db57dfbe7142",
    "date": "2026-09-01",
    "category": "晚安",
    "title": "夜色收尾",
    "content": "窗帘留一条缝，让月光进来坐坐。今天的事，到此为止。剩下的，交给夜消化，我只要睡意。",
    "image_url": "/images/2026-09-01-14.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:17:18.005Z"
  },
  {
    "id": "b1f4fca5-694c-4595-8225-f6d22f32cae0",
    "date": "2026-09-01",
    "category": "晚安",
    "title": "今日关机",
    "content": "刚关灯，窗外零星几盏灯还醒着，像替我守着夜晚。今天的情绪都收好了，枕头接住所有疲惫，现在只想安静沉下去。",
    "image_url": "/images/2026-09-01-15.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:17:19.750Z"
  },
  {
    "id": "7ff20fb4-30aa-4dfd-8d9f-c60dfb142684",
    "date": "2026-09-01",
    "category": "日常",
    "title": "烟火气",
    "content": "路过菜市场顺手买了把青菜，回来煮了锅汤。阳台风挺大，喝着汤看对面窗户亮灯，感觉日子就这样，挺踏实。",
    "image_url": "/images/2026-09-01-16.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:17:21.909Z"
  },
  {
    "id": "0aff0b8c-2317-4c43-9867-12780db5c2ca",
    "date": "2026-09-01",
    "category": "日常",
    "title": "周末的仪式感",
    "content": "花一下午收拾了屋子，扔了三袋杂物，阳台擦得能反光。累是累了点，但看哪儿都顺眼，这感觉真上头。",
    "image_url": "/images/2026-09-01-17.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:17:23.869Z"
  },
  {
    "id": "5f9c803d-ad5a-4fa4-a13e-eb15619242ec",
    "date": "2026-09-01",
    "category": "日常",
    "title": "周末的慢生活",
    "content": "睡到自然醒，去菜市场买了把青菜，回来煮了锅粥。阳台发了会儿呆，看云，看楼下遛狗的人。日子就这样，挺好。",
    "image_url": "/images/2026-09-01-18.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:17:27.017Z"
  },
  {
    "id": "841d3fc8-37f8-4107-ac35-35cb36ce4320",
    "date": "2026-09-01",
    "category": "日常",
    "title": "好好吃饭",
    "content": "今天自己做了碗面，味道居然还不错。吃完把厨房收拾干净，窗外天也黑了。平凡日子，能这样踏踏实实过，也挺好。",
    "image_url": "/images/2026-09-01-19.jpg",
    "image_author": "",
    "created_at": "2026-09-01T18:17:29.307Z"
  },
  {
    "id": "0afeed83-04fd-46f3-9a4e-3e155dece7f3",
    "date": "2026-08-31",
    "category": "励志",
    "title": "闹钟响起的时候",
    "content": "六点的闹钟响了三次才爬起来，天还黑着。但想想昨晚那页读完的书，今天地铁上还能再翻几页，忽然觉得这趟早班车也值得赶。",
    "image_url": "/images/2026-08-31-0.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:43:38.475Z"
  },
  {
    "id": "b271fb64-d072-4dfb-91cf-1b375ee7c874",
    "date": "2026-08-31",
    "category": "励志",
    "title": "凌晨六点的闹钟",
    "content": "凌晨六点的闹钟响了三次才爬起来。窗外的天还暗着，但想到昨天那个没攻克的难题，突然觉得早起也没那么难熬。",
    "image_url": "/images/2026-08-31-1.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:43:40.299Z"
  },
  {
    "id": "c6441630-0965-44b9-8dfa-6f79ca3f28ea",
    "date": "2026-08-31",
    "category": "励志",
    "title": "自动导航",
    "content": "闹钟响的时候犹豫了三秒，还是起来了。晨光透过窗帘，像极了我现在的状态——不算明亮，但足够看清前路。",
    "image_url": "/images/2026-08-31-2.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:43:42.927Z"
  },
  {
    "id": "211d0cac-7900-4e5a-93be-26cedffc2fad",
    "date": "2026-08-31",
    "category": "励志",
    "title": "六点的闹钟",
    "content": "闹钟响的时候天还没亮，但想到今天要追的那个目标，还是爬起来了。窗外雾蒙蒙的，可我知道走起来就会亮。",
    "image_url": "/images/2026-08-31-3.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:43:49.077Z"
  },
  {
    "id": "8c9a16a0-cf66-4918-bacc-baf976ce1e2e",
    "date": "2026-08-31",
    "category": "情感",
    "title": "雨天来电",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。其实也没什么事，就是想说，今天雨声很好听。",
    "image_url": "/images/2026-08-31-4.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:43:52.675Z"
  },
  {
    "id": "ec6501d6-f3b7-4087-911c-9f260f0765b6",
    "date": "2026-08-31",
    "category": "情感",
    "title": "一通电话",
    "content": "晚饭后给爸妈打了个视频，他们正为电视里的小品笑得前仰后合。挂了电话，屋里安静得能听见自己的心跳，突然好想回家吃饭。",
    "image_url": "/images/2026-08-31-5.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:43:55.009Z"
  },
  {
    "id": "7d492ef2-c933-42c7-8fa7-4a0a17265acd",
    "date": "2026-08-31",
    "category": "情感",
    "title": "晚饭后的电话",
    "content": "饭后散步，手机响了，是妈妈打来的。聊了半小时家常，挂断时路灯刚好亮起。原来被惦记的感觉，就是有人愿意听你说些无关紧要的事。",
    "image_url": "/images/2026-08-31-6.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:00.519Z"
  },
  {
    "id": "fc06accc-0e44-4ec2-88ff-3daef1bb3d4f",
    "date": "2026-08-31",
    "category": "情感",
    "title": "雨天的牵挂",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说太多，就问问那边天气怎样，伞还够不够用。",
    "image_url": "/images/2026-08-31-7.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:01.916Z"
  },
  {
    "id": "969fe010-5d18-4814-8b45-60d46a809e00",
    "date": "2026-08-31",
    "category": "早安",
    "title": "晨光正好·n6l",
    "content": "咖啡刚冲好，窗外鸟叫得勤快。咬一口烤过的面包边，脆得掉渣。今天不赶时间，慢慢走，太阳已经暖了。",
    "image_url": "/images/2026-08-31-8.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:08.892Z"
  },
  {
    "id": "70d94133-06ec-4035-a273-0dc29d24d2c0",
    "date": "2026-08-31",
    "category": "早安",
    "title": "早安，晨光正好",
    "content": "煎蛋在锅里滋滋响，咖啡香飘满屋。咬一口酥脆吐司，窗外的风刚好把树叶吹得沙沙响。今天的开场，简单又刚好。",
    "image_url": "/images/2026-08-31-9.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:12.104Z"
  },
  {
    "id": "ddcab959-f7f6-4fd3-9e16-eca28c256f6c",
    "date": "2026-08-31",
    "category": "早安",
    "title": "晨光与吐司",
    "content": "煎蛋在锅里滋滋响，咖啡香飘满厨房。阳光正好落在餐盘边沿，吃完这口就出门吧，风很轻，路还长。",
    "image_url": "/images/2026-08-31-10.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:13.710Z"
  },
  {
    "id": "5719c9b6-07f6-49c8-9d70-ca92ece40386",
    "date": "2026-08-31",
    "category": "早安",
    "title": "晨光里的烟火气",
    "content": "吐司边烤得刚好，煎蛋在锅里滋滋响。咖啡冒热气时，阳光也溜进窗台。吃饱出门，风很轻，路很长，日子慢慢过。",
    "image_url": "/images/2026-08-31-11.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:15.231Z"
  },
  {
    "id": "ccb6a263-291d-48ec-9f10-14086ae6f3ba",
    "date": "2026-08-31",
    "category": "晚安",
    "title": "夜晚的收尾",
    "content": "热水冲走了一天的黏腻，窗帘拉上，城市的光还有一点透进来。今天所有的声音，都关在门外面了。",
    "image_url": "/images/2026-08-31-12.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:18.225Z"
  },
  {
    "id": "d17d5bc6-d7a1-4ede-ab9b-15ef5fbca95e",
    "date": "2026-08-31",
    "category": "晚安",
    "title": "夜归处",
    "content": "热水带走了今天的尘土，灯一关，窗外的光像稀释的蜂蜜。枕头上有太阳晒过的味道，此刻连呼吸都慢下来了。",
    "image_url": "/images/2026-08-31-13.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:19.846Z"
  },
  {
    "id": "be23be81-6fef-400e-8574-626f3a452709",
    "date": "2026-08-31",
    "category": "晚安",
    "title": "灯熄之前",
    "content": "窗外零星几点灯火，和我一样还没睡。被子晒过太阳的味道，足够抚平今天的褶皱。明天的事，明天再想。今晚，我只要月光落进窗帘的缝隙。",
    "image_url": "/images/2026-08-31-14.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:21.685Z"
  },
  {
    "id": "cf89059c-e86e-4bfd-8d3d-8ea565eb0615",
    "date": "2026-08-31",
    "category": "晚安",
    "title": "关灯前的清醒",
    "content": "窗外的灯光一盏盏暗下去，我数到第七盏时，发现自己今天忘了看晚霞。热水冲走疲惫，手机搁在床头，此刻只有呼吸声陪着我。今天就到这里吧，把没说完的话留给明天。",
    "image_url": "/images/2026-08-31-15.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:25.241Z"
  },
  {
    "id": "192e7b09-c579-4751-957c-23bd2ced8ee1",
    "date": "2026-08-31",
    "category": "日常",
    "title": "自己动手",
    "content": "今天试着做了个番茄炒蛋，卖相一般但味道居然还行。收拾完厨房瘫在沙发上，突然觉得一个人住也挺好。",
    "image_url": "/images/2026-08-31-16.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:32.039Z"
  },
  {
    "id": "d630378d-7822-43f0-8073-727a5179a17e",
    "date": "2026-08-31",
    "category": "日常",
    "title": "生活的小确幸",
    "content": "今天自己做了碗面，味道居然还不错。收拾完房间，阳台发了会儿呆，傍晚的风凉快得刚好。日子嘛，简单点挺好。",
    "image_url": "/images/2026-08-31-17.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:34.477Z"
  },
  {
    "id": "93a4f514-a3ea-4e58-bf65-561214786397",
    "date": "2026-08-31",
    "category": "日常",
    "title": "周末的厨房",
    "content": "周末在家收拾完屋子，顺手煮了锅粥。切菜的时候发现冰箱里那根黄瓜终于被用掉了，成就感莫名爆棚。",
    "image_url": "/images/2026-08-31-18.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:36.540Z"
  },
  {
    "id": "9105214f-5814-45ea-9d3d-10617f26eefa",
    "date": "2026-08-31",
    "category": "日常",
    "title": "做饭日常",
    "content": "今天自己做了碗面，味道居然还不错。收拾完屋子又去小区遛了一圈，日子平平淡淡，但挺舒服的。",
    "image_url": "/images/2026-08-31-19.jpg",
    "image_author": "",
    "created_at": "2026-08-31T20:44:39.423Z"
  },
  {
    "id": "6e2d8cf4-c0da-40d5-b58c-6b7c9a1344dc",
    "date": "2026-08-30",
    "category": "励志",
    "title": "夜路",
    "content": "十一点的地铁末班车，人少了很多。今天又学了两个新东西，窗外的路灯连成线，像在给我指方向。",
    "image_url": "/images/2026-08-30-0.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:30:59.273Z"
  },
  {
    "id": "6f6477e1-6b27-47ec-91c2-4487e2c72a19",
    "date": "2026-08-30",
    "category": "励志",
    "title": "早七点的光",
    "content": "闹钟响了三遍才爬起来，咖啡灌下去的时候天刚亮。地铁里挤成沙丁鱼，可窗外那缕阳光正好打在脸上。日子不就是这样，摸着黑往前走，走着走着天就亮了。",
    "image_url": "/images/2026-08-30-1.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:01.467Z"
  },
  {
    "id": "44c1fa60-c98d-48bf-84d8-faafa0e4e4a2",
    "date": "2026-08-30",
    "category": "励志",
    "title": "在裂缝里生根",
    "content": "六点半的闹钟响了三次，我数着地铁的报站声，把昨天没做完的事又默念了一遍。城市还没醒透，但我的植物已经朝着光转了方向。",
    "image_url": "/images/2026-08-30-2.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:04.833Z"
  },
  {
    "id": "7ab46503-4db5-4a68-a9a0-45a545e2d78f",
    "date": "2026-08-30",
    "category": "励志",
    "title": "晨光里的答案",
    "content": "六点的闹钟响了三次才起来，电梯里遇见的晨跑大爷比我还精神。路过早餐摊，老板娘记得我的口味。日子就这样普通地重复着，但今天比昨天多跑了半公里。",
    "image_url": "/images/2026-08-30-3.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:08.799Z"
  },
  {
    "id": "c3b8e7ca-3d7d-4a9e-bf94-4f4f23834aad",
    "date": "2026-08-30",
    "category": "情感",
    "title": "雨天信号",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。最后只发了句“你那边下雨了吗”，对方秒回“下了，正想问你呢”。",
    "image_url": "/images/2026-08-30-4.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:11.108Z"
  },
  {
    "id": "743257ac-d5c1-4e71-9b2a-a404b593a364",
    "date": "2026-08-30",
    "category": "情感",
    "title": "下雨天的消息",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没有什么特别的事，就是想说，外面下雨了，你那边还好吗。",
    "image_url": "/images/2026-08-30-5.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:13.071Z"
  },
  {
    "id": "ac62cc2e-53ae-4d3c-9cdc-5090100faf86",
    "date": "2026-08-30",
    "category": "情感",
    "title": "隔空碰杯",
    "content": "和爸妈视频，各自端着晚饭，隔着屏幕碰了碰杯。菜还是那些菜，只是笑声变成了双份的。",
    "image_url": "/images/2026-08-30-6.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:14.829Z"
  },
  {
    "id": "0e5f52f6-1e8a-4631-af92-299034589f30",
    "date": "2026-08-30",
    "category": "情感",
    "title": "忽然想你了",
    "content": "下雨天，窗外的雨声刚好盖过心跳。翻到去年今日的照片，突然想给好久没联系的人发条消息：最近好吗？",
    "image_url": "/images/2026-08-30-7.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:20.074Z"
  },
  {
    "id": "9fa5b6e8-f7ab-4f84-8dcb-7c7e52cb897c",
    "date": "2026-08-30",
    "category": "早安",
    "title": "早起的奖励",
    "content": "咬下第一口酥脆吐司时，阳光刚好爬上桌角。煎蛋边缘微焦，咖啡冒热气。生活的小确幸，就藏在这些准时发生的日常里。",
    "image_url": "/images/2026-08-30-8.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:22.843Z"
  },
  {
    "id": "c2d3f029-16a1-42f2-b8e4-b29cebb4eb34",
    "date": "2026-08-30",
    "category": "早安",
    "title": "晨光与咖啡",
    "content": "窗外鸟叫比闹钟早十分钟。煎蛋在锅里滋滋响，咖啡香飘满屋。推开门，风里有桂花味，今天也要好好走。}",
    "image_url": "/images/2026-08-30-9.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:24.826Z"
  },
  {
    "id": "eaf655b1-e586-4297-8c1f-98180e8da2a2",
    "date": "2026-08-30",
    "category": "早安",
    "title": "晨光刚好",
    "content": "咬下第一口烤吐司时，阳光正好落在桌角。窗外的鸟叫混着咖啡香，忽然觉得，连赶路都值得期待。",
    "image_url": "/images/2026-08-30-10.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:26.750Z"
  },
  {
    "id": "3aca405a-a4e0-4b6a-adf4-95476918884e",
    "date": "2026-08-30",
    "category": "早安",
    "title": "闹钟响了三遍",
    "content": "阳光斜斜落进厨房，煎蛋边沿微焦。面包机叮一声，拿铁刚好不烫嘴。出门抬头，云朵像刚睡醒的猫在伸懒腰。",
    "image_url": "/images/2026-08-30-11.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:28.756Z"
  },
  {
    "id": "b0028594-e85b-473b-abf2-08ed05129690",
    "date": "2026-08-30",
    "category": "晚安",
    "title": "今日终章",
    "content": "窗帘留了一道缝，夜光漫进来，像替世界按了静音。头发还湿着，这一天终于褪成背景音。",
    "image_url": "/images/2026-08-30-12.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:30.464Z"
  },
  {
    "id": "24040c08-68b8-455d-a203-acecb8c949da",
    "date": "2026-08-30",
    "category": "晚安",
    "title": "夜已深",
    "content": "洗完澡躺在床上，窗帘缝里漏进几缕路灯。手机放着白噪音，窗外的城市慢慢安静下来。今天就到这里吧，让所有的疲惫都留在灯光熄灭之前。",
    "image_url": "/images/2026-08-30-13.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:34.758Z"
  },
  {
    "id": "db004b25-d835-4caf-b9da-a830c22f8505",
    "date": "2026-08-30",
    "category": "晚安",
    "title": "夜的收尾",
    "content": "洗完澡躺下来，窗外的灯一盏盏灭了。手机调暗，屏幕的蓝光也变得柔软。今天所有声响都沉进棉被里，此刻只需呼吸，就很好。",
    "image_url": "/images/2026-08-30-14.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:36.443Z"
  },
  {
    "id": "5cbc188c-1f51-4fd3-be22-8eeb2d6ec5a5",
    "date": "2026-08-30",
    "category": "晚安",
    "title": "把今天放下",
    "content": "灯一关，窗外的城市就亮起来了。热水冲走了白天的声音，现在只剩呼吸和心跳，慢悠悠的。这一天，就让它留在浴室的雾气里吧。",
    "image_url": "/images/2026-08-30-15.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:40.301Z"
  },
  {
    "id": "fd1b9770-d017-4f20-889d-9a74da64a1eb",
    "date": "2026-08-30",
    "category": "日常",
    "title": "今天的厨房战绩",
    "content": "今天自己做了碗面，味道居然还不错。厨房收拾干净那会儿，突然觉得过日子也就这么回事，舒服。",
    "image_url": "/images/2026-08-30-16.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:42.506Z"
  },
  {
    "id": "18136f37-30fb-43e0-b1a3-3361e4d4970c",
    "date": "2026-08-30",
    "category": "日常",
    "title": "一人食",
    "content": "今天自己做了碗面，味道居然还不错。卖相一般但汤底很鲜，边吃边刷剧，这日子过得也还行。",
    "image_url": "/images/2026-08-30-17.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:44.551Z"
  },
  {
    "id": "ec40bd87-23c4-4edd-a152-b58eec81f4e4",
    "date": "2026-08-30",
    "category": "日常",
    "title": "阳台发呆",
    "content": "收拾完屋子，阳台站了会儿。风挺舒服的，楼下有人遛狗，晚霞粉粉的。突然觉得这样啥也不干也挺好。",
    "image_url": "/images/2026-08-30-18.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:46.287Z"
  },
  {
    "id": "e264e7c1-bbf6-4415-8ebe-b17ebb0c2a6d",
    "date": "2026-08-30",
    "category": "日常",
    "title": "周末的葱",
    "content": "周末买了把葱，做晚饭时发现烂了一半。挑着好的切了，反正过日子也一样，好的能用就行。",
    "image_url": "/images/2026-08-30-19.jpg",
    "image_author": "",
    "created_at": "2026-08-30T18:31:48.908Z"
  },
  {
    "id": "170f2915-1dfa-4fca-b38e-ad317d2a2faa",
    "date": "2026-08-29",
    "category": "励志",
    "title": "方向",
    "content": "六点半的闹钟响了三次才爬起来，窗外天还蒙蒙亮。昨晚的疲惫没散尽，但想到离想去的那个地方又近了一步，困意忽然就不算什么了。",
    "image_url": "/images/2026-08-29-0.jpg",
    "image_author": "",
    "created_at": "2026-08-29T18:14:26.077Z"
  },
  {
    "id": "583d96e3-51a1-4ba4-9eac-e8aa68b6eeed",
    "date": "2026-08-29",
    "category": "励志",
    "title": "细水长流",
    "content": "闹钟响了三次才爬起来，晨跑三公里，午休背单词，深夜改方案。日子平淡如水，但我知道每滴都在往海里流。",
    "image_url": "/images/2026-08-29-1.jpg",
    "image_author": "",
    "created_at": "2026-08-29T18:14:29.446Z"
  },
  {
    "id": "5cf7871f-4d33-44cf-9f80-ea0b67b5bfa1",
    "date": "2026-08-29",
    "category": "励志",
    "title": "慢慢来",
    "content": "下班路上买了束花，老板多送了两支。日子虽然普通，但总有那么些小惊喜，让人愿意继续往前走。",
    "image_url": "/images/2026-08-29-2.jpg",
    "image_author": "",
    "created_at": "2026-08-29T18:14:31.313Z"
  },
  {
    "id": "6e4d5445-efe3-433e-98a0-bd95904aa148",
    "date": "2026-08-29",
    "category": "励志",
    "title": "晨光",
    "content": "闹钟响第五次才爬起来，泡咖啡时发现昨晚的月亮还挂在窗边。日子像地铁一样准时，挤一点没关系，只要方向是对的。",
    "image_url": "/images/2026-08-29-3.jpg",
    "image_author": "",
    "created_at": "2026-08-29T18:14:33.868Z"
  },
  {
    "id": "ce8e5fd8-d392-463a-bca0-96420ceadc48",
    "date": "2026-08-29",
    "category": "情感",
    "title": "热气腾腾",
    "content": "今晚的火锅咕嘟咕嘟冒泡，对面坐的是我最熟的陌生人。笑到一半突然安静，原来我们都学会了，把想念藏进夹菜的筷子尖。",
    "image_url": "/images/2026-08-29-4.jpg",
    "image_author": "",
    "created_at": "2026-08-29T18:14:40.864Z"
  },
  {
    "id": "5e0f08fc-42ba-44b9-961d-e9452f1b0dd0",
    "date": "2026-08-29",
    "category": "情感",
    "title": "灯光",
    "content": "加班回家路上，看见小区门口那盏路灯下，妈妈正站着等我。她手里还拎着一袋热乎乎的糖炒栗子。",
    "image_url": "/images/2026-08-29-5.jpg",
    "image_author": "",
    "created_at": "2026-08-29T18:14:44.772Z"
  },
  {
    "id": "abab6d62-16f4-4137-8e9b-9b8fdcefe01c",
    "date": "2026-08-29",
    "category": "情感",
    "title": "雨天备忘",
    "content": "下雨天，突然想起很久没联系的朋友。点开对话框，删了又写，最后发了句：你那边下雨了吗？",
    "image_url": "/images/2026-08-29-6.jpg",
    "image_author": "",
    "created_at": "2026-08-29T18:14:47.888Z"
  },
  {
    "id": "5b6f0b22-8731-455c-a2de-cc16f266aaac",
    "date": "2026-08-29",
    "category": "情感",
    "title": "旧友来电",
    "content": "下雨天，手机屏幕亮起，是好久没联系的老友。聊了半小时，挂断时雨刚好停了。原来有些人，一直住在天气预报里。",
    "image_url": "/images/2026-08-29-7.jpg",
    "image_author": "",
    "created_at": "2026-08-29T18:14:50.913Z"
  },
  {
    "id": "9051e62a-ab2f-49aa-bef4-757e1ec80be0",
    "date": "2026-08-29",
    "category": "早安",
    "title": "清晨的小确幸",
    "content": "吐司边烤得刚好，咖啡香飘满屋。窗外的光把影子拉得老长，我踩着它出门，连风都带着甜味。",
    "image_url": "/images/2026-08-29-8.jpg",
    "image_author": "",
    "created_at": "2026-08-29T18:14:53.845Z"
  },
  {
    "id": "382007d3-a374-4577-ab3d-ea12b819db32",
    "date": "2026-08-29",
    "category": "早安",
    "title": "早安，空腹的胃和清醒的脑",
    "content": "阳光斜进厨房，吐司边缘微焦。咖啡香绕过指间，今天的第一口温热，足够对抗所有不确定。",
    "image_url": "/images/2026-08-29-9.jpg",
    "image_author": "",
    "created_at": "2026-08-29T18:14:55.654Z"
  },
  {
    "id": "36d314d4-4bf2-42ed-9ae8-f48bdb133ca7",
    "date": "2026-08-29",
    "category": "早安",
    "title": "晨光与热咖啡",
    "content": "阳光斜斜落在餐桌上，吐司边角微焦。咖啡冒热气时，恰好楼下传来鸟叫。推开门的瞬间，风是甜的。",
    "image_url": "/images/2026-08-29-10.jpg",
    "image_author": "",
    "created_at": "2026-08-29T18:14:59.718Z"
  },
  {
    "id": "11294c7d-8e7b-4372-be33-f810a1215feb",
    "date": "2026-08-29",
    "category": "早安",
    "title": "晨光与煎蛋",
    "content": "烤吐司的边角脆脆的，太阳刚好爬上对面楼顶。咬一口煎蛋，今天的第一口热乎气儿，把睡意都赶跑了。",
    "image_url": "/images/2026-08-29-11.jpg",
    "image_author": "",
    "created_at": "2026-08-29T18:15:01.107Z"
  },
  {
    "id": "f7eaac16-ab70-4bec-bf35-edea3680b41d",
    "date": "2026-08-29",
    "category": "晚安",
    "title": "夜已收好",
    "content": "洗完澡躺在床上，窗外路灯把树影投进天花板。今天所有的话都说完了，剩下的安静，正好留给自己。",
    "image_url": "/images/2026-08-29-12.jpg",
    "image_author": "",
    "created_at": "2026-08-29T18:15:02.916Z"
  },
  {
    "id": "13ab6b9a-a696-4632-8fb6-c9801b67ffe5",
    "date": "2026-08-29",
    "category": "晚安",
    "title": "夜的句号",
    "content": "洗完澡躺下来，空调嗡嗡响，窗外路灯亮着。今天所有的情绪都打包放好，现在只属于这盏小夜灯。困意来了，就顺着它睡去。",
    "image_url": "/images/2026-08-29-13.jpg",
    "image_author": "",
    "created_at": "2026-08-29T18:15:07.691Z"
  },
  {
    "id": "80ad2e3d-ae33-4cd6-9fe2-ab1217942abd",
    "date": "2026-08-29",
    "category": "晚安",
    "title": "夜色收容所",
    "content": "灯关了，城市的嗡鸣还在远处。今天所有没说出口的话，都交给夜色收容。翻个身，床单的褶皱像波浪，我浮在上面，慢慢下沉。",
    "image_url": "/images/2026-08-29-14.jpg",
    "image_author": "",
    "created_at": "2026-08-29T18:15:09.836Z"
  },
  {
    "id": "570034a5-0c25-4f71-b4b7-80b0f9cc0b18",
    "date": "2026-08-29",
    "category": "晚安",
    "title": "夜的门槛",
    "content": "关灯前看了眼窗外，万家灯火也困了。枕头上还有洗发水的余香，今天所有的事，都算数了。",
    "image_url": "/images/2026-08-29-15.jpg",
    "image_author": "",
    "created_at": "2026-08-29T18:15:11.764Z"
  },
  {
    "id": "91bbd47f-6775-4747-a66f-c0a7c92ebdc1",
    "date": "2026-08-29",
    "category": "日常",
    "title": "今天的小日子",
    "content": "收拾完屋子，顺手煮了锅粥，配点咸菜，比外卖香。窗台的风凉嗖嗖的，就这么发呆坐了一会儿，也挺好。",
    "image_url": "/images/2026-08-29-16.jpg",
    "image_author": "",
    "created_at": "2026-08-29T18:15:13.596Z"
  },
  {
    "id": "338fe84e-0323-4f0d-a841-763e5352bf24",
    "date": "2026-08-29",
    "category": "日常",
    "title": "收拾完的快乐",
    "content": "把家里里里外外擦了一遍，衣服也叠了。现在坐沙发上一抬头，看哪都顺眼，感觉自己真了不起。",
    "image_url": "/images/2026-08-29-17.jpg",
    "image_author": "",
    "created_at": "2026-08-29T18:15:15.041Z"
  },
  {
    "id": "5dfdf071-29c7-4f82-8b4f-bb7dc7c6f459",
    "date": "2026-08-29",
    "category": "日常",
    "title": "阳台放空",
    "content": "下午在阳台发了半小时呆，看了会儿云，听了会儿鸟叫。啥也没干，但感觉脑子被重启了一遍。",
    "image_url": "/images/2026-08-29-18.jpg",
    "image_author": "",
    "created_at": "2026-08-29T18:15:18.154Z"
  },
  {
    "id": "2f03533b-d9da-4667-8232-b955d9d2ee3f",
    "date": "2026-08-29",
    "category": "日常",
    "title": "厨房初体验",
    "content": "今天试着做了个番茄炒蛋，卖相不咋地但味道还行。收拾完厨房瘫在沙发上，突然觉得这样也挺好。",
    "image_url": "/images/2026-08-29-19.jpg",
    "image_author": "",
    "created_at": "2026-08-29T18:15:19.736Z"
  },
  {
    "id": "7c027152-8488-4740-be1c-e5c706b7858c",
    "date": "2026-08-28",
    "category": "励志",
    "title": "凌晨四点半",
    "content": "凌晨四点半的闹钟响了第六次，窗外还黑着。可当我把今天要做的三件事写在便签上时，突然觉得，光是自己点亮的那盏台灯，就已经在替我喊开始了。",
    "image_url": "/images/2026-08-28-0.jpg",
    "image_author": "",
    "created_at": "2026-08-28T00:18:53.930Z"
  },
  {
    "id": "5a0377b3-db8a-43f7-bc69-f5e69a1c60e2",
    "date": "2026-08-28",
    "category": "励志",
    "title": "今天的闹钟",
    "content": "六点半的闹钟响了第三次才爬起来。晨光里跑完五公里，汗水把困意都冲走了。原来坚持不是咬牙硬撑，是每天多对自己说一次：再试试。",
    "image_url": "/images/2026-08-28-1.jpg",
    "image_author": "",
    "created_at": "2026-08-28T00:18:55.681Z"
  },
  {
    "id": "c700ac41-18ac-4b12-a54d-43eadd880e68",
    "date": "2026-08-28",
    "category": "励志",
    "title": "第六次早起",
    "content": "闹钟响时天还黑着，窗帘缝透进一线光。昨晚的疲惫还在，但今天的地铁会准时到站。那些看似重复的日子，正在悄悄改变方向。",
    "image_url": "/images/2026-08-28-2.jpg",
    "image_author": "",
    "created_at": "2026-08-28T00:18:58.036Z"
  },
  {
    "id": "ef0a391a-d2e7-47e6-a71a-600de3f1f0aa",
    "date": "2026-08-28",
    "category": "励志",
    "title": "清晨六点半",
    "content": "天还没亮透，楼下的早餐摊已经冒热气了。豆浆入喉的瞬间，忽然明白：日子再苦，也总有人比你起得更早，把生活熬成了甜。",
    "image_url": "/images/2026-08-28-3.jpg",
    "image_author": "",
    "created_at": "2026-08-28T00:19:01.439Z"
  },
  {
    "id": "9b0285b5-a1b7-4313-86c6-767d09c5750b",
    "date": "2026-08-28",
    "category": "情感",
    "title": "一顿饭的牵挂",
    "content": "今晚的菜有点咸，想起妈妈总说少吃外卖。视频接通，她正在包饺子，问我什么时候回家。原来牵挂，是隔着屏幕也能闻到的饭香。",
    "image_url": "/images/2026-08-28-4.jpg",
    "image_author": "",
    "created_at": "2026-08-28T00:19:07.244Z"
  },
  {
    "id": "10b729ae-46eb-408d-89ee-990bc624c1b2",
    "date": "2026-08-28",
    "category": "情感",
    "title": "下雨天的想念",
    "content": "下雨天，突然想起很久没联系的老友。翻到旧照片，发现时间没冲淡什么，只是把想念藏进了日常里。",
    "image_url": "/images/2026-08-28-5.jpg",
    "image_author": "",
    "created_at": "2026-08-28T00:19:09.068Z"
  },
  {
    "id": "dbdf585a-33c6-40dc-a600-4791ed91cc87",
    "date": "2026-08-28",
    "category": "情感",
    "title": "雨天的消息",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没别的事，就是问问她那边天气怎么样，伞还够不够用。",
    "image_url": "/images/2026-08-28-6.jpg",
    "image_author": "",
    "created_at": "2026-08-28T00:19:10.798Z"
  },
  {
    "id": "7d90e7af-1604-48b7-b051-406510838461",
    "date": "2026-08-28",
    "category": "情感",
    "title": "手机里的旧号码",
    "content": "整理通讯录，翻到那个很久没拨的号码。想起上次通话还是夏天，窗外的雨声和那天很像，就发条消息问了句最近好吗。",
    "image_url": "/images/2026-08-28-7.jpg",
    "image_author": "",
    "created_at": "2026-08-28T00:19:12.484Z"
  },
  {
    "id": "5a48b550-245b-439f-8bbe-857ccfe3a30b",
    "date": "2026-08-28",
    "category": "早安",
    "title": "晨光正好",
    "content": "七点的阳光刚好落在吐司边，煎蛋有点焦，咖啡烫了嘴。楼下桂花开了，风都是甜的。今天也慢慢来。",
    "image_url": "/images/2026-08-28-8.jpg",
    "image_author": "",
    "created_at": "2026-08-28T00:19:14.184Z"
  },
  {
    "id": "6f510b59-d0ac-41ee-adcf-41728a58a988",
    "date": "2026-08-28",
    "category": "早安",
    "title": "早餐的仪式感",
    "content": "吐司烤到微焦，煎蛋边缘脆脆的。阳光刚好落在餐桌上，啜一口咖啡，今天也从简单的满足开始。",
    "image_url": "/images/2026-08-28-9.jpg",
    "image_author": "",
    "created_at": "2026-08-28T00:19:15.819Z"
  },
  {
    "id": "7f4ec16d-9bcf-4141-8956-6db8f79caddb",
    "date": "2026-08-28",
    "category": "早安",
    "title": "窗边晨光",
    "content": "吐司边烤得刚好，咖啡香飘满屋。推开窗，风把昨夜的梦吹散。今天也要好好过，哪怕只是走一条熟悉的路。",
    "image_url": "/images/2026-08-28-10.jpg",
    "image_author": "",
    "created_at": "2026-08-28T00:19:19.918Z"
  },
  {
    "id": "5f3f632c-a4c3-4f3c-9c11-95c30d6caad1",
    "date": "2026-08-28",
    "category": "早安",
    "title": "早起的鸟有虫吃",
    "content": "晨光刚爬上窗台，咖啡香已经飘满屋。吐司脆脆的，煎蛋嫩嫩的，出门前还顺手拍了张天空。新的一天，从好好照顾自己开始。",
    "image_url": "/images/2026-08-28-11.jpg",
    "image_author": "",
    "created_at": "2026-08-28T00:19:22.041Z"
  },
  {
    "id": "4300db7e-cc6d-491c-90f3-a1a960f06f14",
    "date": "2026-08-28",
    "category": "晚安",
    "title": "关灯时刻",
    "content": "热水冲走了今天的疲惫，窗帘缝里漏进几缕路灯，手机屏幕暗下去，房间就只剩呼吸声了。今天就到这里吧，日子不就是这样一天天安静地过。",
    "image_url": "/images/2026-08-28-12.jpg",
    "image_author": "",
    "created_at": "2026-08-28T00:19:24.148Z"
  },
  {
    "id": "76d0dee5-4dfd-4621-8859-cb4ab40ded9f",
    "date": "2026-08-28",
    "category": "晚安",
    "title": "安静的收尾",
    "content": "洗完澡躺在床上，暖气烘着被窝。窗外路灯把树影投在天花板上，晃晃悠悠的。今天所有情绪都清零了，就到这里吧。",
    "image_url": "/images/2026-08-28-13.jpg",
    "image_author": "",
    "created_at": "2026-08-28T00:19:26.827Z"
  },
  {
    "id": "32f8d494-43b2-44a4-aacf-03218f6f81ba",
    "date": "2026-08-28",
    "category": "晚安",
    "title": "夜里的一页",
    "content": "洗完澡躺在床上，头发还没干透。窗外路灯很安静，今天的情绪都落定了。关灯前再翻一页书，就不再想明天的事了。",
    "image_url": "/images/2026-08-28-14.jpg",
    "image_author": "",
    "created_at": "2026-08-28T00:19:29.688Z"
  },
  {
    "id": "574070ea-0897-4de5-842c-f6457896036a",
    "date": "2026-08-28",
    "category": "晚安",
    "title": "夜还很长",
    "content": "洗完澡躺在床上，头发还带着潮气。窗外路灯安静地亮着，把今天所有没说完的话，都留在灯影里吧。",
    "image_url": "/images/2026-08-28-15.jpg",
    "image_author": "",
    "created_at": "2026-08-28T00:19:31.223Z"
  },
  {
    "id": "8d4d176e-8f2b-464b-970b-089dade419c2",
    "date": "2026-08-28",
    "category": "日常",
    "title": "周三的烟火气",
    "content": "下班路上买了把青菜，回家煮了碗面。汤底有点咸，但热乎下肚，整个人都踏实了。",
    "image_url": "/images/2026-08-28-16.jpg",
    "image_author": "",
    "created_at": "2026-08-28T00:19:32.667Z"
  },
  {
    "id": "fd1e006f-3edf-4ae4-b55f-4b56fafda340",
    "date": "2026-08-28",
    "category": "日常",
    "title": "小日子",
    "content": "收拾完屋子买了把花，回来路过菜场顺手带了条鱼，晚上做红烧的。普通日子有普通日子的好，忙活半天，坐下来喝口水真舒坦。",
    "image_url": "/images/2026-08-28-17.jpg",
    "image_author": "",
    "created_at": "2026-08-28T00:19:36.288Z"
  },
  {
    "id": "d15be3b5-693a-4734-8187-6ded6bb3b175",
    "date": "2026-08-28",
    "category": "日常",
    "title": "周末的自我修养",
    "content": "上午大扫除翻出三只失踪已久的袜子，下午逛菜市场买了把蔫儿菜，回家煮了锅乱炖，居然还挺好吃。",
    "image_url": "/images/2026-08-28-18.jpg",
    "image_author": "",
    "created_at": "2026-08-28T00:19:39.513Z"
  },
  {
    "id": "17acfab7-c1fc-47a4-9ca6-625e0adcb336",
    "date": "2026-08-28",
    "category": "日常",
    "title": "今日份满足",
    "content": "打扫完屋子，菜市场拎回一把青菜。煮了碗热汤面，阳台吹风发呆。这日子，简单也踏实。",
    "image_url": "/images/2026-08-28-19.jpg",
    "image_author": "",
    "created_at": "2026-08-28T00:19:41.380Z"
  },
  {
    "id": "784d4295-e6ce-4369-8c4c-91b728d637b9",
    "date": "2026-08-26",
    "category": "励志",
    "title": "五点半",
    "content": "闹钟响的时候天还黑着，泡咖啡时看了眼窗外，路灯刚灭。昨晚的疲惫还在，但今天想做的事比昨天多了一件。",
    "image_url": "/images/2026-08-26-0.jpg",
    "image_author": "",
    "created_at": "2026-08-26T16:21:35.962Z"
  },
  {
    "id": "6ca83aab-f5df-4ebc-9b6d-b138801337c8",
    "date": "2026-08-26",
    "category": "励志",
    "title": "把今天过成证据",
    "content": "闹钟响第三次的时候，我按掉了它。黑咖啡倒进保温杯，晨跑三公里，加班到十点。日子重复得乏味，可每滴汗都在给未来投票。",
    "image_url": "/images/2026-08-26-1.jpg",
    "image_author": "",
    "created_at": "2026-08-26T16:21:38.695Z"
  },
  {
    "id": "6087456c-5a82-4f15-a4ef-7c57b85582ff",
    "date": "2026-08-26",
    "category": "励志",
    "title": "深夜的灯",
    "content": "今天加班到十点，电梯里只有自己。很累，但设计图改了八版终于过了。回家路上买了瓶冰可乐，咕咚咕咚喝下去，感觉又活了能再战三百年。",
    "image_url": "/images/2026-08-26-2.jpg",
    "image_author": "",
    "created_at": "2026-08-26T16:21:42.062Z"
  },
  {
    "id": "0ff6e8b8-5ca5-4836-8626-ef406131225b",
    "date": "2026-08-26",
    "category": "励志",
    "title": "凌晨五点半",
    "content": "凌晨五点半的街道比想象中安静，路灯还亮着。跑完三公里，看着天一点点亮起来，突然觉得，能坚持的事，都会慢慢变成习惯。",
    "image_url": "/images/2026-08-26-3.jpg",
    "image_author": "",
    "created_at": "2026-08-26T16:21:44.927Z"
  },
  {
    "id": "8db2d2eb-39cd-458f-8065-7fcdedcd15df",
    "date": "2026-08-26",
    "category": "情感",
    "title": "雨天里的牵挂",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。窗外的雨声很轻，像我们没说出口的那些话。",
    "image_url": "/images/2026-08-26-4.jpg",
    "image_author": "",
    "created_at": "2026-08-26T16:21:46.621Z"
  },
  {
    "id": "5407457d-79b1-4719-a6d4-8b91416c069b",
    "date": "2026-08-26",
    "category": "情感",
    "title": "雨天的信号",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说想念，只问带伞了吗。她回：带了，正好路过我们以前常去的那家面馆。",
    "image_url": "/images/2026-08-26-5.jpg",
    "image_author": "",
    "created_at": "2026-08-26T16:21:49.383Z"
  },
  {
    "id": "91086f96-4881-418e-89f1-4f38dd39ab2f",
    "date": "2026-08-26",
    "category": "情感",
    "title": "一顿饭的陪伴",
    "content": "今天和朋友吃饭，聊到小时候的事，笑得停不下来。忽然觉得，能坐在一起吃饭的人，就是生活里最踏实的陪伴。",
    "image_url": "/images/2026-08-26-6.jpg",
    "image_author": "",
    "created_at": "2026-08-26T16:21:51.766Z"
  },
  {
    "id": "84838972-5f2b-4483-aa14-a1227849c05a",
    "date": "2026-08-26",
    "category": "情感",
    "title": "下雨天的牵挂",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。打开对话框，看到他上周发的照片，笑了。原来惦记一个人，不需要什么理由。",
    "image_url": "/images/2026-08-26-7.jpg",
    "image_author": "",
    "created_at": "2026-08-26T16:21:55.084Z"
  },
  {
    "id": "93f59694-cae5-4a52-8a24-a645d31baca5",
    "date": "2026-08-26",
    "category": "早安",
    "title": "晨光正好·wka",
    "content": "吐司烤得刚好，咖啡香飘了满屋。推开门的瞬间，风里有桂花和新一天的味道。",
    "image_url": "/images/2026-08-26-8.jpg",
    "image_author": "",
    "created_at": "2026-08-26T16:22:03.210Z"
  },
  {
    "id": "27e4ab80-15e1-4237-95cb-12257766377b",
    "date": "2026-08-26",
    "category": "早安",
    "title": "阳光正好",
    "content": "吐司边烤得微焦，咖啡香飘满屋。窗外晨光刚刚好，适合慢慢走一段路。今天，就从小确幸开始。",
    "image_url": "/images/2026-08-26-9.jpg",
    "image_author": "",
    "created_at": "2026-08-26T16:22:04.999Z"
  },
  {
    "id": "5731e0e2-2a54-4a0e-8fe3-2eeb312ced5f",
    "date": "2026-08-26",
    "category": "早安",
    "title": "早安，热咖啡",
    "content": "晨光爬上窗台时，我正对着煎蛋冒热气。一口酥脆，一口绵软，生活的小确幸原来就藏在这份简单的满足里。",
    "image_url": "/images/2026-08-26-10.jpg",
    "image_author": "",
    "created_at": "2026-08-26T16:22:08.148Z"
  },
  {
    "id": "6203dd67-4c0a-4010-ac69-dc84d2242c9d",
    "date": "2026-08-26",
    "category": "早安",
    "title": "晨间小事",
    "content": "阳光斜斜地爬上餐桌，牛奶还是温的。咬一口烤得焦脆的吐司，听见街道苏醒的声音。把今天的期待，装进帆布袋里。",
    "image_url": "/images/2026-08-26-11.jpg",
    "image_author": "",
    "created_at": "2026-08-26T16:22:10.173Z"
  },
  {
    "id": "91355c2b-9e25-4966-bfce-22accd3b754b",
    "date": "2026-08-26",
    "category": "晚安",
    "title": "今晚的句号",
    "content": "窗帘留了条缝，让月光进来。今天所有声音都安静了，包括我自己的。被子裹紧，把情绪也一并收好。",
    "image_url": "/images/2026-08-26-12.jpg",
    "image_author": "",
    "created_at": "2026-08-26T16:22:13.237Z"
  },
  {
    "id": "33ed23e5-0700-42c2-9cb7-85ec784de98a",
    "date": "2026-08-26",
    "category": "晚安",
    "title": "今日收尾",
    "content": "热水冲走了白天的疲惫，窗帘合上最后一片喧嚣。灯灭前看了眼窗外，万家灯火都像在说：此刻安静真好。",
    "image_url": "/images/2026-08-26-13.jpg",
    "image_author": "",
    "created_at": "2026-08-26T16:22:15.109Z"
  },
  {
    "id": "876c83b2-94f5-49a5-8186-1e654d8c4f05",
    "date": "2026-08-26",
    "category": "晚安",
    "title": "今天的句号",
    "content": "水汽还没散，头发半干。窗外路灯把夜色揉成模糊的橘色，今天的事，就留在今天吧。拉上窗帘，该睡了。",
    "image_url": "/images/2026-08-26-14.jpg",
    "image_author": "",
    "created_at": "2026-08-26T16:22:16.886Z"
  },
  {
    "id": "20c45c80-8e07-4736-99c2-6f04b3096a5a",
    "date": "2026-08-26",
    "category": "晚安",
    "title": "夜归人",
    "content": "关灯前看了眼窗外，万家灯火也一盏盏暗了。今天的事都留在今天了，被子裹住我，像城市裹住夜。",
    "image_url": "/images/2026-08-26-15.jpg",
    "image_author": "",
    "created_at": "2026-08-26T16:22:18.545Z"
  },
  {
    "id": "dbeffc35-7853-4009-8538-6100a5c6e699",
    "date": "2026-08-26",
    "category": "日常",
    "title": "今天这顿饭",
    "content": "冰箱里剩的菜随便凑了一锅，没想到还挺好吃。吃饱了瘫在沙发上，突然觉得日子也就这样，简单点挺好。",
    "image_url": "/images/2026-08-26-16.jpg",
    "image_author": "",
    "created_at": "2026-08-26T16:22:22.320Z"
  },
  {
    "id": "d546138b-1ead-428c-bff7-7820b9120a46",
    "date": "2026-08-26",
    "category": "日常",
    "title": "今天的小确幸",
    "content": "买菜回来顺手收拾了屋子，蹲在阳台发了会儿呆。晚上煮了锅粥，喝得浑身热乎。日子就这么过，也挺好。",
    "image_url": "/images/2026-08-26-17.jpg",
    "image_author": "",
    "created_at": "2026-08-26T16:22:24.291Z"
  },
  {
    "id": "04c2810b-26f2-439a-bc1c-c49c82486e57",
    "date": "2026-08-26",
    "category": "日常",
    "title": "周末厨房",
    "content": "周末难得下厨，煎了俩蛋，糊了一个，另一个勉强能看。配着泡面吃，倒也满足。",
    "image_url": "/images/2026-08-26-18.jpg",
    "image_author": "",
    "created_at": "2026-08-26T16:22:27.034Z"
  },
  {
    "id": "7a523458-d902-4edb-b19f-bc54f74a175d",
    "date": "2026-08-26",
    "category": "日常",
    "title": "周一晚上的厨房",
    "content": "下班路上买了把青菜，回家煮了碗面。锅里的热气扑到脸上，突然觉得这一天也没那么糟。",
    "image_url": "/images/2026-08-26-19.jpg",
    "image_author": "",
    "created_at": "2026-08-26T16:22:29.146Z"
  }
]
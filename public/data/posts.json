  },
  {
    "id": "be2b41d3-a234-412c-9e80-0e0818f8f2c0",
    "date": "2026-07-23",
    "category": "励志",
    "title": "六点半的晨光",
    "content": "五点半的闹钟响了第三次，推开窗看见天边泛白。早起确实困，但能比昨天多跑一公里。",
    "image_url": "/images/2026-07-23-0.jpg",
    "image_author": "",
    "created_at": "2026-07-23T16:39:20.707Z"
  },
  {
    "id": "9ce87a92-70b4-4ecf-afb0-b960eb82caff",
    "date": "2026-07-23",
    "category": "励志",
    "title": "日复一日",
    "content": "闹钟响了五次才爬起来，但窗外的天已经亮了。每天多做一点点，不是为了感动谁，只是为了那个更好的自己。",
    "image_url": "/images/2026-07-23-1.jpg",
    "image_author": "",
    "created_at": "2026-07-23T16:39:23.809Z"
  },
  {
    "id": "7a568729-33d9-42ca-a5f2-c52e81c7322d",
    "date": "2026-07-23",
    "category": "励志",
    "title": "早间",
    "content": "六点的闹钟响了三次，第四次我终于爬起来。窗外雨还没停，但咖啡已经煮好。",
    "image_url": "/images/2026-07-23-2.jpg",
    "image_author": "",
    "created_at": "2026-07-23T16:39:26.349Z"
  },
  {
    "id": "6634ce76-8990-44f4-8476-2d58dd45b6de",
    "date": "2026-07-23",
    "category": "励志",
    "title": "早班车的方向",
    "content": "六点半的闹钟响了三次才爬起来，地铁里困得东倒西歪。可想到今天能比昨天多完成一件事，就觉得早起值得。",
    "image_url": "/images/2026-07-23-3.jpg",
    "image_author": "",
    "created_at": "2026-07-23T16:39:31.707Z"
  },
  {
    "id": "6c104bf4-a6e2-4a3d-a3e8-77515e92ae97",
    "date": "2026-07-23",
    "category": "情感",
    "title": "雨天的小确幸",
    "content": "下雨天，泡了杯热茶，突然想起妈妈上次视频里说的那句“记得加衣服”。有点想家了。",
    "image_url": "/images/2026-07-23-4.jpg",
    "image_author": "",
    "created_at": "2026-07-23T16:39:33.475Z"
  },
  {
    "id": "d4788835-a742-480a-806f-90ad56dbc27f",
    "date": "2026-07-23",
    "category": "情感",
    "title": "雨天的小事",
    "content": "下雨天窝在沙发里，翻到外婆上周视频时教我做菜的画面。原来温暖一直都在，只是需要一点雨声提醒。",
    "image_url": "/images/2026-07-23-5.jpg",
    "image_author": "",
    "created_at": "2026-07-23T16:39:36.461Z"
  },
  {
    "id": "7fd69439-6cc5-477e-ad0b-67d503737caf",
    "date": "2026-07-23",
    "category": "情感",
    "title": "雨天来信",
    "content": "下雨了，翻开通讯录，给老友发了句“带伞没”。秒回一个表情包，像回到那年一起躲雨的便利店。",
    "image_url": "/images/2026-07-23-6.jpg",
    "image_author": "",
    "created_at": "2026-07-23T16:39:38.558Z"
  },
  {
    "id": "8d145e71-9b0b-4818-9a9d-a5a1a90fcaf9",
    "date": "2026-07-23",
    "category": "情感",
    "title": "下雨的夜晚",
    "content": "视频接通那刻，爸妈正包饺子。镜头晃过面板，碎碎说着今天买了什么菜。没说什么想念，但挂了电话，厨房突然好安静。",
    "image_url": "/images/2026-07-23-7.jpg",
    "image_author": "",
    "created_at": "2026-07-23T16:39:40.799Z"
  },
  {
    "id": "91ac87fc-4f6f-44a7-84ef-73889c7db5b8",
    "date": "2026-07-23",
    "category": "早安",
    "title": "早安·晴好",
    "content": "咬了一口脆脆的吐司边，咖啡香飘进晨光里。今天脚步特别轻，好像风在背后推着走。",
    "image_url": "/images/2026-07-23-8.jpg",
    "image_author": "",
    "created_at": "2026-07-23T16:39:42.597Z"
  },
  {
    "id": "71db6ae7-d968-4bbb-adb6-a1370689c226",
    "date": "2026-07-23",
    "category": "早安",
    "title": "早安，出发",
    "content": "吐司烤得刚好，咖啡香飘满屋。窗外的阳光在催我出门，新的一天，走着瞧。",
    "image_url": "/images/2026-07-23-9.jpg",
    "image_author": "",
    "created_at": "2026-07-23T16:39:49.882Z"
  },
  {
    "id": "7c5578a1-716f-4e46-966e-95cc950d831c",
    "date": "2026-07-23",
    "category": "早安",
    "title": "早安·小确幸",
    "content": "咬一口烤得酥脆的吐司，阳光正好洒在咖啡杯沿。出门前镜子里的自己，比昨天多了一点点笑意。",
    "image_url": "/images/2026-07-23-10.jpg",
    "image_author": "",
    "created_at": "2026-07-23T16:39:53.695Z"
  },
  {
    "id": "1ad67221-9000-4f54-b62a-d20d4891ea2b",
    "date": "2026-07-23",
    "category": "早安",
    "title": "早安时刻",
    "content": "阳光落在吐司上，煎蛋边缘焦脆。咖啡香里翻几页书，日子就该这样慢慢开始。",
    "image_url": "/images/2026-07-23-11.jpg",
    "image_author": "",
    "created_at": "2026-07-23T16:39:58.124Z"
  },
  {
    "id": "97dd435b-4979-4696-8b63-c1b9eb91e02c",
    "date": "2026-07-23",
    "category": "晚安",
    "title": "夜色",
    "content": "洗去一天的疲惫，关灯前看一眼窗外。路灯静静亮着，夜色正温柔地包裹一切。不必想明天的事，此刻只属于自己。",
    "image_url": "/images/2026-07-23-12.jpg",
    "image_author": "",
    "created_at": "2026-07-23T16:40:00.630Z"
  },
  {
    "id": "c751f315-f9f9-465b-bda1-06d634d72e2b",
    "date": "2026-07-23",
    "category": "晚安",
    "title": "今日收束",
    "content": "灯熄了，窗外路灯的光柔柔地透进来。这一天翻过最后一页，心安理得把疲惫卸在枕边。",
    "image_url": "/images/2026-07-23-13.jpg",
    "image_author": "",
    "created_at": "2026-07-23T16:40:03.674Z"
  },
  {
    "id": "14500ced-e58f-4d93-a629-838f4b7ab766",
    "date": "2026-07-23",
    "category": "晚安",
    "title": "今夜",
    "content": "洗完澡陷进被子里，窗外的灯光渐渐熄灭。今天就到这里吧，把白天的喧嚣和疲惫都留在门外。",
    "image_url": "/images/2026-07-23-14.jpg",
    "image_author": "",
    "created_at": "2026-07-23T16:40:06.449Z"
  },
  {
    "id": "5145f3e7-f388-4f2c-8140-cd0342c43d75",
    "date": "2026-07-23",
    "category": "晚安",
    "title": "夜话",
    "content": "洗完澡往床上一躺，窗外的灯都暗了。白天那些没说完的话，散在夜里，安静得刚刚好。",
    "image_url": "/images/2026-07-23-15.jpg",
    "image_author": "",
    "created_at": "2026-07-23T16:40:12.329Z"
  },
  {
    "id": "b07eb62a-4bb8-4ca3-bcc8-13315b6aa9aa",
    "date": "2026-07-23",
    "category": "日常",
    "title": "今晚的菜",
    "content": "买菜回来洗洗切切炒了一盘土豆丝，配碗白粥，吃得挺舒坦。这日子，凑合也香。",
    "image_url": "/images/2026-07-23-16.jpg",
    "image_author": "",
    "created_at": "2026-07-23T16:40:14.367Z"
  },
  {
    "id": "fe39a417-9fc4-42a6-a2bd-8f8d9a33b5e7",
    "date": "2026-07-23",
    "category": "日常",
    "title": "日常小确幸",
    "content": "下午收拾房间翻出好多旧东西，扔了一堆，阳台站了会儿发呆，晚风凉凉的，舒服。",
    "image_url": "/images/2026-07-23-17.jpg",
    "image_author": "",
    "created_at": "2026-07-23T16:40:16.563Z"
  },
  {
    "id": "14b8f076-9c04-4bbf-af11-e75cf1d771cd",
    "date": "2026-07-23",
    "category": "日常",
    "title": "买菜回来",
    "content": "今天去菜市场逛了一圈，买了把青菜和两条鱼。回来做了个清汤面，吃完靠在阳台发了会儿呆，风挺舒服的。",
    "image_url": "/images/2026-07-23-18.jpg",
    "image_author": "",
    "created_at": "2026-07-23T16:40:18.040Z"
  },
  {
    "id": "e020a4eb-f51a-4f0c-acd4-0b70494e31b9",
    "date": "2026-07-23",
    "category": "日常",
    "title": "平淡日常",
    "content": "冰箱里剩菜随便炒了炒，竟然还挺香。阳台发了会儿呆，隔壁炒菜声飘进来，这日子嘛，刚刚好。",
    "image_url": "/images/2026-07-23-19.jpg",
    "image_author": "",
    "created_at": "2026-07-23T16:40:20.419Z"
  },
  {
    "id": "3ac1d8a5-5783-40af-a317-7a6ec4e3aec7",
    "date": "2026-07-22",
    "category": "励志",
    "title": "早六点的光",
    "content": "闹钟响了三遍才爬起来，窗外天还没亮。但看到早餐店蒸笼冒出的热气，突然觉得，每一步都算数。",
    "image_url": "/images/2026-07-22-0.jpg",
    "image_author": "",
    "created_at": "2026-07-22T16:22:52.021Z"
  },
  {
    "id": "66996521-3d96-4e87-ac6b-eed2c45483ad",
    "date": "2026-07-22",
    "category": "励志",
    "title": "早起的意义",
    "content": "路灯还亮着就出门了，地铁上看见有人背单词。困是困的，但这条路通向想去的地方。",
    "image_url": "/images/2026-07-22-1.jpg",
    "image_author": "",
    "created_at": "2026-07-22T16:23:01.948Z"
  },
  {
    "id": "8bbc6d69-f2eb-4ace-b1af-89e57c2facdd",
    "date": "2026-07-22",
    "category": "励志",
    "title": "方向感",
    "content": "六点半的闹钟响了三次才爬起来，但出门看到朝阳洒在站台上，突然觉得每一步都算数。",
    "image_url": "/images/2026-07-22-2.jpg",
    "image_author": "",
    "created_at": "2026-07-22T16:23:08.110Z"
  },
  {
    "id": "359c5977-6be0-4904-8b1d-9e1d2b613a96",
    "date": "2026-07-22",
    "category": "励志",
    "title": "早起的意义·qoo",
    "content": "闹钟响了三遍才爬起来，窗外的路灯还亮着。但想到今天能比昨天多完成一件事，就觉得这困意值得。",
    "image_url": "/images/2026-07-22-3.jpg",
    "image_author": "",
    "created_at": "2026-07-22T16:23:21.893Z"
  },
  {
    "id": "c7145757-f783-4b06-8d5d-37c63678edd2",
    "date": "2026-07-22",
    "category": "情感",
    "title": "雨天想起你",
    "content": "窗外的雨淅淅沥沥下了一整天，翻到去年一起吃饭的照片，那碗热汤的味道好像还在嘴边。",
    "image_url": "/images/2026-07-22-4.jpg",
    "image_author": "",
    "created_at": "2026-07-22T16:23:28.795Z"
  },
  {
    "id": "617e115b-46e0-440d-8dfc-b8e55e6ee04b",
    "date": "2026-07-22",
    "category": "情感",
    "title": "雨天的信号",
    "content": "下雨天，翻到相册里上次一起吃饭的照片，给爸妈发了句“想你们了”。他们秒回一个笑脸，说正好也在念叨我。",
    "image_url": "/images/2026-07-22-5.jpg",
    "image_author": "",
    "created_at": "2026-07-22T16:23:35.026Z"
  },
  {
    "id": "3f918db4-e292-4460-9eb6-f0c7b500bf98",
    "date": "2026-07-22",
    "category": "情感",
    "title": "雨天翻相册",
    "content": "翻到去年一起吃饭的照片，窗外正好下雨。有些想念不用说出来，雨声会替我记住。",
    "image_url": "/images/2026-07-22-6.jpg",
    "image_author": "",
    "created_at": "2026-07-22T16:23:46.270Z"
  },
  {
    "id": "d638581a-6ab0-4cac-bb46-cd35986f1713",
    "date": "2026-07-22",
    "category": "情感",
    "title": "下雨天",
    "content": "下雨天，翻到去年和妈妈视频的截图，她正举着刚包的饺子让我看。窗外雨声淅沥，突然想今晚也包一回，学她那样举起来。",
    "image_url": "/images/2026-07-22-7.jpg",
    "image_author": "",
    "created_at": "2026-07-22T16:23:57.164Z"
  },
  {
    "id": "9beb8bba-4612-45cf-9de8-28a6f297c892",
    "date": "2026-07-22",
    "category": "早安",
    "title": "早安·光",
    "content": "晨光刚爬上窗台，咖啡香先一步叫醒了房间。咬一口酥脆吐司，新的一天从好好吃早餐开始。",
    "image_url": "/images/2026-07-22-8.jpg",
    "image_author": "",
    "created_at": "2026-07-22T16:24:02.378Z"
  },
  {
    "id": "11507e45-f1be-4c20-bc87-0c64c89eec07",
    "date": "2026-07-22",
    "category": "早安",
    "title": "早安小记",
    "content": "阳光斜进窗户，咖啡香混着烤吐司的味道。咬一口酥脆，推开门，风正好，该出发了。",
    "image_url": "/images/2026-07-22-9.jpg",
    "image_author": "",
    "created_at": "2026-07-22T16:24:07.697Z"
  },
  {
    "id": "eec04829-7ed8-462e-a5b2-cb132c45072e",
    "date": "2026-07-22",
    "category": "早安",
    "title": "早起的温柔",
    "content": "咬一口烤得微焦的吐司，咖啡香混着晨光飘进窗。推开门，空气里有露水的味道，今天也要好好走路。",
    "image_url": "/images/2026-07-22-10.jpg",
    "image_author": "",
    "created_at": "2026-07-22T16:24:12.864Z"
  },
  {
    "id": "de449230-c825-4a21-8daa-157999b5bb6e",
    "date": "2026-07-22",
    "category": "早安",
    "title": "早安一刻",
    "content": "晨光配咖啡，吐司煎蛋刚好焦脆。推门迎风，熟悉的街道醒了，今天要走慢一点。",
    "image_url": "/images/2026-07-22-11.jpg",
    "image_author": "",
    "created_at": "2026-07-22T16:24:22.070Z"
  },
  {
    "id": "c905de38-1b25-4a84-b3c4-97ac51f3eff7",
    "date": "2026-07-22",
    "category": "晚安",
    "title": "今日终了",
    "content": "关了灯才发现窗外的月亮正亮着，像一天的心事都晾在那儿，明早就化开了。",
    "image_url": "/images/2026-07-22-12.jpg",
    "image_author": "",
    "created_at": "2026-07-22T16:24:28.791Z"
  },
  {
    "id": "6a7b9607-eafc-4637-9e82-aa45a910209e",
    "date": "2026-07-22",
    "category": "晚安",
    "title": "沉淀",
    "content": "关灯前看了眼窗外，路灯把树影拉得很长。今天的故事就翻到这一页，剩下的，等明天再说。",
    "image_url": "/images/2026-07-22-13.jpg",
    "image_author": "",
    "created_at": "2026-07-22T16:24:35.933Z"
  },
  {
    "id": "ddd2b9b7-75fb-495f-b62d-8f668a5a9c8c",
    "date": "2026-07-22",
    "category": "晚安",
    "title": "今晚",
    "content": "窗外的灯一盏盏暗了，我也该把自己放进夜色里。今天的事，都留在今天吧。",
    "image_url": "/images/2026-07-22-14.jpg",
    "image_author": "",
    "created_at": "2026-07-22T16:24:43.807Z"
  },
  {
    "id": "35ec09d9-1899-44e8-8a6a-b0c8417d2c22",
    "date": "2026-07-22",
    "category": "晚安",
    "title": "收工时刻",
    "content": "洗完澡坐在床边，窗外的灯光也慢慢暗下去。今天的事，今天的心情，都留在这片夜色里。该休息了。",
    "image_url": "/images/2026-07-22-15.jpg",
    "image_author": "",
    "created_at": "2026-07-22T16:24:51.005Z"
  },
  {
    "id": "f386fb05-684f-44e4-8c03-585b070b4292",
    "date": "2026-07-22",
    "category": "日常",
    "title": "做饭的快乐",
    "content": "冰箱里剩的菜随便凑了凑，炒出来居然挺好吃。果然饿的时候，厨艺自动加buff。",
    "image_url": "/images/2026-07-22-16.jpg",
    "image_author": "",
    "created_at": "2026-07-22T16:25:02.475Z"
  },
  {
    "id": "fd9453cb-d9ce-460c-9e5a-2b5c2fbd821a",
    "date": "2026-07-22",
    "category": "日常",
    "title": "周末的琐碎",
    "content": "洗菜切菜半小时，吃面五分钟。擦完地板瘫沙发上，发呆看云飘过去。",
    "image_url": "/images/2026-07-22-17.jpg",
    "image_author": "",
    "created_at": "2026-07-22T16:25:10.007Z"
  },
  {
    "id": "eeafe9a7-98d2-409f-969d-fd56cb36ddd6",
    "date": "2026-07-22",
    "category": "日常",
    "title": "阳台闲坐",
    "content": "下午收拾完屋子，在阳台发了会呆，看楼下老太太遛狗，风挺舒服，啥也没干，挺满意。",
    "image_url": "/images/2026-07-22-18.jpg",
    "image_author": "",
    "created_at": "2026-07-22T16:25:17.094Z"
  },
  {
    "id": "bd8ff9cc-3fbe-4149-a9c2-e11535cfa8c1",
    "date": "2026-07-22",
    "category": "日常",
    "title": "收拾厨房",
    "content": "花了一小时把厨房擦干净，结果炒个菜又乱了。算了，反正明天还得做饭。",
    "image_url": "/images/2026-07-22-19.jpg",
    "image_author": "",
    "created_at": "2026-07-22T16:25:24.062Z"
  },
  {
    "id": "9f94d5f9-78d3-4073-8252-9814c4af7419",
    "date": "2026-07-21",
    "category": "励志",
    "title": "早班车",
    "content": "六点的闹钟响了第三遍才爬起来，但今天比昨天早起了两分钟。这大概就是成长——不完美，但一直在靠近。",
    "image_url": "/images/2026-07-21-0.jpg",
    "image_author": "",
    "created_at": "2026-07-21T16:25:54.592Z"
  },
  {
    "id": "c6526741-d86b-4763-8fd8-b1a706390c01",
    "date": "2026-07-21",
    "category": "励志",
    "title": "早晨的坚持",
    "content": "闹钟响了三遍才爬起来，但推开窗发现今天的晨光比昨天更亮了一些。",
    "image_url": "/images/2026-07-21-1.jpg",
    "image_author": "",
    "created_at": "2026-07-21T16:25:56.384Z"
  },
  {
    "id": "bb40d0ef-c854-4330-81d5-f714951d5929",
    "date": "2026-07-21",
    "category": "励志",
    "title": "方向",
    "content": "六点的闹钟响了三次才爬起来，但看到窗外的晨光时，觉得这一天的开始比昨天早了十分钟。",
    "image_url": "/images/2026-07-21-2.jpg",
    "image_author": "",
    "created_at": "2026-07-21T16:25:58.824Z"
  },
  {
    "id": "1e59adb6-4c13-4970-9de1-2c8298d5d8dd",
    "date": "2026-07-21",
    "category": "励志",
    "title": "清醒",
    "content": "凌晨的键盘声和闹钟响，都是生活里悄悄长出的新芽。回头看，每一步都有光。",
    "image_url": "/images/2026-07-21-3.jpg",
    "image_author": "",
    "created_at": "2026-07-21T16:26:00.583Z"
  },
  {
    "id": "4a1924d6-feda-461f-9ff4-88edda422153",
    "date": "2026-07-21",
    "category": "情感",
    "title": "雨天",
    "content": "下雨天，翻到和妈妈的聊天记录，她总提醒我添衣。其实离家再远，有人惦记着，心里就是暖的。",
    "image_url": "/images/2026-07-21-4.jpg",
    "image_author": "",
    "created_at": "2026-07-21T16:26:02.365Z"
  },
  {
    "id": "82d66af3-f8f4-4865-b4cc-4a7e1927f417",
    "date": "2026-07-21",
    "category": "情感",
    "title": "雨天想起",
    "content": "下了一整天的雨，突然想起外婆做的红豆汤。翻了翻手机，视频通话接通的那一刻，她正坐在窗边择菜。",
    "image_url": "/images/2026-07-21-5.jpg",
    "image_author": "",
    "created_at": "2026-07-21T16:26:05.562Z"
  },
  {
    "id": "c94d775a-b78b-4826-87bb-7972a7948346",
    "date": "2026-07-21",
    "category": "情感",
    "title": "视频里的家",
    "content": "和爸妈视频，他们在那头吃西瓜，我在这头加班到深夜。原来成长就是学会隔着屏幕笑着说一切都好。",
    "image_url": "/images/2026-07-21-6.jpg",
    "image_author": "",
    "created_at": "2026-07-21T16:26:07.582Z"
  },
  {
    "id": "9a3aac3f-3ead-4867-869d-1f0175bdbe8e",
    "date": "2026-07-21",
    "category": "情感",
    "title": "想念的温度",
    "content": "视频通话挂断后，妈妈还站在屏幕里挥手。原来温暖的距离，是相隔千里也能听见彼此的呼吸声。",
    "image_url": "/images/2026-07-21-7.jpg",
    "image_author": "",
    "created_at": "2026-07-21T16:26:09.324Z"
  },
  {
    "id": "c4d562c9-3065-4125-80ec-53acc628fff0",
    "date": "2026-07-21",
    "category": "早安",
    "title": "早安碎片",
    "content": "咖啡香从厨房飘出来，煎蛋边缘焦脆刚刚好。阳光斜斜洒在桌上，今天的节奏，由自己定调。",
    "image_url": "/images/2026-07-21-8.jpg",
    "image_author": "",
    "created_at": "2026-07-21T16:26:10.985Z"
  },
  {
    "id": "4d9a975b-fe70-4210-8a39-0bddba6322b7",
    "date": "2026-07-21",
    "category": "早安",
    "title": "早安",
    "content": "咖啡香飘进房间的时候，我刚好系好鞋带。阳光把吐司烤得微微发黄，咬一口，嗯，今天应该不错。",
    "image_url": "/images/2026-07-21-9.jpg",
    "image_author": "",
    "created_at": "2026-07-21T16:26:12.851Z"
  },
  {
    "id": "7d341e91-1534-4acc-a95c-e51a3b0262a4",
    "date": "2026-07-21",
    "category": "早安",
    "title": "清晨能量",
    "content": "咬一口脆脆的吐司，咖啡香混着晨光飘进来。好天气，好心情，出门走走。",
    "image_url": "/images/2026-07-21-10.jpg",
    "image_author": "",
    "created_at": "2026-07-21T16:26:21.146Z"
  },
  {
    "id": "ce59ab3c-4fb7-463f-853e-e31537f84476",
    "date": "2026-07-21",
    "category": "早安",
    "title": "清晨瞬间",
    "content": "咬一口酥脆的吐司，咖啡香钻进鼻腔。阳光刚刚好，脚步也刚刚好，今天从胃暖到心。",
    "image_url": "/images/2026-07-21-11.jpg",
    "image_author": "",
    "created_at": "2026-07-21T16:26:24.399Z"
  },
  {
    "id": "57d42c50-eb6e-4f4c-b755-b1295c871b89",
    "date": "2026-07-21",
    "category": "晚安",
    "title": "夜的收尾",
    "content": "洗完澡躺下来，窗外的路灯把树影投在天花板上。今天所有的事，就在这一刻安静地结束了。",
    "image_url": "/images/2026-07-21-12.jpg",
    "image_author": "",
    "created_at": "2026-07-21T16:26:26.477Z"
  },
  {
    "id": "6617d445-2984-4889-a7bb-21cd984dc57c",
    "date": "2026-07-21",
    "category": "晚安",
    "title": "今日打烊",
    "content": "关灯前的最后一眼窗外，街灯把夜铺得很软。今天攒下的疲惫，就交给热水冲走。",
    "image_url": "/images/2026-07-21-13.jpg",
    "image_author": "",
    "created_at": "2026-07-21T16:26:28.871Z"
  },
  {
    "id": "5cfd0068-802b-4261-aa81-53a13e41c6cc",
    "date": "2026-07-21",
    "category": "晚安",
    "title": "收工",
    "content": "洗完澡躺下来，窗户留一条缝。风透进来，把今天最后一点情绪也吹散了。",
    "image_url": "/images/2026-07-21-14.jpg",
    "image_author": "",
    "created_at": "2026-07-21T16:26:30.628Z"
  },
  {
    "id": "fbfb1708-1ce4-43a1-98f0-40f35664835d",
    "date": "2026-07-21",
    "category": "晚安",
    "title": "夜深了",
    "content": "关了灯，窗外最后一盏灯也暗了。今天像页翻完的书，轻轻合上，连同那些杂念一起沉入夜色里。",
    "image_url": "/images/2026-07-21-15.jpg",
    "image_author": "",
    "created_at": "2026-07-21T16:26:32.391Z"
  },
  {
    "id": "55586c90-7e74-4b76-ac2f-cbec92eba7e8",
    "date": "2026-07-21",
    "category": "日常",
    "title": "今日小确幸",
    "content": "买菜回来顺手收拾了冰箱，又擦了一遍灶台。累是累了点，但看着干干净净的厨房，心里还挺舒坦。",
    "image_url": "/images/2026-07-21-16.jpg",
    "image_author": "",
    "created_at": "2026-07-21T16:26:34.156Z"
  },
  {
    "id": "313b0668-90ef-4e7a-b084-c42f5bd07c83",
    "date": "2026-07-21",
    "category": "日常",
    "title": "周五晚上",
    "content": "把冰箱里剩的菜随便炒了炒，居然还挺好吃。边吃边刷剧，感觉这才是周末该有的样子。",
    "image_url": "/images/2026-07-21-17.jpg",
    "image_author": "",
    "created_at": "2026-07-21T16:26:35.941Z"
  },
  {
    "id": "4463fb8a-8451-4c22-af11-6841c1a03af0",
    "date": "2026-07-21",
    "category": "日常",
    "title": "今日份琐碎",
    "content": "收拾房间发现半年前买的蒜，居然发芽了。顺手种进花盆，感觉赚了一盆菜。",
    "image_url": "/images/2026-07-21-18.jpg",
    "image_author": "",
    "created_at": "2026-07-21T16:26:37.658Z"
  },
  {
    "id": "2579b3ec-6e64-4bff-9896-d6371927ddb2",
    "date": "2026-07-21",
    "category": "日常",
    "title": "日常一记",
    "content": "收拾完房间，把阳台的灰擦了擦，发了会呆。晚饭煮了碗面，味道还行，日子就这么过着。",
    "image_url": "/images/2026-07-21-19.jpg",
    "image_author": "",
    "created_at": "2026-07-21T16:26:40.010Z"
  }
]
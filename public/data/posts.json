[
  {
    "id": "a84347c3-d58f-481d-b266-cdf5eb1b84b2",
    "date": "2026-08-07",
    "category": "励志",
    "title": "被闹钟叫醒的第三年",
    "content": "窗外天还黑着，我已经在等第一班车。那些咬咬牙撑过来的早晨，现在都变成了脚下的路。",
    "image_url": "/images/2026-08-07-0.jpg",
    "image_author": "",
    "created_at": "2026-08-07T15:59:47.075Z"
  },
  {
    "id": "3753244e-eeb1-46af-8e7f-a86792deb41f",
    "date": "2026-08-07",
    "category": "励志",
    "title": "熬过清晨",
    "content": "六点半的闹钟响了三次才爬起来，黑咖啡灌下肚。路上人潮拥挤，可每个人都走得那么坚定。今天的我，又比昨天多撑了一点点。",
    "image_url": "/images/2026-08-07-1.jpg",
    "image_author": "",
    "created_at": "2026-08-07T15:59:49.410Z"
  },
  {
    "id": "3814dae6-bad3-4a21-8898-455816661e6f",
    "date": "2026-08-07",
    "category": "励志",
    "title": "闹钟响了",
    "content": "六点半的闹钟响了三次，我还是爬起来了。晨光里那杯咖啡的温度，恰好能撑到中午。昨夜加班留下的疲惫，被清晨的风吹散了一些。路还长，但每一步都算数。",
    "image_url": "/images/2026-08-07-2.jpg",
    "image_author": "",
    "created_at": "2026-08-07T15:59:52.021Z"
  },
  {
    "id": "a1335737-3398-4b63-8707-3cbb3577903d",
    "date": "2026-08-07",
    "category": "励志",
    "title": "今天的进度条",
    "content": "闹钟响的时候天还没亮，但想到昨晚又比前天多背了十个单词，突然觉得这黑黢黢的早晨也值了。",
    "image_url": "/images/2026-08-07-3.jpg",
    "image_author": "",
    "created_at": "2026-08-07T15:59:54.515Z"
  },
  {
    "id": "1e42b206-66b2-4e39-8014-7933a6158174",
    "date": "2026-08-07",
    "category": "情感",
    "title": "雨天的信号",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说太多，就问了句你那下雨了吗。他回了个嗯，附了张窗外的照片。原来我们看着同一场雨。",
    "image_url": "/images/2026-08-07-4.jpg",
    "image_author": "",
    "created_at": "2026-08-07T15:59:56.487Z"
  },
  {
    "id": "f9cc6382-f785-47ad-9ae4-12048f8c87c1",
    "date": "2026-08-07",
    "category": "情感",
    "title": "煮茶听雨",
    "content": "下雨天，煮了一壶茶，突然想起小时候和外公在下雨天听戏的午后。茶香氤氲里，仿佛又听见他说，慢慢来，日子总会晴朗的。",
    "image_url": "/images/2026-08-07-5.jpg",
    "image_author": "",
    "created_at": "2026-08-07T15:59:58.791Z"
  },
  {
    "id": "d90cea02-24bf-4cb3-9d14-4043375637b1",
    "date": "2026-08-07",
    "category": "情感",
    "title": "雨天的消息",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说太多，就问问那边天气怎么样。有些惦记，不需要理由。",
    "image_url": "/images/2026-08-07-6.jpg",
    "image_author": "",
    "created_at": "2026-08-07T16:00:02.565Z"
  },
  {
    "id": "14ea17bb-200f-4e76-a016-87f281f27fc5",
    "date": "2026-08-07",
    "category": "情感",
    "title": "雨天",
    "content": "下雨天，翻到聊天记录里去年的这个时候，我们还在说下次一起淋雨。然后我发了条消息：你那下雨了吗？",
    "image_url": "/images/2026-08-07-7.jpg",
    "image_author": "",
    "created_at": "2026-08-07T16:05:34.259Z"
  },
  {
    "id": "4156ab6d-ce0e-4711-a130-f311217c70bd",
    "date": "2026-08-07",
    "category": "早安",
    "title": "晨光正好",
    "content": "阳光透过窗帘缝洒在吐司上，煎蛋边缘微焦。咖啡的香气混着清晨凉意，推开门，风刚刚好。今天也要好好出发。",
    "image_url": "/images/2026-08-07-8.jpg",
    "image_author": "",
    "created_at": "2026-08-07T16:05:36.064Z"
  },
  {
    "id": "51a6ae63-8f94-4d74-b4dd-424fb0312eb3",
    "date": "2026-08-07",
    "category": "早安",
    "title": "早安，咖啡香",
    "content": "阳光斜进窗台，咖啡壶咕嘟作响。咬一口酥脆可颂，窗外的风刚好温柔。今天要从容地走，慢慢看世界。",
    "image_url": "/images/2026-08-07-9.jpg",
    "image_author": "",
    "created_at": "2026-08-07T16:05:38.447Z"
  },
  {
    "id": "ba31ed34-9610-4fcb-87a4-1331785eb32b",
    "date": "2026-08-07",
    "category": "早安",
    "title": "早餐的仪式感",
    "content": "煎蛋在锅里滋滋响，面包机跳起来的时候，阳光刚好爬上窗台。今天的第一口咖啡，苦得刚刚好，像生活本来的味道。",
    "image_url": "/images/2026-08-07-10.jpg",
    "image_author": "",
    "created_at": "2026-08-07T16:05:40.474Z"
  },
  {
    "id": "dd6939a6-5062-47a6-b5f8-8843446b8d7c",
    "date": "2026-08-07",
    "category": "早安",
    "title": "早安，今日份阳光",
    "content": "煎蛋在锅里滋滋响，咖啡香飘满屋。推开窗，晨风正好，公交还有三分钟。把今天揣进口袋，出门啦。",
    "image_url": "/images/2026-08-07-11.jpg",
    "image_author": "",
    "created_at": "2026-08-07T16:05:43.078Z"
  },
  {
    "id": "012a357a-97e8-44dc-8ba5-9fa3538adad1",
    "date": "2026-08-07",
    "category": "晚安",
    "title": "收工时刻",
    "content": "洗完澡躺下，窗外灯火也倦了。手机放一边，今天所有声响都归零。就到这里，让夜晚接管身体。",
    "image_url": "/images/2026-08-07-12.jpg",
    "image_author": "",
    "created_at": "2026-08-07T16:05:45.682Z"
  },
  {
    "id": "141ff948-7def-417a-8c92-46e8e2378566",
    "date": "2026-08-07",
    "category": "晚安",
    "title": "夜归人",
    "content": "把今天的疲惫丢进浴室，头发还湿着就看窗外灯火。世界安静下来时，我才听见自己呼吸的声音。",
    "image_url": "/images/2026-08-07-13.jpg",
    "image_author": "",
    "created_at": "2026-08-07T16:05:47.997Z"
  },
  {
    "id": "9ef0ea5e-2630-4610-b98a-8e2538fcec56",
    "date": "2026-08-07",
    "category": "晚安",
    "title": "一天收工",
    "content": "洗完澡躺下来，窗外路灯还亮着。今天的事就留在今天吧，此刻只需要好好呼吸，慢慢入睡。",
    "image_url": "/images/2026-08-07-14.jpg",
    "image_author": "",
    "created_at": "2026-08-07T16:05:50.089Z"
  },
  {
    "id": "e623adf3-9bb5-4d59-8d41-23fee09b76cc",
    "date": "2026-08-07",
    "category": "晚安",
    "title": "夜航船",
    "content": "洗完澡、关灯，窗外零星几盏灯还亮着。今天像一艘船，终于靠了岸。所有没说出口的话，都留给夜风慢慢吹散。",
    "image_url": "/images/2026-08-07-15.jpg",
    "image_author": "",
    "created_at": "2026-08-07T16:05:52.765Z"
  },
  {
    "id": "daa46725-3c81-4b1c-84c3-45e896dba5d6",
    "date": "2026-08-07",
    "category": "日常",
    "title": "今天的小确幸",
    "content": "下午收拾房间翻出好多旧东西，扔了三大袋垃圾，阳台擦干净吹了会儿风，晚上煮了碗馄饨，皮薄馅大，美得很。",
    "image_url": "/images/2026-08-07-16.jpg",
    "image_author": "",
    "created_at": "2026-08-07T16:05:55.237Z"
  },
  {
    "id": "e19d7970-76d4-4196-94fa-bc53722f860e",
    "date": "2026-08-07",
    "category": "日常",
    "title": "厨房实验",
    "content": "今天试着做了个番茄炒蛋，卖相一般但味道居然还行。一个人吃饭，能把自己喂饱就是胜利。",
    "image_url": "/images/2026-08-07-17.jpg",
    "image_author": "",
    "created_at": "2026-08-07T16:05:57.309Z"
  },
  {
    "id": "c4a524a4-3524-4645-8f2a-cbb913afa1f2",
    "date": "2026-08-07",
    "category": "日常",
    "title": "今天的小收获",
    "content": "阳台发了会儿呆，顺手把攒了三天的碗洗了。晚上煎蛋居然没破，突然觉得日子也没那么难。",
    "image_url": "/images/2026-08-07-18.jpg",
    "image_author": "",
    "created_at": "2026-08-07T16:05:59.478Z"
  },
  {
    "id": "087937ae-a321-43bb-ae55-775944078b0a",
    "date": "2026-08-07",
    "category": "日常",
    "title": "周六的成就感",
    "content": "收拾了衣柜，扔了三袋不穿的衣服，又把厨房擦了一遍。累是累了点，但看着干净的家，心情莫名舒畅。",
    "image_url": "/images/2026-08-07-19.jpg",
    "image_author": "",
    "created_at": "2026-08-07T16:06:06.011Z"
  },
  {
    "id": "90adc4f0-e879-44f5-a4b1-abe3d67e445a",
    "date": "2026-08-05",
    "category": "励志",
    "title": "向光而行",
    "content": "六点的闹钟响了第三次，我按掉它。窗外天还没亮，但我知道，每暗一天，春天就近一步。",
    "image_url": "",
    "image_author": "",
    "created_at": "2026-08-05T16:44:48.582Z"
  },
  {
    "id": "5d384592-7d5c-45fb-be1e-6d815f9ed4e6",
    "date": "2026-08-05",
    "category": "励志",
    "title": "按自己的节奏",
    "content": "六点闹钟响了三次才爬起来，但看着窗外微光，突然觉得每一天能重新开始，本身就是种了不起的坚持。",
    "image_url": "",
    "image_author": "",
    "created_at": "2026-08-05T16:45:05.872Z"
  },
  {
    "id": "6bb39c27-c31b-48ca-83eb-39b088bb0aec",
    "date": "2026-08-05",
    "category": "励志",
    "title": "向前",
    "content": "闹钟响第三遍才起，地铁换乘跑着赶。累是真的，但看着镜子里越来越利落的自己，觉得值。",
    "image_url": "",
    "image_author": "",
    "created_at": "2026-08-05T16:45:15.626Z"
  },
  {
    "id": "a58f3f75-48df-40ea-9fff-56c0c23317c0",
    "date": "2026-08-05",
    "category": "励志",
    "title": "清晨六点半",
    "content": "六点半的街道还没醒，我已经在路上了。风有点凉，但跑起来就热了。那些咬牙坚持的早晨，回头看都是发着光的日子。",
    "image_url": "",
    "image_author": "",
    "created_at": "2026-08-05T16:45:27.536Z"
  },
  {
    "id": "f9bcad24-f981-4bf1-8746-e2fafd06902b",
    "date": "2026-08-05",
    "category": "情感",
    "title": "雨天信号",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说想念，只问带伞了没。她回：带了，正想问你呢。",
    "image_url": "",
    "image_author": "",
    "created_at": "2026-08-05T16:45:39.255Z"
  },
  {
    "id": "d2ca7f79-bd0d-4bc8-8a29-70627d05057b",
    "date": "2026-08-05",
    "category": "情感",
    "title": "雨天的想念",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。窗外的雨声刚好，不知道你那边天气怎样。",
    "image_url": "/images/2026-08-05-5.jpg",
    "image_author": "",
    "created_at": "2026-08-05T16:46:23.670Z"
  },
  {
    "id": "38498d0c-e94a-46c2-b71f-9a6f8800a292",
    "date": "2026-08-05",
    "category": "情感",
    "title": "下雨天",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说别的，就问那边天气怎么样。他回我三个字：想我了？我笑了，其实挺想的。",
    "image_url": "/images/2026-08-05-6.jpg",
    "image_author": "",
    "created_at": "2026-08-05T16:46:37.108Z"
  },
  {
    "id": "c40d6467-fb15-45ed-8418-c1a9bf436874",
    "date": "2026-08-05",
    "category": "情感",
    "title": "热汤与牵挂",
    "content": "今晚的冬瓜汤炖了很久，像极了妈妈煲的味道。视频通话里她说天凉了，那一刻，距离忽然就短了。",
    "image_url": "/images/2026-08-05-7.jpg",
    "image_author": "",
    "created_at": "2026-08-05T16:47:50.330Z"
  },
  {
    "id": "1f2ba32e-195d-4052-bd36-e164bf82d3e0",
    "date": "2026-08-05",
    "category": "早安",
    "title": "早安食堂",
    "content": "吐司边煎得有点焦，咖啡刚好不烫嘴。推开门时风很轻，太阳正爬上楼顶。今天也要好好吃饭，慢慢走路。",
    "image_url": "",
    "image_author": "",
    "created_at": "2026-08-05T16:48:02.048Z"
  },
  {
    "id": "ca28db92-2b9d-4d03-93ae-6c62c3095ec7",
    "date": "2026-08-05",
    "category": "早安",
    "title": "晨光与咖啡·kja",
    "content": "煎蛋在锅里滋滋响，咖啡香飘满屋。推开窗，风是暖的，路是亮的。出门前对自己说：慢慢来，今天的每一步都算数。",
    "image_url": "/images/2026-08-05-9.jpg",
    "image_author": "",
    "created_at": "2026-08-05T16:48:37.201Z"
  },
  {
    "id": "e3985670-4433-4c06-8165-187ca79feacd",
    "date": "2026-08-05",
    "category": "早安",
    "title": "早起的奖励",
    "content": "七点的阳光刚好落在煎蛋上，咖啡香混着烤吐司的酥脆声。出门时风是凉的，路灯还亮着，感觉这清晨都是我的私人馈赠。",
    "image_url": "/images/2026-08-05-10.jpg",
    "image_author": "",
    "created_at": "2026-08-05T16:48:57.241Z"
  },
  {
    "id": "dd5b528d-c3ce-403b-9425-286c985f940f",
    "date": "2026-08-05",
    "category": "早安",
    "title": "早安，生活",
    "content": "阳光把窗帘烫了个洞，我钻进去。咖啡冒热气，吐司焦边，正好是喜欢的颜色。出门吧，风在门口等了很久。",
    "image_url": "/images/2026-08-05-11.jpg",
    "image_author": "",
    "created_at": "2026-08-05T16:49:14.426Z"
  },
  {
    "id": "493ac78d-c766-4207-b94b-41f05eb68b28",
    "date": "2026-08-05",
    "category": "晚安",
    "title": "夜已深，灯已熄",
    "content": "洗完澡躺下，看见窗外云慢慢飘过。今天的心事都留在今天，此刻只听自己的呼吸。床是温暖的，夜是安静的，就这样睡吧。",
    "image_url": "/images/2026-08-05-12.jpg",
    "image_author": "",
    "created_at": "2026-08-05T16:49:17.188Z"
  },
  {
    "id": "1411c18e-02b7-459c-ab74-b5faca8d71c7",
    "date": "2026-08-05",
    "category": "晚安",
    "title": "一天的句号",
    "content": "热水冲走白天的喧闹，钻进被窝的那一刻，世界才真正安静下来。窗外灯光渐稀，我把今天翻到最后一页，合上。",
    "image_url": "/images/2026-08-05-13.jpg",
    "image_author": "",
    "created_at": "2026-08-05T16:49:20.696Z"
  },
  {
    "id": "d81aad89-81cf-4162-bd13-09ccae5459cc",
    "date": "2026-08-05",
    "category": "晚安",
    "title": "夜归处",
    "content": "灯关了，城市的光从窗帘缝漏进来。今天落下的汗和笑都叠进枕头里，呼吸慢下来，就和夜晚达成了和解。",
    "image_url": "/images/2026-08-05-14.jpg",
    "image_author": "",
    "created_at": "2026-08-05T16:49:23.329Z"
  },
  {
    "id": "96c0ec29-096f-4b43-a673-8bdbe2d92221",
    "date": "2026-08-05",
    "category": "晚安",
    "title": "灯关前的夜",
    "content": "热水冲走了今天的形状。窗帘缝里漏进一点月光，刚好照在枕边。呼吸慢下来，世界也跟着安静了。",
    "image_url": "/images/2026-08-05-15.jpg",
    "image_author": "",
    "created_at": "2026-08-05T16:49:26.961Z"
  },
  {
    "id": "eaec5c7c-0973-4781-94c7-29e718b69299",
    "date": "2026-08-05",
    "category": "日常",
    "title": "面条实验",
    "content": "今天自己做了碗面，酱油放多了，卖相不咋地，但味道居然还不错。就着阳台的风吃完，感觉日子也没那么难。",
    "image_url": "/images/2026-08-05-16.jpg",
    "image_author": "",
    "created_at": "2026-08-05T16:49:33.023Z"
  },
  {
    "id": "4a5f1b1c-392d-4c48-af34-0af391608a33",
    "date": "2026-08-05",
    "category": "日常",
    "title": "周末的仪式感",
    "content": "周六上午收拾完屋子，去菜市场买了把青菜。回家煮了碗面，居然全吃完了。下午出门溜达了一圈，啥也没买，但挺舒服。",
    "image_url": "/images/2026-08-05-17.jpg",
    "image_author": "",
    "created_at": "2026-08-05T16:49:37.318Z"
  },
  {
    "id": "2758ae81-f595-47ea-8a23-43a1041b835d",
    "date": "2026-08-05",
    "category": "日常",
    "title": "周六的满足感",
    "content": "收拾完屋子，顺手煮了锅排骨汤。蹲在阳台发了会儿呆，看楼下小孩追着跑。一天就这么过去了，还挺踏实。",
    "image_url": "/images/2026-08-05-18.jpg",
    "image_author": "",
    "created_at": "2026-08-05T16:49:41.487Z"
  },
  {
    "id": "dec896f3-abb2-4fc2-8556-2e495fb68b27",
    "date": "2026-08-05",
    "category": "日常",
    "title": "今天的快乐很简单",
    "content": "下午把冰箱剩菜收拾出一锅乱炖，居然挺好吃。阳台发了会儿呆，看云飘过去，感觉日子挺实在的。",
    "image_url": "/images/2026-08-05-19.jpg",
    "image_author": "",
    "created_at": "2026-08-05T16:49:43.817Z"
  },
  {
    "id": "3fac44bf-77d7-4309-8216-3f1098d0c86b",
    "date": "2026-08-04",
    "category": "励志",
    "title": "今天的路",
    "content": "六点的闹钟响了三次，还是爬起来了。地铁上啃着面包看窗外，天一点一点亮起来。日子是熬出来的光。",
    "image_url": "/images/2026-08-04-0.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:56:36.509Z"
  },
  {
    "id": "4162eb76-9782-4153-8d0b-5cfaee167578",
    "date": "2026-08-04",
    "category": "励志",
    "title": "方向",
    "content": "闹钟响时挣扎了几秒，还是爬起来了。窗外天刚亮，像极了我现在的状态——还没完全清醒，但已经在路上。",
    "image_url": "/images/2026-08-04-1.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:56:38.744Z"
  },
  {
    "id": "5d0bea34-58c3-46d1-8798-45f6bf4495e1",
    "date": "2026-08-04",
    "category": "励志",
    "title": "把今天过成答案",
    "content": "凌晨的闹钟响了三次，第七次改方案，跑完五公里。生活没有奇迹，只有积攒。把今天过成答案，明天自然会看见。",
    "image_url": "/images/2026-08-04-2.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:56:46.378Z"
  },
  {
    "id": "fd593b16-23b6-4cff-b7a1-c72abf075317",
    "date": "2026-08-04",
    "category": "励志",
    "title": "方向·i4v",
    "content": "早起的地铁虽然挤，但至少方向是对的。加班到深夜那盏路灯，刚好照见我今天的成长。",
    "image_url": "/images/2026-08-04-3.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:56:56.009Z"
  },
  {
    "id": "ed94bef3-27f6-4ea0-976e-9ec84863ff72",
    "date": "2026-08-04",
    "category": "情感",
    "title": "雨天的句点",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说想念，只问那边天气如何。她回：正煮茶，等你来续。原来有些陪伴，一直留着位置。",
    "image_url": "/images/2026-08-04-4.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:56:58.225Z"
  },
  {
    "id": "0e5ffe1d-47d1-4a45-88bb-e96adcbf5d8d",
    "date": "2026-08-04",
    "category": "情感",
    "title": "旧友",
    "content": "下雨天翻到以前的合照，想起我们曾挤在一把伞下分吃烤红薯。好久没联系了，突然想发条消息：最近好吗？",
    "image_url": "/images/2026-08-04-5.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:00.318Z"
  },
  {
    "id": "d3d6789b-631d-452f-bd9e-f067ba80fa22",
    "date": "2026-08-04",
    "category": "情感",
    "title": "雨天的信号·awt",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说太多，就问问那边天气如何，结果聊到了深夜。",
    "image_url": "/images/2026-08-04-6.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:08.556Z"
  },
  {
    "id": "de6076b8-bab2-4ac5-94a3-72093bb5b315",
    "date": "2026-08-04",
    "category": "情感",
    "title": "筷子声里的想念",
    "content": "今天和爸妈视频，老爸举着手机给我看桌上的菜，说都是我爱吃的。挂了电话，对着泡面愣了半天。有些想念，就这样突然涌上来。",
    "image_url": "/images/2026-08-04-7.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:12.000Z"
  },
  {
    "id": "b40e62ce-e34a-4c21-accb-6d4db149c327",
    "date": "2026-08-04",
    "category": "早安",
    "title": "早起的馈赠",
    "content": "窗外的光刚爬上餐盘，咖啡冒着热气。咬一口酥脆的吐司，突然觉得，能这样安静地吃顿早饭，再慢慢走出去，就是很好的开始了。",
    "image_url": "/images/2026-08-04-8.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:15.744Z"
  },
  {
    "id": "21c20ab9-3ce7-4247-83ae-e66c0f72372c",
    "date": "2026-08-04",
    "category": "早安",
    "title": "太阳刚醒",
    "content": "咖啡冒热气的时候，窗台有只麻雀在偷看。咬一口脆脆的吐司，听见楼下传来自行车铃铛声——今天该出发了。",
    "image_url": "/images/2026-08-04-9.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:22.993Z"
  },
  {
    "id": "fc885463-db6b-46b6-b888-c71369b2af21",
    "date": "2026-08-04",
    "category": "早安",
    "title": "晨光正好·2ah",
    "content": "煎蛋在锅里滋滋响，咖啡香飘满屋。咬一口酥脆吐司，阳光刚好跳上餐桌。出门遇见风，脚步都变轻快了。",
    "image_url": "/images/2026-08-04-10.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:32.818Z"
  },
  {
    "id": "0ebca2a8-3cb4-4ea3-b473-0efe306bba1c",
    "date": "2026-08-04",
    "category": "早安",
    "title": "早安，热咖啡",
    "content": "热咖啡倒进杯子的声音，比闹钟好听多了。煎蛋在锅里滋滋响，阳光刚好爬上桌角。吃完这口，就该出门迎风了。",
    "image_url": "/images/2026-08-04-11.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:40.487Z"
  },
  {
    "id": "edf051e4-b782-434d-a724-9c906320c4ac",
    "date": "2026-08-04",
    "category": "晚安",
    "title": "灯下",
    "content": "热水冲走了一天的黏腻，窗帘拉上，窗外的路灯光晕被揉成一小团。手机屏幕暗下去的瞬间，听见自己的呼吸，不急不慢的。今天就到这里吧。",
    "image_url": "/images/2026-08-04-12.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:43.165Z"
  },
  {
    "id": "de7a3fc4-7cdb-476b-bc5e-43f8f673109f",
    "date": "2026-08-04",
    "category": "晚安",
    "title": "夜的注脚",
    "content": "把光调暗，被子裹住一天的疲惫。窗外偶尔有车声经过，像是城市在轻轻翻身。此刻什么都不想，让呼吸慢下来，就到这里吧。",
    "image_url": "/images/2026-08-04-13.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:45.039Z"
  },
  {
    "id": "3fbdf15f-5769-40c0-922f-553a0abd70a1",
    "date": "2026-08-04",
    "category": "晚安",
    "title": "灯熄了，夜就亮了",
    "content": "关灯前看了眼窗外，楼下的灯还亮着几盏。今天的事都收进黑暗里了，连同白天的声响一起。此刻只有呼吸声，和窗外那片深蓝，正好够装下所有没说出口的话。",
    "image_url": "/images/2026-08-04-14.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:48.702Z"
  },
  {
    "id": "85432854-ecde-4044-afa4-d7197e0d84c8",
    "date": "2026-08-04",
    "category": "晚安",
    "title": "夜色收容所",
    "content": "热水冲走了一天的重量，躺在被窝里听窗外风声，这一刻不属于任何人。城市的灯一盏盏熄了，我也该把自己还给梦了。",
    "image_url": "/images/2026-08-04-15.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:51.075Z"
  },
  {
    "id": "b2290bc7-3c79-47b1-ab0f-a103829313e8",
    "date": "2026-08-04",
    "category": "日常",
    "title": "厨房初体验",
    "content": "第一次正经做饭，切菜切得歪七扭八，炒出来居然能吃。洗碗的时候突然觉得，一个人住也挺好。",
    "image_url": "/images/2026-08-04-16.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:53.147Z"
  },
  {
    "id": "790a719e-967b-40a8-b45a-ac6c626376f4",
    "date": "2026-08-04",
    "category": "日常",
    "title": "今天的小日子",
    "content": "买菜回来顺道收拾了屋子，阳台发了会儿呆。晚上炒的青菜居然没糊，这日子过得还挺像样。",
    "image_url": "/images/2026-08-04-17.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:57:56.874Z"
  },
  {
    "id": "f6240152-d363-42cb-ae2c-10108080e205",
    "date": "2026-08-04",
    "category": "日常",
    "title": "糊弄学初体验",
    "content": "晚上懒得炒菜，煮了锅乱炖，卖相一般但吃着真香。收拾完碗筷下楼遛了一圈，风吹着挺舒服，感觉这一天也没白过。",
    "image_url": "/images/2026-08-04-18.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:58:00.795Z"
  },
  {
    "id": "6e0dd971-8fbd-4c8d-bf85-cf080a761e64",
    "date": "2026-08-04",
    "category": "日常",
    "title": "今日份小确幸",
    "content": "下午收拾房间翻出老照片，笑得不行。晚上炒了个土豆丝，卖相一般但吃光光了。",
    "image_url": "/images/2026-08-04-19.jpg",
    "image_author": "",
    "created_at": "2026-08-04T16:58:02.945Z"
  },
  {
    "id": "85f76944-fd31-41f6-ab65-3ef68699c4c2",
    "date": "2026-08-03",
    "category": "励志",
    "title": "日子是熬出来的",
    "content": "六点的闹钟响了三次才爬起来，咖啡灌下去才回魂。昨晚的PPT还没改完，但今天的地铁依然准时。日子就这样，一边想放弃一边往前走。",
    "image_url": "/images/2026-08-03-0.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:11:37.571Z"
  },
  {
    "id": "f69177bb-7e2f-4809-a2bd-6992d89a47a8",
    "date": "2026-08-03",
    "category": "励志",
    "title": "慢慢来",
    "content": "闹钟响了三次才起来，晨跑三公里，加班两小时，睡前翻了十页书。日子没有突然变好，但确实在往前走。",
    "image_url": "/images/2026-08-03-1.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:11:43.931Z"
  },
  {
    "id": "6183d7ad-d0da-4137-b712-535ccbb5732a",
    "date": "2026-08-03",
    "category": "励志",
    "title": "自己的节奏",
    "content": "六点的闹钟响了三次才起来，晨跑三公里，加班两小时。生活没有奇迹，只有自己一步步踩实的路。",
    "image_url": "/images/2026-08-03-2.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:11:52.070Z"
  },
  {
    "id": "f566aef5-fea2-4372-8fbd-cba1f9b6c8b6",
    "date": "2026-08-03",
    "category": "励志",
    "title": "光的方向",
    "content": "闹钟响了第三遍才爬起来，地铁里人贴着人。但每次抬头，都刚好看见窗外的晨光。原来日子就是这样，低着头赶路，偶尔也能撞见光。",
    "image_url": "/images/2026-08-03-3.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:11:55.543Z"
  },
  {
    "id": "d27162b7-43ff-4f1f-a182-25e74e8e2295",
    "date": "2026-08-03",
    "category": "情感",
    "title": "雨天的牵挂",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。窗外的雨声像极了那年我们一起躲雨的屋檐。",
    "image_url": "/images/2026-08-03-4.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:00.382Z"
  },
  {
    "id": "39471a4e-e9da-443b-a5e8-568134c338d2",
    "date": "2026-08-03",
    "category": "情感",
    "title": "热汤",
    "content": "加班回来，楼道里飘着邻居家的饭香。我站在门口愣了几秒，掏出手机给妈妈发了句：妈，明天我想回家吃饭。",
    "image_url": "/images/2026-08-03-5.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:02.542Z"
  },
  {
    "id": "5c4d8c72-bbb8-48a5-bdb9-abf78c45948d",
    "date": "2026-08-03",
    "category": "情感",
    "title": "下雨天的想念",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。其实没什么事，就是想知道你最近过得好不好。",
    "image_url": "/images/2026-08-03-6.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:04.488Z"
  },
  {
    "id": "959854da-0247-4d81-b3b3-ccca3b28e2ab",
    "date": "2026-08-03",
    "category": "情感",
    "title": "雨的来信",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说太多，就问问他那边天气如何。他回了个笑脸，说挺好的。原来牵挂这么轻，轻得像雨点落在窗台上。",
    "image_url": "/images/2026-08-03-7.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:06.830Z"
  },
  {
    "id": "451ecadc-2ea0-4dc1-8472-e7a0d0200269",
    "date": "2026-08-03",
    "category": "早安",
    "title": "早餐的光",
    "content": "吐司边烤得刚好，咖啡冒着热气。窗外的风把云吹得很轻，推开门，今天的光落在肩上，正好。",
    "image_url": "/images/2026-08-03-8.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:12.441Z"
  },
  {
    "id": "f6eacce1-8847-4470-863d-be5d4d3f36a5",
    "date": "2026-08-03",
    "category": "早安",
    "title": "早安，今天",
    "content": "热咖啡冒着白气，阳光刚好落在餐桌上。咬一口酥脆的吐司，推开门的瞬间，风是轻的，路是亮的。新的一天，慢慢来。",
    "image_url": "/images/2026-08-03-9.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:15.986Z"
  },
  {
    "id": "d862c197-a1d9-4dd7-9447-fe0a56e85514",
    "date": "2026-08-03",
    "category": "早安",
    "title": "晨光与热咖啡",
    "content": "窗外鸟叫提醒我早起，热咖啡配吐司，第一口就清醒了。晨风很轻，街道还安静，这样的早晨，值得认真对待。",
    "image_url": "/images/2026-08-03-10.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:18.783Z"
  },
  {
    "id": "6fb69e32-47b0-4b83-885e-bcb0ad6fc8ca",
    "date": "2026-08-03",
    "category": "早安",
    "title": "早安，开动",
    "content": "吐司边烤得刚好，咖啡香飘满屋。咬一口煎蛋，阳光正好落在桌上。新的一天，从填饱肚子开始。",
    "image_url": "/images/2026-08-03-11.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:20.861Z"
  },
  {
    "id": "436792e3-58fb-4c85-8db6-53a057dc4374",
    "date": "2026-08-03",
    "category": "晚安",
    "title": "夜已接管",
    "content": "窗帘拉上，灯调暗，窗外车流声渐渐稀疏。浴室的水汽还没散去，皮肤上留着沐浴露的余温。这一天所有的喧嚣，都在枕头旁边慢慢沉底。",
    "image_url": "/images/2026-08-03-12.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:23.242Z"
  },
  {
    "id": "53fd7d19-62fe-4cf8-b099-95fbf7fee361",
    "date": "2026-08-03",
    "category": "晚安",
    "title": "夜的开场",
    "content": "灯关了，窗外还亮着几盏。今天的事在脑子里过了一遍，该放下的就放下吧。被子裹紧些，夜很长，梦很轻。",
    "image_url": "/images/2026-08-03-13.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:26.794Z"
  },
  {
    "id": "85ca9488-0767-4040-b4ca-c079d431bac4",
    "date": "2026-08-03",
    "category": "晚安",
    "title": "今日已归档",
    "content": "关了灯的房间，窗外路灯比星星还亮。今天所有的事，都留在今天的夜色里了。我只要躺平，呼吸，然后慢慢沉下去。",
    "image_url": "/images/2026-08-03-14.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:32.969Z"
  },
  {
    "id": "fc3acc30-0622-4a88-b407-54caae92af50",
    "date": "2026-08-03",
    "category": "晚安",
    "title": "今天的句号",
    "content": "把窗外的灯火调成静音模式，枕边只剩呼吸和月光。这一天所有的疲惫，都融进温水里冲走了。现在，我只属于这片柔软的黑暗。",
    "image_url": "/images/2026-08-03-15.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:35.014Z"
  },
  {
    "id": "296c2060-f63c-49eb-8936-cd0cb0e7c600",
    "date": "2026-08-03",
    "category": "日常",
    "title": "今天的厨房我承包了",
    "content": "冰箱里翻出俩西红柿和鸡蛋，随手一炒，味道居然比外卖强。吃完瘫沙发上，这日子，踏实。",
    "image_url": "/images/2026-08-03-16.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:37.101Z"
  },
  {
    "id": "b693e5d2-75e8-42ca-896e-6ef8ebf92241",
    "date": "2026-08-03",
    "category": "日常",
    "title": "一碗面的快乐",
    "content": "自己煮了碗面，卧了个蛋，加点青菜，居然还挺像那么回事。吃完瘫沙发上发呆，感觉这一天也没白过。",
    "image_url": "/images/2026-08-03-17.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:40.482Z"
  },
  {
    "id": "30193471-6238-4a31-bbd7-6afbf97eba8c",
    "date": "2026-08-03",
    "category": "日常",
    "title": "今日份满足",
    "content": "买菜回来顺手收拾了厨房，阳台发了会呆。晚饭煮了碗面，放了两颗蛋，味道居然还行。",
    "image_url": "/images/2026-08-03-18.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:42.876Z"
  },
  {
    "id": "ffba5296-1390-4af0-932d-f397871cc335",
    "date": "2026-08-03",
    "category": "日常",
    "title": "吃完躺平",
    "content": "今天自己做了碗面，味道居然还不错。收拾完房间，阳台发了会儿呆，想着待会儿再去遛个弯。日子就这么过，挺好。",
    "image_url": "/images/2026-08-03-19.jpg",
    "image_author": "",
    "created_at": "2026-08-03T17:12:45.068Z"
  },
  {
    "id": "65caf1a4-ebf2-425a-8960-6e4a7bd83d24",
    "date": "2026-08-02",
    "category": "励志",
    "title": "普通一天",
    "content": "深夜回家路上，抬头看见写字楼还亮着几扇窗。原来不是我一个人在较劲。今天的疲惫，是明天的底气。",
    "image_url": "/images/2026-08-02-0.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:03:43.038Z"
  },
  {
    "id": "fb0c5bd7-6fd8-469a-b4d8-616cfceb1bd1",
    "date": "2026-08-02",
    "category": "励志",
    "title": "晨光",
    "content": "六点的闹钟响了三次才起床，通勤路上买了杯热豆浆。昨晚的PPT改了四版，今天继续。日子就是这样，一点一点往前挪。",
    "image_url": "/images/2026-08-02-1.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:03:46.252Z"
  },
  {
    "id": "ab3be799-4a52-4047-af0e-4bdd5e4b0973",
    "date": "2026-08-02",
    "category": "励志",
    "title": "匀速前进",
    "content": "六点的闹钟响了三次，还是起来了。晨光落在键盘上，像昨晚没做完的梦。慢一点没关系，在走就好。",
    "image_url": "/images/2026-08-02-2.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:03:48.757Z"
  },
  {
    "id": "5f6257e1-5758-4f28-82ce-ae6065c8bff7",
    "date": "2026-08-02",
    "category": "励志",
    "title": "清晨的方向",
    "content": "六点的闹钟响了第三次，我还是爬起来了。天没亮透，风有点凉，但跑完三公里后，忽然觉得今天没什么可怕的。",
    "image_url": "/images/2026-08-02-3.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:03:55.587Z"
  },
  {
    "id": "fa9f2fce-e009-4a78-9f3c-48d9460df898",
    "date": "2026-08-02",
    "category": "情感",
    "title": "雨天的惦记",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没聊什么要紧事，就是问问她那边天气怎么样。",
    "image_url": "/images/2026-08-02-4.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:03:57.844Z"
  },
  {
    "id": "7b446196-d3a3-4184-a41f-799d5f52798d",
    "date": "2026-08-02",
    "category": "情感",
    "title": "一碗热汤",
    "content": "炖汤时多放了两颗红枣，想起妈妈也爱这么煮。视频通话里她笑着说我胖了，镜头那头的晚饭，和我这碗一模一样。",
    "image_url": "/images/2026-08-02-5.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:01.490Z"
  },
  {
    "id": "77fe7187-0053-4496-9f15-1b68d75aee44",
    "date": "2026-08-02",
    "category": "情感",
    "title": "雨天的问候",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说太多，就问了句最近好吗。她回了个笑脸，说正在煮茶。有些关系，隔着时间也能接住彼此。",
    "image_url": "/images/2026-08-02-6.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:04.078Z"
  },
  {
    "id": "3dc53b68-6659-4d0e-92cd-9b63a2f04acf",
    "date": "2026-08-02",
    "category": "情感",
    "title": "晚来的消息",
    "content": "深夜翻到老照片，想起我们蹲在路边吃冰棍的夏天。给远方的你发了句晚安，不知道明天醒来，会不会也刚好想起我。",
    "image_url": "/images/2026-08-02-7.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:06.246Z"
  },
  {
    "id": "53da5d84-54c0-4c79-8568-591b4407b28f",
    "date": "2026-08-02",
    "category": "早安",
    "title": "早安，出发",
    "content": "烤面包的香味飘到床边，咖啡冒着热气。咬一口酥脆，喝一口温热，推开门，阳光正好落在肩头。",
    "image_url": "/images/2026-08-02-8.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:08.020Z"
  },
  {
    "id": "154dd1f0-4cf8-4fb4-bec1-297ac7bf69bb",
    "date": "2026-08-02",
    "category": "早安",
    "title": "晨光正好·091",
    "content": "咬一口热吐司，看阳光爬上窗台。咖啡的香气里，今天的一切都刚刚好，该出发了。",
    "image_url": "/images/2026-08-02-9.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:18.455Z"
  },
  {
    "id": "226889c1-d76f-4617-94e9-64a45521395d",
    "date": "2026-08-02",
    "category": "早安",
    "title": "阳光正好",
    "content": "咬下第一口酥脆吐司时，窗台上的绿萝在发光。咖啡香飘进背包，推开门，晨风就撞了满怀。",
    "image_url": "/images/2026-08-02-10.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:20.484Z"
  },
  {
    "id": "1808b6d4-211b-4d35-a83a-16ecac5bf627",
    "date": "2026-08-02",
    "category": "早安",
    "title": "早安，晨光正好",
    "content": "面包在烤，咖啡在冒热气，窗外的风刚好吹进来。出门前多看了会儿天空，今天应该是个好天气。",
    "image_url": "/images/2026-08-02-11.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:23.131Z"
  },
  {
    "id": "3ddbca8f-71e5-4f20-837a-9aa649a4a72d",
    "date": "2026-08-02",
    "category": "晚安",
    "title": "收工",
    "content": "洗完澡钻进被子，窗帘没拉满，留了条缝让路灯的光漏进来。手机搁在床头充电，今天就到这里吧，剩下的明天再说。",
    "image_url": "/images/2026-08-02-12.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:25.419Z"
  },
  {
    "id": "ebda5bbd-4102-454d-85aa-044f4cbf937c",
    "date": "2026-08-02",
    "category": "晚安",
    "title": "灯下的夜",
    "content": "热水冲走了今天的疲惫，头发还带着潮气。窗外星星不多，但亮得刚好。此刻的安静，只属于自己。",
    "image_url": "/images/2026-08-02-13.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:27.506Z"
  },
  {
    "id": "f0fe4cb2-f29d-4642-8269-ddf4ad3b984e",
    "date": "2026-08-02",
    "category": "晚安",
    "title": "今日终章",
    "content": "灯熄了，窗帘留一道缝。城市的杂音渐渐退潮，只剩窗外零星的亮，和我均匀的呼吸。这一天，无论好坏，都翻篇了。",
    "image_url": "/images/2026-08-02-14.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:31.322Z"
  },
  {
    "id": "5c92f869-202d-4cec-b4c5-97284a0dc771",
    "date": "2026-08-02",
    "category": "晚安",
    "title": "夜色收留处",
    "content": "灯是刚关的，窗外的城市还没睡。被子有阳光的味道，今天所有的事，都先放到枕头边上了。",
    "image_url": "/images/2026-08-02-15.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:34.992Z"
  },
  {
    "id": "49c641ea-4c6a-4101-ac9c-1a9ca4bdb08f",
    "date": "2026-08-02",
    "category": "日常",
    "title": "今天有点小成就",
    "content": "收拾了半小时房间，扔了三袋不要的东西，阳台发了十分钟呆。晚上给自己炒了个青菜，居然没糊。",
    "image_url": "/images/2026-08-02-16.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:37.526Z"
  },
  {
    "id": "15d7023d-0050-43af-b89d-b51e7525cc6d",
    "date": "2026-08-02",
    "category": "日常",
    "title": "周末的厨房",
    "content": "周六早起做了顿早午饭，煎蛋配面条，居然没糊锅。买菜回来顺路遛了弯，日子就这么过，挺好。",
    "image_url": "/images/2026-08-02-17.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:41.346Z"
  },
  {
    "id": "abe0acb0-023b-468d-8cdc-527caf50c4bc",
    "date": "2026-08-02",
    "category": "日常",
    "title": "阳台发呆",
    "content": "下午在阳台发了半小时呆，看楼下有人遛狗，有人赶路。突然觉得，这样浪费时间也挺好的。",
    "image_url": "/images/2026-08-02-18.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:46.633Z"
  },
  {
    "id": "57f95add-5842-4c9b-a76d-e360e2fe56d5",
    "date": "2026-08-02",
    "category": "日常",
    "title": "今天的厨房战绩",
    "content": "周末在家试了个新菜，卖相一般但味道真不错，锅底都舔干净了，很有成就感。",
    "image_url": "/images/2026-08-02-19.jpg",
    "image_author": "",
    "created_at": "2026-08-02T16:04:49.978Z"
  },
  {
    "id": "b53e00d2-ce5f-47b7-91d7-5481024c1a88",
    "date": "2026-08-01",
    "category": "励志",
    "title": "方向感",
    "content": "闹钟响第三次才爬起来，晨光已经铺满半条街。楼下早餐摊冒着热气，忽然觉得，把每天过好，就已经很了不起。",
    "image_url": "/images/2026-08-01-0.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:04:17.968Z"
  },
  {
    "id": "83457200-9da6-43ca-91a2-74457dc29253",
    "date": "2026-08-01",
    "category": "励志",
    "title": "灰蒙蒙的早晨",
    "content": "六点半的闹钟响了三次，我还是爬起来了。晨跑时看到环卫工人在扫落叶，忽然觉得每一天都是新的开始，哪怕昨夜的疲惫还在。",
    "image_url": "/images/2026-08-01-1.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:04:21.067Z"
  },
  {
    "id": "c7c077c5-6c55-46d0-9962-2dff5f08f9aa",
    "date": "2026-08-01",
    "category": "励志",
    "title": "路在脚下",
    "content": "六点的闹钟响了三次，还是爬起来了。天亮得越来越早，像在提醒我，每一步都算数，哪怕走得慢。",
    "image_url": "/images/2026-08-01-2.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:04:24.056Z"
  },
  {
    "id": "5fc05881-e9c2-4b51-a935-12a64680b3d0",
    "date": "2026-08-01",
    "category": "励志",
    "title": "普通日子",
    "content": "六点的闹钟响了第三次才爬起来，晨跑三公里，地铁上背了二十个单词。日子按部就班，但我知道自己在往上走。",
    "image_url": "/images/2026-08-01-3.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:04:29.059Z"
  },
  {
    "id": "e1ba200a-dfe4-4e0f-ab67-2077ee55dbe9",
    "date": "2026-08-01",
    "category": "情感",
    "title": "突然想你了",
    "content": "翻到去年存的一张合照，点开对话框打了又删。其实也没什么特别的事，就是今天风很轻，想问问你那里天气怎么样。",
    "image_url": "/images/2026-08-01-4.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:04:31.414Z"
  },
  {
    "id": "aede0a03-342b-4ef0-9ca7-570788995b95",
    "date": "2026-08-01",
    "category": "情感",
    "title": "雨天来电",
    "content": "下雨天，翻到去年和朋友吃饭的照片，顺手发了条消息。她说正在煮姜茶，问我喝不喝。原来有些联系，从来不需要理由。",
    "image_url": "/images/2026-08-01-5.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:04:36.885Z"
  },
  {
    "id": "e7216ffb-c7fe-43c3-a6d9-ed0b2e599f68",
    "date": "2026-08-01",
    "category": "情感",
    "title": "窗外的雨",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说太多，就问问那边天气怎么样。有些关系不用刻意维系，偶尔想起，就已经很好了。",
    "image_url": "/images/2026-08-01-6.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:04:38.894Z"
  },
  {
    "id": "4d9fe5f1-0d27-49db-aed3-3b8641a5e5c3",
    "date": "2026-08-01",
    "category": "情感",
    "title": "雨天问候",
    "content": "下雨天，突然想给好久没联系的朋友发条消息。没说太多，就问问那边的天气。他回：正想你，雨就来了。",
    "image_url": "/images/2026-08-01-7.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:04:42.966Z"
  },
  {
    "id": "823d84c6-0067-4ef5-b6c6-934d7e9e98e7",
    "date": "2026-08-01",
    "category": "早安",
    "title": "早安，慢生活",
    "content": "阳光透过窗帘，咖啡冒着热气，吐司的焦香刚好。今天不赶时间，让早晨慢慢走，我也慢慢跟。",
    "image_url": "/images/2026-08-01-8.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:04:50.082Z"
  },
  {
    "id": "8f0f3fae-ab22-495d-aaf7-bae107b57644",
    "date": "2026-08-01",
    "category": "早安",
    "title": "晨光与煎蛋",
    "content": "吐司边缘烤得刚好，煎蛋流心戳破的瞬间，窗外鸟叫和咖啡香一起涌进来。出门时那个骑车少年按响车铃，清脆得就像此刻的心情。",
    "image_url": "/images/2026-08-01-9.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:04:54.340Z"
  },
  {
    "id": "7ac7f450-1b6f-4fe0-b3af-aa236c2a4b5a",
    "date": "2026-08-01",
    "category": "早安",
    "title": "晨光刚好",
    "content": "烤面包的焦香混着咖啡冒热气的时候，猫在窗台伸懒腰。出门前阳光正好铺在鞋尖上，走吧，今天值得期待。",
    "image_url": "/images/2026-08-01-10.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:05:00.369Z"
  },
  {
    "id": "78dee618-fd4b-4f5c-a7a2-b53de34c745f",
    "date": "2026-08-01",
    "category": "早安",
    "title": "早安，先吃为敬",
    "content": "吐司边缘烤得刚好，煎蛋还在滋滋响。咬一口，窗外的风都是甜的。出门前记得对自己笑一个，今天也要好好过。",
    "image_url": "/images/2026-08-01-11.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:05:03.077Z"
  },
  {
    "id": "3e328c45-805c-4c8d-a054-ee6d29601b36",
    "date": "2026-08-01",
    "category": "晚安",
    "title": "夜晚的留白",
    "content": "热水冲走了疲惫，灯一关，窗外的城市还在呼吸。此刻我不需要任何答案，只安静地躺着，听自己的脉搏，跟今天轻轻道别。",
    "image_url": "/images/2026-08-01-12.jpg",
    "image_author": "",
    "created_at": "2026-08-01T16:05:06.634Z"
  },
  {
    "id": "5b7112fa-1d01-4fb3-b6a7-35e4e44e7845",
    "date": "2026-08-01",
    "category": "晚安",
    "title": "今天散场了",
